@page "/create-track"
@using MudBlazor

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-6">

    <MudPaper Class="pa-6">

        <MudText Typo="Typo.h5" Class="mb-4">
            Opret Track 🎵
        </MudText>

        <MudTextField @bind-Value="title"
                      Label="Titel"
                      Variant="Variant.Outlined"
                      Class="mb-3" />

        <MudTextField @bind-Value="version"
                      Label="Version"
                      Variant="Variant.Outlined"
                      Class="mb-3" />

        <MudTextField @bind-Value="isrc"
                      Label="ISRC"
                      Variant="Variant.Outlined"
                      Class="mb-3" />

        <MudSelect T="string"
                   @bind-value="genre"
                   Label="Genre"
                   Variant="Variant.Outlined"
                   Class="mb-4">

            @foreach (var g in Genres)
            {
                <MudSelectItem Value="@g">@g</MudSelectItem>
            }

        </MudSelect>

        <MudText Class="mt-4">
            Valgt genre: @genre
        </MudText>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="Submit">
            Gem
        </MudButton>

    </MudPaper>

</MudContainer>

@code {
    private string title = "";
    private string version = "";
    private string isrc = "";

    private string genre = "";

    private List<string> Genres = new()
    {
        "Pop",
        "Rock",
        "Hip Hop",
        "EDM",
        "Classical",
        "Jazz"
    };

    private void Submit()
    {
        Console.WriteLine($"{title} - {genre}");
    }
}
