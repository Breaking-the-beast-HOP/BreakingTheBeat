<MudStack Row="true"
          Spacing="2"
          AlignItems="AlignItems.Center"
          Class="py-1">

    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="detail-label">
        @Label:
    </MudText>

    <MudText Typo="Typo.body1" Class="detail-value">
        @Value
    </MudText>

</MudStack>
<style>
    .detail-label {
        min-width: 130px;
        font-weight: 600;
    }

    .detail-value {
        font-weight: 500;
    }
</style>


@code {
    [Parameter]
    public string Label { get; set; } = "";

    [Parameter]
    public string? Value { get; set; }
}