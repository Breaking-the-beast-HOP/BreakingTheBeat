<MudStack Row="true"
          Justify="Justify.SpaceBetween"
          AlignItems="AlignItems.Center"
          Class="py-1">

    <MudText Typo="Typo.body2" Color="Color.Secondary">
        @Label
    </MudText>

    <MudText Typo="Typo.body1">
        @Value
    </MudText>

</MudStack>

@code {
    [Parameter]
    public string Label { get; set; } = "";

    [Parameter]
    public string? Value { get; set; }
}