@page "/create-track"
@rendermode InteractiveServer
@using FrontendThrowAway.Components.Component
@using MudBlazor
@inject HttpClient Http

<PageTitle>Create Track</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-6">

    <MudStack Spacing="4">

        <!-- Header -->
        <MudPaper Class="pa-4">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h4">Create Track</MudText>

                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Text"
                               Color="Color.Default"
                               Href="/tracks">
                        Cancel
                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Warning"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="SaveTrack"
                               Disabled="_isSaving || _isLoadingLookups">
                        @(_isSaving ? "Saving..." : "Save")
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudAlert Severity="Severity.Error">
                @_errorMessage
            </MudAlert>
        }

        @if (!string.IsNullOrWhiteSpace(_successMessage))
        {
            <MudAlert Severity="Severity.Success">
                @_successMessage
            </MudAlert>
        }

        <!-- Main layout -->
        <MudGrid Spacing="3">

            <!-- LEFT COLUMN -->
            <MudItem xs="12" md="7">
                <MudStack Spacing="3">

                    <!-- Track info -->
                    <MudPaper Class="pa-4" Elevation="5">
                        <MudText Typo="Typo.h6" Class="mb-3">Track Info</MudText>

                        <MudGrid Spacing="2">

                            <MudItem xs="12">
                                <MudTextField Label="Title"
                                              @bind-Value="_model.Title"
                                              Variant="Variant.Outlined"
                                              Required="true"
                                              FullWidth="true" />
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudTextField Label="Version"
                                              @bind-Value="_model.Version"
                                              Variant="Variant.Outlined"
                                              FullWidth="true" />
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudTextField Label="ISRC"
                                              @bind-Value="_model.ISRC"
                                              Variant="Variant.Outlined"
                                              FullWidth="true" />
                            </MudItem>

                            <MudItem xs="12">
                                <MudAutocomplete T="GenreDto"
                                                 Label="Genre"
                                                 Variant="Variant.Outlined"
                                                 Value="_selectedGenre"
                                                 ValueChanged="OnGenreChanged"
                                                 SearchFunc="SearchGenres"
                                                 ToStringFunc="@(g => g?.Name ?? string.Empty)"
                                                 Clearable="true"
                                                 ResetValueOnEmptyText="true"
                                                 CoerceText="false"
                                                 Dense="true"
                                                 FullWidth="true"
                                                 MaxItems="8"
                                                 Disabled="_isLoadingLookups" />
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudAutocomplete T="LanguageDto"
                                                 Label="Metadata language"
                                                 Variant="Variant.Outlined"
                                                 Value="_selectedMetadataLanguage"
                                                 ValueChanged="OnMetadataLanguageChanged"
                                                 SearchFunc="SearchLanguages"
                                                 ToStringFunc="@(l => l?.Name ?? string.Empty)"
                                                 Clearable="true"
                                                 ResetValueOnEmptyText="true"
                                                 CoerceText="false"
                                                 Dense="true"
                                                 FullWidth="true"
                                                 MaxItems="8"
                                                 Disabled="_isLoadingLookups" />
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudAutocomplete T="LanguageDto"
                                                 Label="Audio language"
                                                 Variant="Variant.Outlined"
                                                 Value="_selectedAudioLanguage"
                                                 ValueChanged="OnAudioLanguageChanged"
                                                 SearchFunc="SearchLanguages"
                                                 ToStringFunc="@(l => l?.Name ?? string.Empty)"
                                                 Clearable="true"
                                                 ResetValueOnEmptyText="true"
                                                 CoerceText="false"
                                                 Dense="true"
                                                 FullWidth="true"
                                                 MaxItems="8"
                                                 Disabled="_isLoadingLookups" />
                            </MudItem>

                        </MudGrid>
                    </MudPaper>

                    <!-- Contributors -->
                    <ContributionEditor Title="Contributors"
                                        Description="Add track-level contributors and their roles."
                                        Rows="_contributions"
                                        Contributors="_availableContributors"
                                        AvailableRoles="_contributionRoles" />

                </MudStack>
            </MudItem>

            <!-- RIGHT COLUMN -->
            <MudItem xs="12" md="5">
                <MudStack Spacing="3">

                    <!-- Audio -->
                    <MudPaper Class="pa-4" Elevation="5">
                        <MudText Typo="Typo.h6" Class="mb-3">Audio</MudText>

                        <MudStack Spacing="3">

                            <MudPaper Class="dropzone pa-6" Outlined="true">
                                <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="2">
                                    <MudIcon Icon="@Icons.Material.Filled.AudioFile"
                                             Size="Size.Large"
                                             Color="Color.Warning" />
                                    <MudText Typo="Typo.subtitle1">Drop zone</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        Audio upload will be added later
                                    </MudText>
                                </MudStack>
                            </MudPaper>

                            <MudAlert Severity="Severity.Info" Dense="true">
                                Audio details are filled automatically after upload and transcoding.
                            </MudAlert>

                            <MudDivider />

                            <MudText Typo="Typo.subtitle2">Audio Details</MudText>

                            <MudStack Spacing="1">
                                <div class="audio-detail-row">
                                    <MudText Typo="Typo.body2" Class="audio-detail-label">Codec</MudText>
                                    <MudText Typo="Typo.body1" Class="audio-detail-value">Pending upload</MudText>
                                </div>

                                <div class="audio-detail-row">
                                    <MudText Typo="Typo.body2" Class="audio-detail-label">Bit depth</MudText>
                                    <MudText Typo="Typo.body1" Class="audio-detail-value">Pending upload</MudText>
                                </div>

                                <div class="audio-detail-row">
                                    <MudText Typo="Typo.body2" Class="audio-detail-label">Channels</MudText>
                                    <MudText Typo="Typo.body1" Class="audio-detail-value">Pending upload</MudText>
                                </div>

                                <div class="audio-detail-row">
                                    <MudText Typo="Typo.body2" Class="audio-detail-label">Sample rate</MudText>
                                    <MudText Typo="Typo.body1" Class="audio-detail-value">Pending upload</MudText>
                                </div>

                                <div class="audio-detail-row">
                                    <MudText Typo="Typo.body2" Class="audio-detail-label">Duration</MudText>
                                    <MudText Typo="Typo.body1" Class="audio-detail-value">Pending upload</MudText>
                                </div>
                            </MudStack>

                        </MudStack>
                    </MudPaper>

                </MudStack>
            </MudItem>

        </MudGrid>
    </MudStack>
</MudContainer>

@code {
    @code {
        private TrackModel _model = new();

        private List<LanguageDto> _languages = new();
        private List<GenreDto> _genres = new();

        private GenreDto? _selectedGenre;
        private LanguageDto? _selectedMetadataLanguage;
        private LanguageDto? _selectedAudioLanguage;

        private List<ContributionEditor.ContributionRow> _contributions = new();

        private List<ContributionEditor.ContributorOption> _availableContributors = new()
    {
        new() { Id = Guid.NewGuid(), DisplayName = "Gulddreng" },
        new() { Id = Guid.NewGuid(), DisplayName = "Agnello De Lutio" },
        new() { Id = Guid.NewGuid(), DisplayName = "Malte Ebert" }
    };

        private readonly List<string> _contributionRoles = new()
    {
        "Performing Artist",
        "Composer",
        "Lyricist",
        "Producer",
        "Mixer",
        "Mastering Engineer"
    };

        private bool _isLoadingLookups = true;
        private bool _isSaving = false;
        private string? _errorMessage;
        private string? _successMessage;

        protected override async Task OnInitializedAsync()
        {
            try
            {
                _languages = await Http.GetFromJsonAsync<List<LanguageDto>>("api/Language") ?? new();
                _genres = await Http.GetFromJsonAsync<List<GenreDto>>("api/Genre") ?? new();

                // Senere: hent contributors fra API
                // _availableContributors = await Http.GetFromJsonAsync<List<ContributionEditor.ContributorOption>>("api/contributor") ?? new();
            }
            catch (Exception ex)
            {
                _errorMessage = $"Could not load lookup data: {ex.Message}";
            }
            finally
            {
                _isLoadingLookups = false;
            }
        }

        private Task<IEnumerable<GenreDto>> SearchGenres(string value, CancellationToken token)
        {
            var result = string.IsNullOrWhiteSpace(value)
                ? _genres
                : _genres.Where(g => g.Name.Contains(value, StringComparison.OrdinalIgnoreCase));

            return Task.FromResult(result.AsEnumerable());
        }

        private Task<IEnumerable<LanguageDto>> SearchLanguages(string value, CancellationToken token)
        {
            var result = string.IsNullOrWhiteSpace(value)
                ? _languages
                : _languages.Where(l =>
                    l.Name.Contains(value, StringComparison.OrdinalIgnoreCase) ||
                    l.ISO.Contains(value, StringComparison.OrdinalIgnoreCase));

            return Task.FromResult(result.AsEnumerable());
        }

        private Task OnGenreChanged(GenreDto? genre)
        {
            _selectedGenre = genre;
            _model.GenreId = genre?.Id;
            return Task.CompletedTask;
        }

        private Task OnMetadataLanguageChanged(LanguageDto? language)
        {
            _selectedMetadataLanguage = language;
            _model.MetadataLanguageId = language?.Id;
            return Task.CompletedTask;
        }

        private Task OnAudioLanguageChanged(LanguageDto? language)
        {
            _selectedAudioLanguage = language;
            _model.AudioLanguageId = language?.Id;
            return Task.CompletedTask;
        }

        private async Task SaveTrack()
        {
            _errorMessage = null;
            _successMessage = null;

            if (string.IsNullOrWhiteSpace(_model.Title))
            {
                _errorMessage = "Title is required.";
                return;
            }

            if (_model.GenreId is null || _model.GenreId == Guid.Empty)
            {
                _errorMessage = "Genre is required.";
                return;
            }

            if (_model.MetadataLanguageId is null || _model.MetadataLanguageId == Guid.Empty)
            {
                _errorMessage = "Metadata language is required.";
                return;
            }

            if (_model.AudioLanguageId is null || _model.AudioLanguageId == Guid.Empty)
            {
                _errorMessage = "Audio language is required.";
                return;
            }

            try
            {
                _isSaving = true;

                var response = await Http.PostAsJsonAsync("api/Track", _model);

                if (response.IsSuccessStatusCode)
                {
                    _successMessage = "Track created successfully.";

                    _model = new TrackModel();
                    _contributions.Clear();

                    _selectedGenre = null;
                    _selectedMetadataLanguage = null;
                    _selectedAudioLanguage = null;
                }
                else
                {
                    var error = await response.Content.ReadAsStringAsync();
                    _errorMessage = string.IsNullOrWhiteSpace(error)
                        ? "Failed to save track."
                        : error;
                }
            }
            catch (Exception ex)
            {
                _errorMessage = $"An error occurred while saving: {ex.Message}";
            }
            finally
            {
                _isSaving = false;
            }
        }

        public class TrackModel
        {
            public string? Title { get; set; }
            public string? Version { get; set; }
            public string? ISRC { get; set; }
            public Guid? GenreId { get; set; }
            public Guid? MetadataLanguageId { get; set; }
            public Guid? AudioLanguageId { get; set; }
        }

        public class LanguageDto
        {
            public Guid Id { get; set; }
            public string Name { get; set; } = "";
            public string ISO { get; set; } = "";
        }

        public class GenreDto
        {
            public Guid Id { get; set; }
            public string Name { get; set; } = "";
        }
    }
}