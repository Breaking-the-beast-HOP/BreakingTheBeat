@page "/tracks/edit/{Id:guid}"
@rendermode InteractiveServer
@using MudBlazor
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Edit Track</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-6">

    <MudStack Spacing="4">

        <MudPaper Class="pa-4">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h4">Edit Track</MudText>

                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Text"
                               Color="Color.Default"
                               Href="/tracks">
                        Cancel
                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Warning"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="UpdateTrack"
                               Disabled="_isSaving || _isLoading">
                        @(_isSaving ? "Saving..." : "Save changes")
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudAlert Severity="Severity.Error">
                @_errorMessage
            </MudAlert>
        }

        @if (!string.IsNullOrWhiteSpace(_successMessage))
        {
            <MudAlert Severity="Severity.Success">
                @_successMessage
            </MudAlert>
        }

        @if (_isLoading)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else
        {
            <MudGrid Spacing="3">

                <MudItem xs="12" md="7">
                    <MudStack Spacing="3">

                        <MudPaper Class="pa-4" Elevation="5">
                            <MudText Typo="Typo.h6" Class="mb-3">Track Info</MudText>

                            <MudGrid Spacing="2">

                                <MudItem xs="12">
                                    <MudTextField Label="Title"
                                                  @bind-Value="_model.Title"
                                                  Variant="Variant.Outlined"
                                                  Required="true"
                                                  FullWidth="true" />
                                </MudItem>

                                <MudItem xs="12" sm="6">
                                    <MudTextField Label="Version"
                                                  @bind-Value="_model.Version"
                                                  Variant="Variant.Outlined"
                                                  FullWidth="true" />
                                </MudItem>

                                <MudItem xs="12" sm="6">
                                    <MudTextField Label="ISRC"
                                                  @bind-Value="_model.ISRC"
                                                  Variant="Variant.Outlined"
                                                  FullWidth="true" />
                                </MudItem>

                                <MudItem xs="12">
                                    <MudAutocomplete T="GenreDto"
                                                     Label="Genre"
                                                     Variant="Variant.Outlined"
                                                     Value="_selectedGenre"
                                                     ValueChanged="OnGenreChanged"
                                                     SearchFunc="SearchGenres"
                                                     ToStringFunc="@(g => g?.Name ?? string.Empty)"
                                                     Clearable="true"
                                                     ResetValueOnEmptyText="true"
                                                     CoerceText="false"
                                                     Dense="true"
                                                     FullWidth="true"
                                                     MaxItems="8"
                                                     Disabled="_isLoading" />
                                </MudItem>

                                <MudItem xs="12" sm="6">
                                    <MudAutocomplete T="LanguageDto"
                                                     Label="Metadata language"
                                                     Variant="Variant.Outlined"
                                                     Value="_selectedMetadataLanguage"
                                                     ValueChanged="OnMetadataLanguageChanged"
                                                     SearchFunc="SearchLanguages"
                                                     ToStringFunc="@(l => l?.Name ?? string.Empty)"
                                                     Clearable="true"
                                                     ResetValueOnEmptyText="true"
                                                     CoerceText="false"
                                                     Dense="true"
                                                     FullWidth="true"
                                                     MaxItems="8"
                                                     Disabled="_isLoading" />
                                </MudItem>

                                <MudItem xs="12" sm="6">
                                    <MudAutocomplete T="LanguageDto"
                                                     Label="Audio language"
                                                     Variant="Variant.Outlined"
                                                     Value="_selectedAudioLanguage"
                                                     ValueChanged="OnAudioLanguageChanged"
                                                     SearchFunc="SearchLanguages"
                                                     ToStringFunc="@(l => l?.Name ?? string.Empty)"
                                                     Clearable="true"
                                                     ResetValueOnEmptyText="true"
                                                     CoerceText="false"
                                                     Dense="true"
                                                     FullWidth="true"
                                                     MaxItems="8"
                                                     Disabled="_isLoading" />
                                </MudItem>

                            </MudGrid>
                        </MudPaper>

                        <MudPaper Class="pa-4" Elevation="5">
                            <MudText Typo="Typo.h6" Class="mb-3">Contributors</MudText>
                            <MudAlert Severity="Severity.Info" Dense="true">
                                Editing contributors can be added later.
                            </MudAlert>
                        </MudPaper>

                    </MudStack>
                </MudItem>

                <MudItem xs="12" md="5">
                    <MudStack Spacing="3">

                        <MudPaper Class="pa-4" Elevation="5">
                            <MudText Typo="Typo.h6" Class="mb-3">Audio</MudText>

                            <MudStack Spacing="3">

                                <MudPaper Class="dropzone pa-6" Outlined="true">
                                    <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="2">
                                        <MudIcon Icon="@Icons.Material.Filled.AudioFile"
                                                 Size="Size.Large"
                                                 Color="Color.Warning" />
                                        <MudText Typo="Typo.subtitle1">Audio asset</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                                            Audio editing will be added later
                                        </MudText>
                                    </MudStack>
                                </MudPaper>

                                <MudAlert Severity="Severity.Info" Dense="true">
                                    Audio details are read-only for now.
                                </MudAlert>

                            </MudStack>
                        </MudPaper>

                    </MudStack>
                </MudItem>

            </MudGrid>
        }
    </MudStack>
</MudContainer>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private TrackModel _model = new();

    private List<LanguageDto> _languages = new();
    private List<GenreDto> _genres = new();

    private GenreDto? _selectedGenre;
    private LanguageDto? _selectedMetadataLanguage;
    private LanguageDto? _selectedAudioLanguage;

    private bool _isLoading = true;
    private bool _isSaving = false;
    private string? _errorMessage;
    private string? _successMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _languages = await Http.GetFromJsonAsync<List<LanguageDto>>("api/Language") ?? new();
            _genres = await Http.GetFromJsonAsync<List<GenreDto>>("api/Genre") ?? new();

            var track = await Http.GetFromJsonAsync<TrackEditDto>($"api/track/{Id}");

            if (track is null)
            {
                _errorMessage = "Track not found.";
                return;
            }

            _model = new TrackModel
                {
                    Title = track.Title,
                    Version = track.Version,
                    ISRC = track.ISRC,
                    GenreId = track.GenreId,
                    MetadataLanguageId = track.MetadataLanguageId,
                    AudioLanguageId = track.AudioLanguageId
                };

            _selectedGenre = _genres.FirstOrDefault(g => g.Id == track.GenreId);
            _selectedMetadataLanguage = _languages.FirstOrDefault(l => l.Id == track.MetadataLanguageId);
            _selectedAudioLanguage = _languages.FirstOrDefault(l => l.Id == track.AudioLanguageId);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Could not load track: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private Task<IEnumerable<GenreDto>> SearchGenres(string value, CancellationToken token)
    {
        IEnumerable<GenreDto> result;

        if (string.IsNullOrWhiteSpace(value))
            result = _genres;
        else
            result = _genres.Where(g => g.Name.Contains(value, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(result);
    }

    private Task<IEnumerable<LanguageDto>> SearchLanguages(string value, CancellationToken token)
    {
        IEnumerable<LanguageDto> result;

        if (string.IsNullOrWhiteSpace(value))
            result = _languages;
        else
            result = _languages.Where(l =>
                l.Name.Contains(value, StringComparison.OrdinalIgnoreCase) ||
                l.ISO.Contains(value, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(result);
    }

    private Task OnGenreChanged(GenreDto? genre)
    {
        _selectedGenre = genre;
        _model.GenreId = genre?.Id;
        return Task.CompletedTask;
    }

    private Task OnMetadataLanguageChanged(LanguageDto? language)
    {
        _selectedMetadataLanguage = language;
        _model.MetadataLanguageId = language?.Id;
        return Task.CompletedTask;
    }

    private Task OnAudioLanguageChanged(LanguageDto? language)
    {
        _selectedAudioLanguage = language;
        _model.AudioLanguageId = language?.Id;
        return Task.CompletedTask;
    }

    private async Task UpdateTrack()
    {
        _errorMessage = null;
        _successMessage = null;

        if (string.IsNullOrWhiteSpace(_model.Title))
        {
            _errorMessage = "Title is required.";
            return;
        }

        if (_model.GenreId is null || _model.GenreId == Guid.Empty)
        {
            _errorMessage = "Genre is required.";
            return;
        }

        if (_model.MetadataLanguageId is null || _model.MetadataLanguageId == Guid.Empty)
        {
            _errorMessage = "Metadata language is required.";
            return;
        }

        if (_model.AudioLanguageId is null || _model.AudioLanguageId == Guid.Empty)
        {
            _errorMessage = "Audio language is required.";
            return;
        }

        try
        {
            _isSaving = true;

            var response = await Http.PutAsJsonAsync($"api/track/{Id}", _model);

            if (response.IsSuccessStatusCode)
            {
                _successMessage = "Track updated successfully.";
                Navigation.NavigateTo($"/tracks/{Id}");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                _errorMessage = string.IsNullOrWhiteSpace(error)
                    ? "Failed to update track."
                    : error;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"An error occurred while saving: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    public class TrackModel
    {
        public string? Title { get; set; }
        public string? Version { get; set; }
        public string? ISRC { get; set; }
        public Guid? GenreId { get; set; }
        public Guid? MetadataLanguageId { get; set; }
        public Guid? AudioLanguageId { get; set; }
    }

    public class TrackEditDto
    {
        public Guid Id { get; set; }
        public string? Title { get; set; }
        public string? Version { get; set; }
        public string? ISRC { get; set; }
        public Guid? GenreId { get; set; }
        public Guid? MetadataLanguageId { get; set; }
        public Guid? AudioLanguageId { get; set; }
    }

    public class LanguageDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
        public string ISO { get; set; } = "";
    }

    public class GenreDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
    }
}
