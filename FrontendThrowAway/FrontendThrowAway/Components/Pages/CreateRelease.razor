@page "/create-release"
@rendermode InteractiveServer
@using FrontendThrowAway.Components.Component
@using FrontendThrowAway.Components.Layout
@using MudBlazor
@inject HttpClient Http

<MudContainer MaxWidth="MaxWidth.False" Class="pa-6">

    <MudStack Spacing="4">

        <!-- Header -->
        <MudPaper Class="pa-4" Elevation="5">
            <MudStack Row="@true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h4">Create Release</MudText>

                <MudStack Row="@true" Spacing="2">
                    <MudButton Variant="Variant.Text"
                               Color="Color.Default"
                               Href="/releases">
                        Cancel
                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Warning"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="SaveRelease"
                               Disabled="@(_isSaving || _isLoadingLookups)">
                        @(_isSaving ? "Saving..." : "Save")
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
        }

        @if (!string.IsNullOrWhiteSpace(_successMessage))
        {
            <MudAlert Severity="Severity.Success">@_successMessage</MudAlert>
        }

        <!-- TOP GRID: RELEASE METADATA + COVER/BOOKLET -->
        <MudGrid Spacing="3">

            <!-- LEFT TOP -->
            <MudItem xs="12" md="7">
                <MudStack Spacing="3">

                    <!-- Release Info -->
                    <MudPaper Class="pa-4" Elevation="5">
                        <MudText Typo="Typo.h6" Class="mb-3">Release Info</MudText>

                        <MudGrid Spacing="2">
                            <MudItem xs="12">
                                <MudTextField Label="Title"
                                              @bind-Value="_model.Title"
                                              Variant="Variant.Outlined"
                                              Required="@true"
                                              FullWidth="@true" />
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudTextField Label="Version"
                                              @bind-Value="_model.Version"
                                              Variant="Variant.Outlined"
                                              FullWidth="@true" />
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudTextField Label="EAN"
                                              @bind-Value="_model.EAN"
                                              Variant="Variant.Outlined"
                                              FullWidth="@true" />
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudDatePicker Label="Release date"
                                               @bind-Date="_model.ReleaseDate"
                                               Variant="Variant.Outlined" />
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudAutocomplete T="GenreDto"
                                                 Label="Genre"
                                                 Variant="Variant.Outlined"
                                                 Value="_selectedGenre"
                                                 ValueChanged="OnGenreChanged"
                                                 SearchFunc="SearchGenres"
                                                 ToStringFunc="@(g => g?.Name ?? string.Empty)"
                                                 Clearable="@true"
                                                 ResetValueOnEmptyText="@true"
                                                 CoerceText="@false"
                                                 Dense="@true"
                                                 FullWidth="@true"
                                                 MaxItems="8"
                                                 Disabled="@_isLoadingLookups" />
                            </MudItem>

                            <MudItem xs="12">
                                <MudAutocomplete T="LanguageDto"
                                                 Label="Metadata language"
                                                 Variant="Variant.Outlined"
                                                 Value="_selectedLanguage"
                                                 ValueChanged="OnLanguageChanged"
                                                 SearchFunc="SearchLanguages"
                                                 ToStringFunc="@(l => l?.Name ?? string.Empty)"
                                                 Clearable="@true"
                                                 ResetValueOnEmptyText="@true"
                                                 CoerceText="@false"
                                                 Dense="@true"
                                                 FullWidth="@true"
                                                 MaxItems="8"
                                                 Disabled="@_isLoadingLookups" />
                            </MudItem>
                        </MudGrid>
                    </MudPaper>

                    <!-- Contributors -->
                    <ContributionEditor Title="Release contributors"
                                        Description="Add release-level contributors and their roles."
                                        Rows="_contributions"
                                        Contributors="_availableContributors"
                                        AvailableRoles="_contributionRoles" />

                </MudStack>
            </MudItem>

            <!-- RIGHT TOP -->
            <MudItem xs="12" md="5">
                <MudStack Spacing="3">

                    <!-- Cover -->
                    <MudPaper Class="pa-4" Elevation="5">
                        <MudText Typo="Typo.h6" Class="mb-3">Cover</MudText>

                        <MudPaper Class="dropzone pa-6" Outlined="@true">
                            <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.Image"
                                         Size="Size.Large"
                                         Color="Color.Warning" />

                                <MudText Typo="Typo.subtitle1">Drop zone</MudText>

                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    Cover upload will be added later
                                </MudText>
                            </MudStack>
                        </MudPaper>
                    </MudPaper>

                    <!-- Booklet -->
                    <MudPaper Class="pa-4" Elevation="5">
                        <MudText Typo="Typo.h6" Class="mb-3">Booklet</MudText>

                        <MudPaper Class="dropzone pa-6" Outlined="@true">
                            <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf"
                                         Size="Size.Large"
                                         Color="Color.Warning" />

                                <MudText Typo="Typo.subtitle1">Drop zone</MudText>

                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    Booklet upload will be added later
                                </MudText>
                            </MudStack>
                        </MudPaper>
                    </MudPaper>

                </MudStack>
            </MudItem>

        </MudGrid>

        <!-- BOTTOM GRID: VOLUMES + SELECTED TRACK -->
        <MudGrid Spacing="3">

            <!-- LEFT BOTTOM -->
            <MudItem xs="12" md="7">

                <!-- Volumes -->
                <MudPaper Class="pa-4" Elevation="5">
                    <MudText Typo="Typo.h6" Class="mb-3">Volumes</MudText>

                    @foreach (var volume in _model.Volumes)
                    {
                        <MudPaper Class="mb-4" Outlined="@true">

                            <!-- Volume header -->
                            <MudStack Row="@true"
                                      Justify="Justify.SpaceBetween"
                                      AlignItems="AlignItems.Center"
                                      Class="pa-3">

                                <MudText Typo="Typo.h6">
                                    Volume @volume.VolumeNumber
                                </MudText>

                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Default"
                                               Disabled="@(_model.Volumes.Count == 1)"
                                               OnClick="@(() => RemoveVolume(volume))" />
                            </MudStack>

                            <MudDivider />

                            <!-- Tracks -->
                            @foreach (var track in volume.Tracks)
                            {
                                <MudStack Row="@true"
                                          AlignItems="AlignItems.Center"
                                          Spacing="2"
                                          Class="pa-3 volume-track-row">

                                    <MudText Typo="Typo.body2" Class="track-number">
                                        @track.TrackNumber
                                    </MudText>

                                    <MudStack Spacing="0" Class="flex-grow-1">
                                        <MudAutocomplete T="TrackDto"
                                                         Label="Track"
                                                         Variant="Variant.Text"
                                                         Value="track.SelectedTrack"
                                                         ValueChanged="@(selected => OnTrackChanged(track, selected))"
                                                         SearchFunc="SearchTracks"
                                                         ToStringFunc="@(t => t?.Title ?? string.Empty)"
                                                         Clearable="@true"
                                                         ResetValueOnEmptyText="@true"
                                                         CoerceText="@false"
                                                         Dense="@true"
                                                         MaxItems="8"
                                                         Disabled="@_isLoadingLookups" />

                                        @if (track.SelectedTrack is not null)
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                @DisplayTrackSubtitle(track.SelectedTrack)
                                            </MudText>
                                        }
                                    </MudStack>

                                    <MudText Typo="Typo.body2" Class="duration-text">
                                        @FormatDuration(track.SelectedTrack?.DurationSeconds)
                                    </MudText>

                                    <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                                   Color="Color.Warning"
                                                   Size="Size.Small"
                                                   Disabled="@(track.TrackId is null)"
                                                   OnClick="@(() => PreviewTrack(track.TrackId))" />

                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   Disabled="@(volume.Tracks.Count == 1)"
                                                   OnClick="@(() => RemoveTrack(volume, track))" />

                                </MudStack>

                                <MudDivider />
                            }

                            <MudStack Row="@true"
                                      Justify="Justify.FlexEnd"
                                      Class="pa-3">
                                <MudButton Variant="Variant.Text"
                                           Color="Color.Warning"
                                           StartIcon="@Icons.Material.Filled.Add"
                                           OnClick="@(() => AddTrack(volume))">
                                    Add track
                                </MudButton>
                            </MudStack>

                        </MudPaper>
                    }

                    <MudStack Row="@true" Justify="Justify.FlexEnd">
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Warning"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="AddVolume">
                            Add volume
                        </MudButton>
                    </MudStack>
                </MudPaper>

            </MudItem>

            <!-- RIGHT BOTTOM -->
            <MudItem xs="12" md="5">

                <!-- Selected Track -->
                <MudPaper Class="pa-4" Elevation="5">
                    <MudText Typo="Typo.h6" Class="mb-3">Selected Track</MudText>

                    @if (_isLoadingTrackPreview)
                    {
                        <MudProgressCircular Indeterminate="@true" />
                    }
                    else if (!string.IsNullOrWhiteSpace(_trackPreviewError))
                    {
                        <MudAlert Severity="Severity.Error" Dense="@true">
                            @_trackPreviewError
                        </MudAlert>
                    }
                    else if (_selectedTrackPreview is null)
                    {
                        <MudAlert Severity="Severity.Info" Dense="@true">
                            Click the eye icon on a track to preview details here.
                        </MudAlert>
                    }
                    else
                    {
                        <MudStack Spacing="3">

                            <MudGrid Spacing="2">
                                <MudItem xs="12">
                                    <DetailRow Label="Title" Value="@(_selectedTrackPreview.Title ?? "-")" />
                                </MudItem>

                                <MudItem xs="12" sm="6">
                                    <DetailRow Label="Version" Value="@(string.IsNullOrWhiteSpace(_selectedTrackPreview.Version) ? "-" : _selectedTrackPreview.Version)" />
                                </MudItem>

                                <MudItem xs="12" sm="6">
                                    <DetailRow Label="ISRC" Value="@(_selectedTrackPreview.ISRC ?? "-")" />
                                </MudItem>

                                <MudItem xs="12" sm="6">
                                    <DetailRow Label="Genre" Value="@(_selectedTrackPreview.GenreName ?? "-")" />
                                </MudItem>

                                <MudItem xs="12" sm="6">
                                    <DetailRow Label="Duration" Value="@FormatDuration(_selectedTrackPreview.DurationSeconds)" />
                                </MudItem>

                                <MudItem xs="12" sm="6">
                                    <DetailRow Label="Metadata language" Value="@(_selectedTrackPreview.MetadataLanguageName ?? "-")" />
                                </MudItem>

                                <MudItem xs="12" sm="6">
                                    <DetailRow Label="Audio language" Value="@(_selectedTrackPreview.AudioLanguageName ?? "-")" />
                                </MudItem>
                            </MudGrid>

                            <MudDivider />

                            <MudText Typo="Typo.subtitle2">Audio Details</MudText>

                            <MudPaper Class="dropzone pa-6" Outlined="@true">
                                <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="2">
                                    <MudIcon Icon="@Icons.Material.Filled.AudioFile"
                                             Size="Size.Large"
                                             Color="Color.Warning" />

                                    <MudText Typo="Typo.subtitle1">Audio asset</MudText>

                                    <MudChip T="string"
                                             Color="@(_selectedTrackPreview.HasAudio ? Color.Success : Color.Default)"
                                             Variant="Variant.Outlined">
                                        @(_selectedTrackPreview.HasAudio ? "Uploaded" : "Not uploaded")
                                    </MudChip>
                                </MudStack>
                            </MudPaper>

                            <MudStack Spacing="1">
                                <div class="audio-detail-row">
                                    <MudText Typo="Typo.body2" Class="audio-detail-label">Codec</MudText>
                                    <MudText Typo="Typo.body1" Class="audio-detail-value">@(_selectedTrackPreview.Codec ?? "Pending upload")</MudText>
                                </div>

                                <div class="audio-detail-row">
                                    <MudText Typo="Typo.body2" Class="audio-detail-label">Bit depth</MudText>
                                    <MudText Typo="Typo.body1" Class="audio-detail-value">@(_selectedTrackPreview.BitDepth ?? "Pending upload")</MudText>
                                </div>

                                <div class="audio-detail-row">
                                    <MudText Typo="Typo.body2" Class="audio-detail-label">Channels</MudText>
                                    <MudText Typo="Typo.body1" Class="audio-detail-value">@(_selectedTrackPreview.Channels ?? "Pending upload")</MudText>
                                </div>

                                <div class="audio-detail-row">
                                    <MudText Typo="Typo.body2" Class="audio-detail-label">Sample rate</MudText>
                                    <MudText Typo="Typo.body1" Class="audio-detail-value">@(_selectedTrackPreview.SampleRate ?? "Pending upload")</MudText>
                                </div>
                            </MudStack>

                        </MudStack>
                    }
                </MudPaper>

            </MudItem>

        </MudGrid>

    </MudStack>
</MudContainer>


@code {
    private ReleaseModel _model = new();

    private List<LanguageDto> _languages = new();
    private List<GenreDto> _genres = new();
    private List<TrackDto> _tracks = new();

    private GenreDto? _selectedGenre;
    private LanguageDto? _selectedLanguage;

    private List<ContributionEditor.ContributionRow> _contributions = new();

    private List<ContributionEditor.ContributorOption> _availableContributors = new();
    private List<ContributionEditor.ContributorRoleDto> _contributionRoles = new();

    private TrackDetailsDto? _selectedTrackPreview;
    private bool _isLoadingTrackPreview = false;
    private string? _trackPreviewError;

    private bool _isLoadingLookups = true;
    private bool _isSaving = false;
    private string? _errorMessage;
    private string? _successMessage;

    protected override async Task OnInitializedAsync()
    {
        _model.Volumes.Add(new ReleaseVolumeModel
            {
                VolumeNumber = 1,
                Tracks = new()
            {
                new ReleaseTrackModel { TrackNumber = 1 }
            }
            });

        try
        {
            _languages = await Http.GetFromJsonAsync<List<LanguageDto>>("api/Language") ?? new();
            _genres = await Http.GetFromJsonAsync<List<GenreDto>>("api/Genre") ?? new();
            _tracks = await Http.GetFromJsonAsync<List<TrackDto>>("api/Track") ?? new();

            try
            {
                _contributionRoles =
                    await Http.GetFromJsonAsync<List<ContributionEditor.ContributorRoleDto>>("api/ContributorRole") ?? new();
            }
            catch (Exception ex)
            {
                _errorMessage = $"Could not load contributor roles: {ex.Message}";
            }

            try
            {
                _availableContributors =
                    await Http.GetFromJsonAsync<List<ContributionEditor.ContributorOption>>("api/Contributor") ?? new();
            }
            catch (Exception ex)
            {
                _errorMessage = $"Could not load contributors: {ex.Message}";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Could not load lookup data: {ex.Message}";
        }
        finally
        {
            _isLoadingLookups = false;
        }
    }

    private Task<IEnumerable<GenreDto>> SearchGenres(string value, CancellationToken token)
    {
        var result = string.IsNullOrWhiteSpace(value)
            ? _genres
            : _genres.Where(g => g.Name.Contains(value, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(result.AsEnumerable());
    }

    private Task<IEnumerable<LanguageDto>> SearchLanguages(string value, CancellationToken token)
    {
        var result = string.IsNullOrWhiteSpace(value)
            ? _languages
            : _languages.Where(l =>
                l.Name.Contains(value, StringComparison.OrdinalIgnoreCase) ||
                l.ISO.Contains(value, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(result.AsEnumerable());
    }

    private Task<IEnumerable<TrackDto>> SearchTracks(string value, CancellationToken token)
    {
        var result = string.IsNullOrWhiteSpace(value)
            ? _tracks
            : _tracks.Where(t =>
                t.Title.Contains(value, StringComparison.OrdinalIgnoreCase) ||
                (!string.IsNullOrWhiteSpace(t.ISRC) &&
                 t.ISRC.Contains(value, StringComparison.OrdinalIgnoreCase)));

        return Task.FromResult(result.AsEnumerable());
    }

    private Task OnGenreChanged(GenreDto? genre)
    {
        _selectedGenre = genre;
        _model.GenreId = genre?.Id;
        return Task.CompletedTask;
    }

    private Task OnLanguageChanged(LanguageDto? language)
    {
        _selectedLanguage = language;
        _model.LanguageId = language?.Id;
        return Task.CompletedTask;
    }

    private Task OnTrackChanged(ReleaseTrackModel row, TrackDto? track)
    {
        row.SelectedTrack = track;
        row.TrackId = track?.Id;
        return Task.CompletedTask;
    }

    private async Task PreviewTrack(Guid? trackId)
    {
        if (trackId is null || trackId == Guid.Empty)
            return;

        _trackPreviewError = null;
        _selectedTrackPreview = null;
        _isLoadingTrackPreview = true;

        try
        {
            _selectedTrackPreview =
                await Http.GetFromJsonAsync<TrackDetailsDto>($"api/track/{trackId}");
        }
        catch (Exception ex)
        {
            _trackPreviewError = $"Could not fetch track details: {ex.Message}";
        }
        finally
        {
            _isLoadingTrackPreview = false;
        }
    }

    private void AddVolume()
    {
        _model.Volumes.Add(new ReleaseVolumeModel
            {
                VolumeNumber = _model.Volumes.Count + 1,
                Tracks = new()
            {
                new ReleaseTrackModel { TrackNumber = 1 }
            }
            });
    }

    private void RemoveVolume(ReleaseVolumeModel volume)
    {
        if (_model.Volumes.Count <= 1)
            return;

        _model.Volumes.Remove(volume);

        for (var i = 0; i < _model.Volumes.Count; i++)
            _model.Volumes[i].VolumeNumber = i + 1;
    }

    private void AddTrack(ReleaseVolumeModel volume)
    {
        volume.Tracks.Add(new ReleaseTrackModel
            {
                TrackNumber = volume.Tracks.Count + 1
            });
    }

    private void RemoveTrack(ReleaseVolumeModel volume, ReleaseTrackModel track)
    {
        if (volume.Tracks.Count <= 1)
            return;

        volume.Tracks.Remove(track);

        for (var i = 0; i < volume.Tracks.Count; i++)
            volume.Tracks[i].TrackNumber = i + 1;
    }

    private async Task SaveRelease()
    {
        _errorMessage = null;
        _successMessage = null;

        if (string.IsNullOrWhiteSpace(_model.Title))
        {
            _errorMessage = "Title is required.";
            return;
        }

        if (_model.GenreId is null || _model.GenreId == Guid.Empty)
        {
            _errorMessage = "Genre is required.";
            return;
        }

        if (_model.LanguageId is null || _model.LanguageId == Guid.Empty)
        {
            _errorMessage = "Metadata language is required.";
            return;
        }

        if (!_model.Volumes.Any())
        {
            _errorMessage = "At least one volume is required.";
            return;
        }

        if (_model.Volumes.Any(v => !v.Tracks.Any()))
        {
            _errorMessage = "Each volume must contain at least one track.";
            return;
        }

        if (_model.Volumes.SelectMany(v => v.Tracks).Any(t => t.TrackId is null || t.TrackId == Guid.Empty))
        {
            _errorMessage = "All track rows must have a selected track.";
            return;
        }

        try
        {
            _isSaving = true;

            _model.Contributions = _contributions
                .Where(c => c.ContributorId.HasValue && c.Roles.Any())
                .Select(c => new CreateContributionRequest
                    {
                        ContributorId = c.ContributorId!.Value,
                        RoleIds = c.Roles.Select(r => r.Id).ToList()
                    })
                .ToList();

            var response = await Http.PostAsJsonAsync("api/Release", _model);

            if (response.IsSuccessStatusCode)
            {
                _successMessage = "Release created successfully.";

                ResetForm();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                _errorMessage = string.IsNullOrWhiteSpace(error)
                    ? "Failed to save release."
                    : error;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"An error occurred while saving: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void ResetForm()
    {
        _model = new ReleaseModel();
        _model.Volumes.Add(new ReleaseVolumeModel
            {
                VolumeNumber = 1,
                Tracks = new()
            {
                new ReleaseTrackModel { TrackNumber = 1 }
            }
            });

        _contributions.Clear();

        _selectedGenre = null;
        _selectedLanguage = null;
        _selectedTrackPreview = null;
        _trackPreviewError = null;
    }

    private string FormatDuration(int? durationSeconds)
    {
        if (durationSeconds is null || durationSeconds <= 0)
            return "00:00";

        var ts = TimeSpan.FromSeconds(durationSeconds.Value);
        return ts.ToString(@"mm\:ss");
    }

    private string DisplayTrackSubtitle(TrackDto track)
    {
        if (!string.IsNullOrWhiteSpace(track.ISRC))
            return track.ISRC;

        if (!string.IsNullOrWhiteSpace(track.Version))
            return track.Version;

        return "No ISRC";
    }

    public class ReleaseModel
    {
        public string? Title { get; set; }
        public string? Version { get; set; }
        public string? EAN { get; set; }
        public DateTime? ReleaseDate { get; set; }

        public Guid? GenreId { get; set; }
        public Guid? LanguageId { get; set; }

        public List<ReleaseVolumeModel> Volumes { get; set; } = new();
        public List<CreateContributionRequest> Contributions { get; set; } = new();
    }

    public class ReleaseVolumeModel
    {
        public int VolumeNumber { get; set; }
        public List<ReleaseTrackModel> Tracks { get; set; } = new();
    }

    public class ReleaseTrackModel
    {
        public int TrackNumber { get; set; }
        public Guid? TrackId { get; set; }

        public TrackDto? SelectedTrack { get; set; }
    }

    public class CreateContributionRequest
    {
        public Guid ContributorId { get; set; }
        public List<Guid> RoleIds { get; set; } = new();
    }

    public class TrackDto
    {
        public Guid Id { get; set; }
        public string Title { get; set; } = "";
        public string? Version { get; set; }
        public string? ISRC { get; set; }
        public int DurationSeconds { get; set; }
    }

    public class TrackDetailsDto
    {
        public Guid Id { get; set; }
        public string? Title { get; set; }
        public string? Version { get; set; }
        public string? ISRC { get; set; }
        public int DurationSeconds { get; set; }

        public string? GenreName { get; set; }
        public string? MetadataLanguageName { get; set; }
        public string? AudioLanguageName { get; set; }

        public bool HasAudio { get; set; }
        public string? Codec { get; set; }
        public string? BitDepth { get; set; }
        public string? Channels { get; set; }
        public string? SampleRate { get; set; }

        public List<ContributionDto> Contributions { get; set; } = new();
    }

    public class ContributionDto
    {
        public Guid ContributorId { get; set; }
        public string ContributorName { get; set; } = "";
        public List<ContributionRoleDto> Roles { get; set; } = new();
    }

    public class ContributionRoleDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
    }

    public class LanguageDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
        public string ISO { get; set; } = "";
    }

    public class GenreDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
    }
}