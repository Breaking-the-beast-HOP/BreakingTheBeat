@page "/create-contributor"
@rendermode InteractiveServer
@using MudBlazor
@inject HttpClient Http

<PageTitle>Create Contributor</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="pa-6">

    <MudStack Spacing="4">

        <MudPaper Class="pa-4">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h4">Create Contributor</MudText>

                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Text"
                               Color="Color.Default"
                               Href="/contributors">
                        Cancel
                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Warning"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="SaveContributor"
                               Disabled="_isSaving">
                        @(_isSaving ? "Saving..." : "Save")
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
        }

        @if (!string.IsNullOrWhiteSpace(_successMessage))
        {
            <MudAlert Severity="Severity.Success">@_successMessage</MudAlert>
        }

        <MudPaper Class="pa-4" Elevation="5">
            <MudText Typo="Typo.h6" Class="mb-3">Contributor Info</MudText>

            <MudGrid Spacing="2">

                <MudItem xs="12">
                    <MudTextField Label="Display name / Artist name"
                                  @bind-Value="_model.DisplayName"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  FullWidth="true" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField Label="Legal name"
                                  @bind-Value="_model.LegalName"
                                  Variant="Variant.Outlined"
                                  FullWidth="true" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField Label="IPI"
                                  @bind-Value="_model.IPI"
                                  Variant="Variant.Outlined"
                                  FullWidth="true" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField Label="ISNI"
                                  @bind-Value="_model.ISNI"
                                  Variant="Variant.Outlined"
                                  FullWidth="true" />
                </MudItem>

            </MudGrid>
        </MudPaper>

    </MudStack>

</MudContainer>

@code {
    private ContributorModel _model = new();
    private bool _isSaving = false;
    private string? _errorMessage;
    private string? _successMessage;

    private async Task SaveContributor()
    {
        _errorMessage = null;
        _successMessage = null;

        if (string.IsNullOrWhiteSpace(_model.DisplayName))
        {
            _errorMessage = "Display name is required.";
            return;
        }

        try
        {
            _isSaving = true;

            var response = await Http.PostAsJsonAsync("api/contributor", _model);

            if (response.IsSuccessStatusCode)
            {
                _successMessage = "Contributor created successfully.";
                _model = new ContributorModel();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                _errorMessage = string.IsNullOrWhiteSpace(error)
                    ? "Failed to save contributor."
                    : error;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"An error occurred while saving: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    public class ContributorModel
    {
        public string? DisplayName { get; set; }
        public string? LegalName { get; set; }
        public string? IPI { get; set; }
        public string? ISNI { get; set; }
    }
}