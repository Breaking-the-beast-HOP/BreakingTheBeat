@page "/tracks/{Id:guid}"
@using FrontendThrowAway.Components.Layout
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Track</PageTitle>

<MudStack Spacing="3">

    <!-- Header -->
    <MudPaper Class="pa-4" Elevation="5">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <div>
                <MudText Typo="Typo.h4">@(_track?.Title ?? "Track")</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Track details
                </MudText>
            </div>

            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           Href="/tracks">
                    Back
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Warning"
                           StartIcon="@Icons.Material.Filled.Edit"
                           Href="@($"/tracks/edit/{Id}")" >
                    Edit
                </MudButton>

                <MudButton Variant="Variant.Text"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.Delete"
                           OnClick="@(async () => await DeleteTrack(Id))">
                    Delete
                </MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>

    @if (_isLoading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error">
            @_errorMessage
        </MudAlert>
    }
    else if (_track is null)
    {
        <MudAlert Severity="Severity.Warning">
            Track not found.
        </MudAlert>
    }
    else
    {
        <MudGrid Spacing="3">

            <!-- LEFT -->
            <MudItem xs="12" md="7">
                <MudStack Spacing="3">
                <MudPaper Class="pa-4" Elevation="5">
                    <MudText Typo="Typo.h6" Class="mb-3">Track Info</MudText>
                    <MudGrid Spacing="2">
                        <MudItem xs="12">
                            <DetailRow Label="Title" Value="@_track.Title" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <DetailRow Label="Version" Value="@(string.IsNullOrWhiteSpace(_track.Version) ? "-" : _track.Version)" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <DetailRow Label="ISRC" Value="@_track.ISRC" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <DetailRow Label="Genre" Value="@(_track.GenreName ?? "-")" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <DetailRow Label="Metadata language" Value="@(_track.MetadataLanguageName ?? "-")" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <DetailRow Label="Audio language" Value="@(_track.AudioLanguageName ?? "-")" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>


                    <MudPaper Class="pa-4" Elevation="5">
                        <MudText Typo="Typo.h6" Class="mb-3">Contributors</MudText>

                        @if (_track.Contributors is null || !_track.Contributors.Any())
                        {
                            <MudAlert Severity="Severity.Info" Dense="true">
                                No contributors registered.
                            </MudAlert>
                        }
                        else
                        {
                            <MudTable Items="_track.Contributors" Dense="true" Hover="true" Elevation="0">
                                <HeaderContent>
                                    <MudTh>Name</MudTh>
                                    <MudTh>Role</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Name">@context.Name</MudTd>
                                    <MudTd DataLabel="Role">
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">
                                            @context.Role
                                        </MudChip>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    </MudPaper>

                    <MudPaper Class="pa-4" Elevation="5">
                        <MudText Typo="Typo.h6" Class="mb-3">System Info</MudText>

                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="6">
                                <DetailRow Label="Created" Value="@FormatDate(_track.CreatedAt)" />
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <DetailRow Label="Last updated" Value="@FormatDate(_track.LastUpdatedAt)" />
                            </MudItem>
                        </MudGrid>
                    </MudPaper>

                </MudStack>
            </MudItem>

            <!-- RIGHT -->
            <MudItem xs="12" md="5">
                <MudStack Spacing="3">

                    <MudPaper Class="pa-4" Elevation="5">
                        <MudText Typo="Typo.h6" Class="mb-3">Audio</MudText>

                        <MudPaper Class="dropzone pa-6" Outlined="true">
                            <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.AudioFile"
                                         Size="Size.Large"
                                         Color="Color.Warning" />
                                <MudText Typo="Typo.subtitle1">Audio asset</MudText>
                                <MudChip T="string"
                                         Color="@(_track.HasAudio ? Color.Success : Color.Default)"
                                         Variant="Variant.Outlined">
                                    @(_track.HasAudio ? "Uploaded" : "Not uploaded")
                                </MudChip>
                            </MudStack>
                        </MudPaper>

                        <MudDivider Class="my-4" />

                        <MudText Typo="Typo.subtitle2" Class="mb-2">Audio Details</MudText>

                        <MudStack Spacing="1">
                            <div class="audio-detail-row">
                                <MudText Typo="Typo.body2" Class="audio-detail-label">Codec</MudText>
                                <MudText Typo="Typo.body1" Class="audio-detail-value">@(_track.Codec ?? "Pending upload")</MudText>
                            </div>

                            <div class="audio-detail-row">
                                <MudText Typo="Typo.body2" Class="audio-detail-label">Bit depth</MudText>
                                <MudText Typo="Typo.body1" Class="audio-detail-value">@(_track.BitDepth ?? "Pending upload")</MudText>
                            </div>

                            <div class="audio-detail-row">
                                <MudText Typo="Typo.body2" Class="audio-detail-label">Channels</MudText>
                                <MudText Typo="Typo.body1" Class="audio-detail-value">@(_track.Channels ?? "Pending upload")</MudText>
                            </div>

                            <div class="audio-detail-row">
                                <MudText Typo="Typo.body2" Class="audio-detail-label">Sample rate</MudText>
                                <MudText Typo="Typo.body1" Class="audio-detail-value">@(_track.SampleRate ?? "Pending upload")</MudText>
                            </div>

                            <div class="audio-detail-row">
                                <MudText Typo="Typo.body2" Class="audio-detail-label">Duration</MudText>
                                <MudText Typo="Typo.body1" Class="audio-detail-value">@FormatDuration(_track.DurationSeconds)</MudText>
                            </div>
                        </MudStack>
                    </MudPaper>

                    <MudPaper Class="pa-4" Elevation="5">
                        <MudText Typo="Typo.h6" Class="mb-3">Appears On</MudText>

                        @if (_track.Releases is null || !_track.Releases.Any())
                        {
                            <MudAlert Severity="Severity.Info" Dense="true">
                                This track is not linked to any releases yet.
                            </MudAlert>
                        }
                        else
                        {
                            <MudList T="string" Dense="true">
                                @foreach (var release in _track.Releases)
                                {
                                    <MudListItem T="string" Icon="@Icons.Material.Filled.Album">
                                        @release.Title
                                    </MudListItem>
                                }
                            </MudList>
                        }
                    </MudPaper>

                </MudStack>
            </MudItem>

        </MudGrid>
    }
</MudStack>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private TrackDetailsDto? _track;
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _track = await Http.GetFromJsonAsync<TrackDetailsDto>($"api/track/{Id}");
        }
        catch (Exception ex)
        {
            _errorMessage = $"Could not fetch track: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string FormatDuration(int durationSeconds)
    {
        var ts = TimeSpan.FromSeconds(durationSeconds);
        return ts.ToString(@"mm\:ss");
    }

    private string FormatDate(DateTime? value)
    {
        return value?.ToString("dd-MM-yyyy HH:mm") ?? "-";
    }

    private string? errorMessage;
    private async Task DeleteTrack(Guid id)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/track/{id}");

            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo($"/tracks");
            }
            else
            {
                errorMessage = $"Could not delete track. Status code: {(int)response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not delete track: {ex.Message}";
        }
    }

    public class TrackDetailsDto
    {
        public Guid Id { get; set; }
        public string? Title { get; set; }
        public string? Version { get; set; }
        public string? ISRC { get; set; }
        public int DurationSeconds { get; set; }

        public string? GenreName { get; set; }
        public string? MetadataLanguageName { get; set; }
        public string? AudioLanguageName { get; set; }

        public bool HasAudio { get; set; }
        public string? Codec { get; set; }
        public string? BitDepth { get; set; }
        public string? Channels { get; set; }
        public string? SampleRate { get; set; }

        public DateTime? CreatedAt { get; set; }
        public DateTime? LastUpdatedAt { get; set; }

        public List<ContributorDto> Contributors { get; set; } = new();
        public List<ReleaseDto> Releases { get; set; } = new();


    }

    public class ContributorDto
    {
        public string? Name { get; set; }
        public string? Role { get; set; }
    }

    public class ReleaseDto
    {
        public string? Title { get; set; }
    }
}