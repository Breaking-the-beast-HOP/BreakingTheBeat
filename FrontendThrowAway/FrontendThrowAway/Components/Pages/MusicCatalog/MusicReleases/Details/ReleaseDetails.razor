@page "/releases/{Id:guid}"
@using FrontendThrowAway.Components.Shared;
@using FrontendThrowAway.Components.Layout
@using FrontendThrowAway.Components.Pages.MusicCatalog.SharedModels
@using FrontendThrowAway.Components.Pages.MusicCatalog.MusicReleases
@using MudBlazor


@namespace FrontendThrowAway.Components.Pages.MusicCatalog.MusicReleases.Details

<PageTitle>Release</PageTitle>

<MudStack Spacing="3">

    <!-- Header -->
    <MudPaper Class="pa-4" Elevation="5">
        <MudStack Row="@true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <div>
                <MudText Typo="Typo.h4">@(_release?.Title ?? "Release")</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Release details
                </MudText>
            </div>

            <MudStack Row="@true" Spacing="2">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           Href="/releases">
                    Back
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Warning"
                           StartIcon="@Icons.Material.Filled.Edit"
                           Href="@($"/releases/edit/{Id}")">
                    Edit
                </MudButton>

                <MudButton Variant="Variant.Text"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.Delete"
                           OnClick="@(async () => await DeleteRelease(Id))">
                    Delete
                </MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>

    @if (_isLoading)
    {
        <MudProgressCircular Indeterminate="@true" />
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error">
            @_errorMessage
        </MudAlert>
    }
    else if (_release is null)
    {
        <MudAlert Severity="Severity.Warning">
            Release not found.
        </MudAlert>
    }
    else
    {
        <MudGrid Spacing="3">

            <!-- LEFT -->
            <MudItem xs="12" md="7">
                <MudStack Spacing="3">

                    <!-- Release Info -->
                    <MudPaper Class="pa-4" Elevation="5">
                        <MudText Typo="Typo.h6" Class="mb-3">Release Info</MudText>

                        <MudGrid>

                            <!-- Venstre kolonne -->
                            <MudItem xs="12" md="6">
                                <MudStack Spacing="1">
                                    <DetailRow Label="Title" Value="@_release.Title" />

                                    <DetailRow Label="Version"
                                               Value="@(string.IsNullOrWhiteSpace(_release.Version) ? "-" : _release.Version)" />

                                    <DetailRow Label="EAN"
                                               Value="@(string.IsNullOrWhiteSpace(_release.EAN) ? "-" : _release.EAN)" />
                                </MudStack>
                            </MudItem>

                            <!-- Højre kolonne -->
                            <MudItem xs="12" md="6">
                                <MudStack Spacing="1">
                                    <DetailRow Label="Release date"
                                               Value="@FormatDateOnly(_release.ReleaseDate)" />

                                    <DetailRow Label="Metadata language"
                                               Value="@(_release.LanguageName ?? "-")" />

                                    <DetailRow Label="Genre"
                                               Value="@(_release.GenreName ?? "-")" />
                                </MudStack>
                            </MudItem>

                        </MudGrid>
                    </MudPaper>

                    <!-- Contributors -->

                    <ContributionDisplay Title="Contributors"
                                         EmptyText="No contributors registered."
                                         Contributions="_contributionItems" />

                    <!-- Volumes -->
                    <MudPaper Class="pa-4" Elevation="5">
                        <MudText Typo="Typo.h6" Class="mb-3">Volumes</MudText>

                        @if (_release.Volumes is null || !_release.Volumes.Any())
                        {
                            <MudAlert Severity="Severity.Info" Dense="@true">
                                No volumes registered.
                            </MudAlert>
                        }
                        else
                        {
                            @foreach (var volume in _release.Volumes.OrderBy(v => v.VolumeNumber))
                            {
                                <MudPaper Class="mb-4" Outlined="@true">

                                    <MudStack Row="@true"
                                              Justify="Justify.SpaceBetween"
                                              AlignItems="AlignItems.Center"
                                              Class="pa-3">

                                        <MudText Typo="Typo.h6">
                                            Volume @volume.VolumeNumber
                                        </MudText>

                                        <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small">
                                            @volume.Tracks.Count track(s)
                                        </MudChip>
                                    </MudStack>

                                    <MudDivider />

                                    @foreach (var track in volume.Tracks.OrderBy(t => t.TrackNumber))
                                    {
                                        <MudStack Row="@true"
                                                  AlignItems="AlignItems.Center"
                                                  Spacing="2"
                                                  Class="pa-3 volume-track-row">

                                            <MudText Typo="Typo.body2" Class="track-number">
                                                @track.TrackNumber
                                            </MudText>

                                            <MudIcon Icon="@Icons.Material.Filled.AudioFile"
                                                     Size="Size.Small"
                                                     Color="Color.Warning" />

                                            <MudStack Spacing="0" Class="flex-grow-1">
                                                <MudText Typo="Typo.subtitle2">
                                                    @track.Title
                                                </MudText>

                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    @DisplayTrackSubtitle(track)
                                                </MudText>
                                            </MudStack>

                                            <MudText Typo="Typo.body2" Class="duration-text">
                                                @FormatDuration(track.DurationSeconds)
                                            </MudText>

                                            <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                                           Color="Color.Warning"
                                                           Size="Size.Small"
                                                           Href="@($"/tracks/{track.TrackId}")" />
                                        </MudStack>

                                        <MudDivider />
                                    }
                                </MudPaper>
                            }
                        }
                    </MudPaper>

                </MudStack>
            </MudItem>

            <!-- RIGHT -->
            <MudItem xs="12" md="5">
                <MudStack Spacing="3">

                    <!-- Cover -->
                    <MudPaper Class="pa-4" Elevation="5">
                        <MudText Typo="Typo.h6" Class="mb-3">Cover</MudText>

                        <MudPaper Class="dropzone pa-6" Outlined="@true">
                            <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.Image"
                                         Size="Size.Large"
                                         Color="Color.Warning" />

                                <MudText Typo="Typo.subtitle1">Cover asset</MudText>

                                <MudChip T="string"
                                         Color="@(_release.HasCover ? Color.Success : Color.Default)"
                                         Variant="Variant.Outlined">
                                    @(_release.HasCover ? "Uploaded" : "Not uploaded")
                                </MudChip>
                            </MudStack>
                        </MudPaper>
                    </MudPaper>

                    <!-- Booklet -->
                    <MudPaper Class="pa-4" Elevation="5">
                        <MudText Typo="Typo.h6" Class="mb-3">Booklet</MudText>

                        <MudPaper Class="dropzone pa-6" Outlined="@true">
                            <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf"
                                         Size="Size.Large"
                                         Color="Color.Warning" />

                                <MudText Typo="Typo.subtitle1">Booklet asset</MudText>

                                <MudChip T="string"
                                         Color="@(_release.HasBooklet ? Color.Success : Color.Default)"
                                         Variant="Variant.Outlined">
                                    @(_release.HasBooklet ? "Uploaded" : "Not uploaded")
                                </MudChip>
                            </MudStack>
                        </MudPaper>
                    </MudPaper>

                    <!-- Summary -->
                    <MudPaper Class="pa-4" Elevation="5">
                        <MudText Typo="Typo.h6" Class="mb-3">Summary</MudText>

                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="6">
                                <DetailRow Label="Volumes" Value="@_release.Volumes.Count.ToString()" />
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <DetailRow Label="Tracks" Value="@_release.Volumes.SelectMany(v => v.Tracks).Count().ToString()" />
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <DetailRow Label="Duration" Value="@FormatDuration(_release.Volumes.SelectMany(v => v.Tracks).Sum(t => t.DurationSeconds))" />
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <DetailRow Label="Contributors" Value="@_release.Contributions.Count.ToString()" />
                            </MudItem>
                        </MudGrid>
                    </MudPaper>

                </MudStack>
            </MudItem>

        </MudGrid>
    }
</MudStack>


