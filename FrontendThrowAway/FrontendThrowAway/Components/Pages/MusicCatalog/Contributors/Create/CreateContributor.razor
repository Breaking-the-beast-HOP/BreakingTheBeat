@page "/create-contributor"
@rendermode InteractiveServer
@using MudBlazor

<PageTitle>Create Contributor</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="pa-6">

    <MudStack Spacing="4">

        <MudPaper Class="pa-4">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h4">Create Contributor</MudText>

                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Text"
                               Color="Color.Default"
                               Href="/contributors"
                               Disabled="_isSaving">
                        Cancel
                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Warning"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="SaveContributor"
                               Disabled="_isSaving">
                        @(_isSaving ? "Saving..." : "Save")
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudAlert Severity="Severity.Error">
                @_errorMessage
            </MudAlert>
        }

        <MudPaper Class="pa-4" Elevation="5">
            <MudText Typo="Typo.h6" Class="mb-3">Contributor Info</MudText>

            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudTextField Label="Display name / Artist name"
                                  @bind-Value="_model.DisplayName"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  FullWidth="true" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField Label="Legal name"
                                  @bind-Value="_model.LegalName"
                                  Variant="Variant.Outlined"
                                  FullWidth="true" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField Label="IPI"
                                  @bind-Value="_model.IPI"
                                  Variant="Variant.Outlined"
                                  FullWidth="true" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField Label="ISNI"
                                  @bind-Value="_model.ISNI"
                                  Variant="Variant.Outlined"
                                  FullWidth="true" />
                </MudItem>
            </MudGrid>
        </MudPaper>

    </MudStack>

</MudContainer>

<MudDialog @bind-Visible="_showSuccessDialog">
    <TitleContent>
        Contributor created
    </TitleContent>

    <DialogContent>
        <MudText>
            The contributor was created successfully. What would you like to do now?
        </MudText>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text"
                   OnClick="GoToContributors">
            Go to contributors
        </MudButton>

        <MudButton Variant="Variant.Outlined"
                   Color="Color.Warning"
                   OnClick="CreateAnother">
            Create another
        </MudButton>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Warning"
                   OnClick="GoToCreatedContributor">
            View contributor
        </MudButton>
    </DialogActions>
</MudDialog>