@page "/tracks"
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Track Catalog</PageTitle>

<MudStack Spacing="3">

    <!-- Header -->
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.h4">Track Catalog</MudText>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Warning"
                   StartIcon="@Icons.Material.Filled.Add"
                   Href="/create-track">
            Create Track
        </MudButton>
    </MudStack>

    <!-- Search -->
    <MudTextField @bind-Value="_searchString"
                  Placeholder="Search title or ISRC..."
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Variant="Variant.Outlined"
                  Immediate="true" />

    <!-- Content -->
    @if (isLoading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <MudAlert Severity="Severity.Error">
            @errorMessage
        </MudAlert>
    }
    else if (_tracks == null || !_tracks.Any())
    {
        <MudAlert Severity="Severity.Info">
            No tracks found.
        </MudAlert>
    }
    else
    {
        <MudPaper Class="pa-4" Elevation="5">

            <MudTable Items="FilteredTracks"
                      T="TrackDto"
                      Hover="true"
                      Dense="true"
                      Elevation="0"
                      OnRowClick="@(args => OnRowClicked(args))">
                

                <HeaderContent>
                    <MudTh>Title</MudTh>
                    <MudTh>Version</MudTh>
                    <MudTh>ISRC</MudTh>
                    <MudTh>Duration</MudTh>
                    <MudTh>Language</MudTh>
                    <MudTh>Genre</MudTh>
                </HeaderContent>

                <RowTemplate>
                    <MudTd DataLabel="Title">
                        <MudText Typo="Typo.subtitle2">@context.Title</MudText>
                    </MudTd>

                    <MudTd DataLabel="Version">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @(string.IsNullOrWhiteSpace(context.Version) ? "-" : context.Version)
                        </MudText>
                    </MudTd>

                    <MudTd DataLabel="ISRC">
                        <MudText Typo="Typo.body2">
                            @context.Isrc
                        </MudText>
                    </MudTd>

                    <MudTd DataLabel="Duration">
                        <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Size="Size.Small">
                            @FormatDuration(context.DurationSeconds)
                        </MudChip>
                    </MudTd>

                    <MudTd DataLabel="Language">
                        <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small">
                            @(context.AudioLanguageName ?? "-")
                        </MudChip>
                    </MudTd>

                    <MudTd DataLabel="Genre">
                        <MudChip T="string" Color="Color.Secondary" Variant="Variant.Filled" Size="Size.Small">
                            @(context.GenreName ?? "-")
                        </MudChip>
                    </MudTd>

                    <!-- Edit -->
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Color="Color.Warning"
                                   Size="Size.Small"
                                   Title="Edit track"
                                   OnClick="@(() => GoToEdit(context.Id))" />

                    <!-- Delete -->
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   Title="Delete track"
                                   OnClick="@(async () => await DeleteTrack(context.Id))" />

                </RowTemplate>

            </MudTable>
        </MudPaper>
    }

</MudStack>

@code {
    private List<TrackDto> _tracks = new();
    private bool isLoading = true;
    private string? errorMessage;
    private string _searchString = string.Empty;

    private IEnumerable<TrackDto> FilteredTracks =>
        _tracks.Where(t =>
            string.IsNullOrWhiteSpace(_searchString) ||
            (t.Title?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (t.Isrc?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _tracks = await Http.GetFromJsonAsync<List<TrackDto>>("api/track")
                     ?? new List<TrackDto>();
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not fetch tracks: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private string FormatDuration(int durationSeconds)
    {
        var ts = TimeSpan.FromSeconds(durationSeconds);
        return ts.ToString(@"mm\:ss");
    }

    private void OnRowClicked(TableRowClickEventArgs<TrackDto> args)
    {
        Navigation.NavigateTo($"/tracks/{args.Item.Id}");
    }

    private void GoToEdit(Guid id)
    {
        Navigation.NavigateTo($"/tracks/edit/{id}");
    }
    private async Task DeleteTrack(Guid id)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/track/{id}");

            if (response.IsSuccessStatusCode)
            {
                var trackToRemove = _tracks.FirstOrDefault(t => t.Id == id);
                if (trackToRemove is not null)
                {
                    _tracks.Remove(trackToRemove);
                }
            }
            else
            {
                errorMessage = $"Could not delete track. Status code: {(int)response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not delete track: {ex.Message}";
        }
    }



    public class TrackDto
    {
        public Guid Id { get; set; }
        public string? Title { get; set; }
        public string? Version { get; set; }
        public string? Isrc { get; set; }
        public int DurationSeconds { get; set; }
        public string? AudioLanguageName { get; set; }
        public string? GenreName { get; set; }
    }
}
