@page "/create-podcast"
@rendermode InteractiveServer
@using MudBlazor
@inject HttpClient Http

<PageTitle>Create Podcast</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-6">

    <MudStack Spacing="4">

        <!-- Header -->
        <MudPaper Class="pa-4">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h4">Create Podcast</MudText>

                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Text"
                               Color="Color.Default"
                               Href="/podcasts">
                        Cancel
                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Warning"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="SavePodcast"
                               Disabled="_isSaving || _isLoadingLookups">
                        @(_isSaving ? "Saving..." : "Save")
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
        }

        @if (!string.IsNullOrWhiteSpace(_successMessage))
        {
            <MudAlert Severity="Severity.Success">@_successMessage</MudAlert>
        }

        <MudGrid Spacing="3">

            <!-- LEFT COLUMN -->
            <MudItem xs="12" md="7">
                <MudStack Spacing="3">

                    <!-- Podcast info -->
                    <MudPaper Class="pa-4" Elevation="5">
                        <MudText Typo="Typo.h6" Class="mb-3">Podcast Info</MudText>

                        <MudGrid Spacing="2">

                            <MudItem xs="12">
                                <MudTextField Label="Title"
                                              @bind-Value="_model.Title"
                                              Variant="Variant.Outlined"
                                              Required="true"
                                              FullWidth="true" />
                            </MudItem>

                            <MudItem xs="12">
                                <MudTextField Label="Description"
                                              @bind-Value="_model.Description"
                                              Variant="Variant.Outlined"
                                              Lines="5"
                                              FullWidth="true" />
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudAutocomplete T="PodcastCategoryDto"
                                                 Label="Category"
                                                 Variant="Variant.Outlined"
                                                 Value="_selectedCategory"
                                                 ValueChanged="OnCategoryChanged"
                                                 SearchFunc="SearchCategories"
                                                 ToStringFunc="@(c => c?.Name ?? string.Empty)"
                                                 Clearable="true"
                                                 ResetValueOnEmptyText="true"
                                                 CoerceText="false"
                                                 Dense="true"
                                                 FullWidth="true"
                                                 MaxItems="8"
                                                 Disabled="_isLoadingLookups" />
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudAutocomplete T="LanguageDto"
                                                 Label="Language"
                                                 Variant="Variant.Outlined"
                                                 Value="_selectedLanguage"
                                                 ValueChanged="OnLanguageChanged"
                                                 SearchFunc="SearchLanguages"
                                                 ToStringFunc="@(l => l?.Name ?? string.Empty)"
                                                 Clearable="true"
                                                 ResetValueOnEmptyText="true"
                                                 CoerceText="false"
                                                 Dense="true"
                                                 FullWidth="true"
                                                 MaxItems="8"
                                                 Disabled="_isLoadingLookups" />
                            </MudItem>

                        </MudGrid>
                    </MudPaper>

                    <!-- Contributions -->
                    <MudPaper Class="pa-4" Elevation="5">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                            <div>
                                <MudText Typo="Typo.h6">Contributions</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    Add hosts, guests, producers, editors, or other contributors.
                                </MudText>
                            </div>

                            <MudButton Variant="Variant.Text"
                                       Color="Color.Warning"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="AddContributionRow">
                                Add contributor
                            </MudButton>
                        </MudStack>

                        @if (!_contributions.Any())
                        {
                            <MudAlert Severity="Severity.Info" Dense="true">
                                No contributors added yet.
                            </MudAlert>
                        }
                        else
                        {
                            <MudStack Spacing="2">
                                @foreach (var contribution in _contributions.Select((value, index) => new { value, index }))
                                {
                                    <MudPaper Outlined="true" Class="pa-3">
                                        <MudGrid Spacing="2">
                                            <MudItem xs="12" sm="5">
                                                <MudTextField Label="Contributor"
                                                              @bind-Value="contribution.value.Name"
                                                              Variant="Variant.Outlined"
                                                              FullWidth="true" />
                                            </MudItem>

                                            <MudItem xs="12" sm="5">
                                                <MudSelect T="string"
                                                           Label="Role"
                                                           @bind-Value="contribution.value.Role"
                                                           Variant="Variant.Outlined"
                                                           FullWidth="true">
                                                    @foreach (var role in _contributionRoles)
                                                    {
                                                        <MudSelectItem T="string" Value="@role">
                                                            @role
                                                        </MudSelectItem>
                                                    }
                                                </MudSelect>
                                            </MudItem>

                                            <MudItem xs="12" sm="2" Class="d-flex align-center">
                                                <MudButton Variant="Variant.Text"
                                                           Color="Color.Error"
                                                           StartIcon="@Icons.Material.Filled.Delete"
                                                           OnClick="@(() => RemoveContributionRow(contribution.index))">
                                                    Remove
                                                </MudButton>
                                            </MudItem>
                                        </MudGrid>
                                    </MudPaper>
                                }
                            </MudStack>
                        }
                    </MudPaper>

                </MudStack>
            </MudItem>

            <!-- RIGHT COLUMN -->
            <MudItem xs="12" md="5">
                <MudStack Spacing="3">

                    <MudPaper Class="pa-4" Elevation="5">
                        <MudText Typo="Typo.h6" Class="mb-3">Podcast Cover</MudText>

                        <MudPaper Class="dropzone pa-6" Outlined="true">
                            <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.Image"
                                         Size="Size.Large"
                                         Color="Color.Warning" />

                                <MudText Typo="Typo.subtitle1">Cover drop zone</MudText>

                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    Cover upload comes later
                                </MudText>
                            </MudStack>
                        </MudPaper>
                    </MudPaper>

                    <MudPaper Class="pa-4" Elevation="5">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <div>
                                <MudText Typo="Typo.h6">Episodes</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    Episodes can be added after the podcast has been created.
                                </MudText>
                            </div>

                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Warning"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       Disabled="true">
                                Create Episode
                            </MudButton>
                        </MudStack>

                        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                            Save the podcast first, then create episodes with audio files.
                        </MudAlert>
                    </MudPaper>

                </MudStack>
            </MudItem>

        </MudGrid>

    </MudStack>
</MudContainer>

@code {
    private PodcastModel _model = new();

    private static readonly Guid PlaceholderId =
    Guid.Parse("11111111-1111-1111-1111-111111111111");

    private List<LanguageDto> _languages = new();
    private List<PodcastCategoryDto> _categories = new();

    private LanguageDto? _selectedLanguage;
    private PodcastCategoryDto? _selectedCategory;

    private List<ContributionRow> _contributions = new();

    private readonly List<string> _contributionRoles = new()
    {
        "Host",
        "Co-host",
        "Guest",
        "Producer",
        "Editor",
        "Researcher",
        "Narrator"
    };

    private bool _isLoadingLookups = true;
    private bool _isSaving = false;
    private string? _errorMessage;
    private string? _successMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _languages = await Http.GetFromJsonAsync<List<LanguageDto>>("api/podcasts/Language") ?? new();

            _categories = await Http.GetFromJsonAsync<List<PodcastCategoryDto>>("api/PodcastCategory")
                          ?? GetFallbackCategories();
        }
        catch
        {
            _categories = GetFallbackCategories();
        }
        finally
        {
            EnsurePlaceholderExists();

            // 🔥 DEFAULT SELECTION (det vigtige)
            _selectedCategory = _categories.First(c => c.Id == PlaceholderId);
            _selectedLanguage = _languages.First(c => c.Id == PlaceholderId);

            _model.CategoryId = PlaceholderId;
            _model.LanguageId = PlaceholderId;

            _isLoadingLookups = false;
        }
    }


    private Task<IEnumerable<PodcastCategoryDto>> SearchCategories(string value, CancellationToken token)
    {
        IEnumerable<PodcastCategoryDto> result = string.IsNullOrWhiteSpace(value)
            ? _categories
            : _categories.Where(c => c.Name.Contains(value, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(result);
    }

    private Task<IEnumerable<LanguageDto>> SearchLanguages(string value, CancellationToken token)
    {
        IEnumerable<LanguageDto> result = string.IsNullOrWhiteSpace(value)
            ? _languages
            : _languages.Where(l =>
                l.Name.Contains(value, StringComparison.OrdinalIgnoreCase) ||
                l.ISO.Contains(value, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(result);
    }

    private Task OnCategoryChanged(PodcastCategoryDto? category)
    {
        _selectedCategory = category;
        _model.CategoryId = category?.Id;
        return Task.CompletedTask;
    }

    private Task OnLanguageChanged(LanguageDto? language)
    {
        _selectedLanguage = language;
        _model.LanguageId = language?.Id;
        return Task.CompletedTask;
    }

    private void AddContributionRow()
    {
        _contributions.Add(new ContributionRow());
    }

    private void RemoveContributionRow(int index)
    {
        if (index >= 0 && index < _contributions.Count)
            _contributions.RemoveAt(index);
    }

    private async Task SavePodcast()
    {
        _errorMessage = null;
        _successMessage = null;

        if (string.IsNullOrWhiteSpace(_model.Title))
        {
            _errorMessage = "Title is required.";
            return;
        }

        if (_model.CategoryId is null || _model.CategoryId == Guid.Empty)
        {
            _errorMessage = "Category is required.";
            return;
        }

        if (_model.LanguageId is null || _model.LanguageId == Guid.Empty)
        {
            _errorMessage = "Language is required.";
            return;
        }

        try
        {
            _isSaving = true;

            var response = await Http.PostAsJsonAsync("api/podcasts/podcast", _model);

            if (response.IsSuccessStatusCode)
            {
                _successMessage = "Podcast created successfully.";

                _model = new PodcastModel();
                _selectedCategory = null;
                _selectedLanguage = null;
                _contributions.Clear();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                _errorMessage = string.IsNullOrWhiteSpace(error)
                    ? "Failed to save podcast."
                    : error;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"An error occurred while saving: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void EnsurePlaceholderExists()
    {
        if (!_categories.Any(c => c.Id == PlaceholderId))
        {
            _categories.Insert(0, new PodcastCategoryDto
            {
                Id = PlaceholderId,
                Name = "Placeholder"
            });
        }

        if (!_languages.Any(l => l.Id == PlaceholderId))
        {
            _languages.Insert(0, new LanguageDto
            {
                Id = PlaceholderId,
                Name = "Placeholder",
                ISO = "xx"
            });
        }
    }


    private static List<PodcastCategoryDto> GetFallbackCategories()
    {
        return new()
        {
            new PodcastCategoryDto { Id = Guid.Parse("11111111-1111-1111-1111-111111111111"), Name = "Placeholder" }
        };
    }

    public class PodcastModel
    {
        public string? Title { get; set; }
        public string? Description { get; set; }
        public Guid? CategoryId { get; set; }
        public Guid? LanguageId { get; set; }
    }

    public class ContributionRow
    {
        public string? Name { get; set; }
        public string? Role { get; set; }
    }

    public class LanguageDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
        public string ISO { get; set; } = "";
    }

    public class PodcastCategoryDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
    }
}
