@using MudBlazor

<MudPaper Class="pa-4" Elevation="5">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
        <div>
            <MudText Typo="Typo.h6">@Title</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @Description
            </MudText>
        </div>

        <MudButton Variant="Variant.Text"
                   Color="Color.Warning"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="AddRow">
            Add contributor
        </MudButton>
    </MudStack>

    @if (!Rows.Any())
    {
        <MudAlert Severity="Severity.Info" Dense="true">
            No contributors added yet.
        </MudAlert>
    }
    else
    {
        <MudStack Spacing="2">
            @foreach (var row in Rows.Select((value, index) => new { value, index }))
            {
                <MudPaper Outlined="true" Class="pa-3 contribution-row">
                    <MudGrid Spacing="2" AlignItems="AlignItems.Center">

                        <MudItem xs="12" sm="4">
                            <MudAutocomplete T="ContributorOption"
                                             Label="Contributor"
                                             Variant="Variant.Outlined"
                                             Value="row.value.Contributor"
                                             ValueChanged="@(value => OnContributorChanged(row.index, value))"
                                             SearchFunc="SearchContributors"
                                             ToStringFunc="@(c => c?.DisplayName ?? string.Empty)"
                                             Clearable="true"
                                             Dense="true"
                                             FullWidth="true" />
                        </MudItem>

                        <MudItem xs="12" sm="7">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Roles
                            </MudText>

                            @if (row.value.Roles.Any())
                            {
                                <MudStack Row="true" Spacing="1" Class="mt-1 mb-1" Style="flex-wrap: wrap;">
                                    @foreach (var role in row.value.Roles)
                                    {
                                        <MudChip T="ContributorRoleDto"
                                                 Size="Size.Small"
                                                 Color="Color.Warning"
                                                 Variant="Variant.Filled"
                                                 Closeable="true"
                                                 OnClose="@(() => RemoveRole(row.index, role))">
                                            @role.Name
                                        </MudChip>
                                    }
                                </MudStack>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1 mb-1">
                                    No roles added
                                </MudText>
                            }

                            <MudAutocomplete @key="row.value.RoleInputKey"
                                             T="ContributorRoleDto"
                                             Placeholder="Add role..."
                                             Variant="Variant.Text"
                                             Dense="true"
                                             FullWidth="false"
                                             Style="max-width: 260px;"
                                             SearchFunc="@(async (value, token) => await SearchRoles(value, row.value.Roles, token))"
                                             ValueChanged="@(role => AddRole(row.index, role))"
                                             ToStringFunc="@(r => r?.Name ?? string.Empty)"
                                             Clearable="true" />
                        </MudItem>

                        <MudItem xs="12" sm="1" Class="d-flex justify-end">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="@(() => RemoveRow(row.index))" />
                        </MudItem>

                    </MudGrid>
                </MudPaper>
            }
        </MudStack>
    }

    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-3">
        <MudButton Variant="Variant.Text"
                   Color="Color.Warning"
                   StartIcon="@Icons.Material.Filled.PersonAdd"
                   OnClick="OpenCreateContributorDialog">
            Create new contributor
        </MudButton>
    </MudStack>
</MudPaper>

<MudDialog @bind-Visible="_showCreateContributorDialog">
    <TitleContent>
        Create contributor
    </TitleContent>

    <DialogContent>
        <MudStack Spacing="2">
            @if (!string.IsNullOrWhiteSpace(_createContributorError))
            {
                <MudAlert Severity="Severity.Error" Dense="true">
                    @_createContributorError
                </MudAlert>
            }

            <MudTextField Label="Display name / Artist name"
                          @bind-Value="_newContributor.DisplayName"
                          Variant="Variant.Outlined"
                          Required="true"
                          FullWidth="true" />

            <MudTextField Label="Legal name"
                          @bind-Value="_newContributor.LegalName"
                          Variant="Variant.Outlined"
                          FullWidth="true" />

            <MudTextField Label="IPI"
                          @bind-Value="_newContributor.IPI"
                          Variant="Variant.Outlined"
                          FullWidth="true" />

            <MudTextField Label="ISNI"
                          @bind-Value="_newContributor.ISNI"
                          Variant="Variant.Outlined"
                          FullWidth="true" />
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text"
                   Disabled="_isCreatingContributor"
                   OnClick="CloseCreateContributorDialog">
            Cancel
        </MudButton>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Warning"
                   Disabled="_isCreatingContributor"
                   OnClick="CreateContributor">
            @(_isCreatingContributor ? "Creating..." : "Create")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public string Title { get; set; } = "Contributors";
    [Parameter] public string Description { get; set; } = "Add contributors and roles.";
    [Parameter] public List<ContributionRow> Rows { get; set; } = new();
    [Parameter] public List<ContributorOption> Contributors { get; set; } = new();
    [Parameter] public List<ContributorRoleDto> AvailableRoles { get; set; } = new();

    [Inject] protected HttpClient Http { get; set; } = default!;

    private Task<IEnumerable<ContributorRoleDto>> SearchRoles(string value, List<ContributorRoleDto> selectedRoles,CancellationToken token)
    {
        IEnumerable<ContributorRoleDto> result = AvailableRoles
            .Where(role => !selectedRoles.Any(selected => selected.Id == role.Id));

        if (!string.IsNullOrWhiteSpace(value))
        {
            result = result.Where(role =>
                role.Name.Contains(value, StringComparison.OrdinalIgnoreCase));
        }

        return Task.FromResult(result);
    }
    private void AddRole(int index, ContributorRoleDto? role)
    {
        if (role is null)
            return;

        var alreadyAdded = Rows[index].Roles.Any(r => r.Id == role.Id);

        if (!alreadyAdded)
            Rows[index].Roles.Add(role);

        Rows[index].RoleInputKey = Guid.NewGuid();
    }

    private void RemoveRole(int index, ContributorRoleDto role)
    {
        var existingRole = Rows[index].Roles.FirstOrDefault(r => r.Id == role.Id);

        if (existingRole is not null)
            Rows[index].Roles.Remove(existingRole);
    }

    private Task<IEnumerable<ContributorOption>> SearchContributors(string value, CancellationToken token)
    {
        IEnumerable<ContributorOption> result = string.IsNullOrWhiteSpace(value)
            ? Contributors
            : Contributors.Where(c =>
                c.DisplayName.Contains(value, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(result);
    }

    private void AddRow()
    {
        Rows.Add(new ContributionRow());
    }

    private void RemoveRow(int index)
    {
        if (index >= 0 && index < Rows.Count)
            Rows.RemoveAt(index);
    }

    private void OnContributorChanged(int index, ContributorOption? contributor)
    {
        Rows[index].Contributor = contributor;
        Rows[index].ContributorId = contributor?.Id;
    }

    private bool _showCreateContributorDialog;
    private bool _isCreatingContributor;
    private string? _createContributorError;

    private CreateContributorModel _newContributor = new();

    private void OpenCreateContributorDialog()
    {
        _newContributor = new CreateContributorModel();
        _createContributorError = null;
        _showCreateContributorDialog = true;
    }

    private void CloseCreateContributorDialog()
    {
        _showCreateContributorDialog = false;
        _createContributorError = null;
    }

    private async Task CreateContributor()
    {
        _createContributorError = null;

        if (string.IsNullOrWhiteSpace(_newContributor.DisplayName))
        {
            _createContributorError = "Display name is required.";
            return;
        }

        try
        {
            _isCreatingContributor = true;

            var response = await Http.PostAsJsonAsync("api/Contributor", _newContributor);

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();

                _createContributorError = string.IsNullOrWhiteSpace(error)? "Failed to create contributor.": error;

                return;
            }

            var contributorId = await response.Content.ReadFromJsonAsync<Guid>();

            var contributor = new ContributorOption
                {
                    Id = contributorId,
                    DisplayName = _newContributor.DisplayName
                };

            Contributors.Add(contributor);

            var emptyRow = Rows.FirstOrDefault(r => r.ContributorId is null);

            if (emptyRow is not null)
            {
                emptyRow.ContributorId = contributor.Id;
                emptyRow.Contributor = contributor;
            }
            else
            {
                Rows.Add(new ContributionRow
                    {
                        ContributorId = contributor.Id,
                        Contributor = contributor
                    });
            }

            _showCreateContributorDialog = false;
            _newContributor = new CreateContributorModel();
        }
        catch (Exception ex)
        {
            _createContributorError = $"An error occurred while creating contributor: {ex.Message}";
        }
        finally
        {
            _isCreatingContributor = false;
        }
    }

    public class ContributionRow
    {
        public Guid? ContributorId { get; set; }
        public ContributorOption? Contributor { get; set; }

        public List<ContributorRoleDto> Roles { get; set; } = new();
        public ContributorRoleDto? SelectedRoleToAdd { get; set; }
        public string RoleSearchText { get; set; } = string.Empty;
        public Guid RoleInputKey { get; set; } = Guid.NewGuid();
    }


    public class ContributorOption
    {
        public Guid Id { get; set; }
        public string DisplayName { get; set; } = "";
    }

    public class ContributorRoleDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
    }
    public class CreateContributorModel
    {
        public string DisplayName { get; set; } = "";
        public string? LegalName { get; set; }
        public string? IPI { get; set; }
        public string? ISNI { get; set; }
    }
}