@page "/create-podcast"
@rendermode InteractiveServer
@using MudBlazor
@inject HttpClient Http
@inject NavigationManager nav
@inject IDialogService DialogService

<PageTitle>Create Podcast</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-6">

    <MudStack Spacing="4">

        <!-- Header -->
        <MudPaper Class="pa-4">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h4">Create Podcast</MudText>

                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Text"
                               Color="Color.Default"
                               Href="/podcasts">
                        Cancel
                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Warning"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="SavePodcast"
                               Disabled="_isSaving || _isLoadingLookups">
                        @(_isSaving ? "Saving..." : "Save")
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
        }

        @if (!string.IsNullOrWhiteSpace(_successMessage))
        {
            <MudAlert Severity="Severity.Success">@_successMessage</MudAlert>
        }

        <MudGrid Spacing="3">

            <!-- LEFT COLUMN -->
            <MudItem xs="12" md="7">
                <MudStack Spacing="3">

                    <!-- Podcast info -->
                    <MudPaper Class="pa-4" Elevation="5">
                        <MudText Typo="Typo.h6" Class="mb-3">Podcast Info</MudText>

                        <MudGrid Spacing="2">

                            <MudItem xs="12">
                                <MudTextField Label="Title"
                                              @bind-Value="_model.Title"
                                              Variant="Variant.Outlined"
                                              Required="true"
                                              FullWidth="true" />
                            </MudItem>

                            <MudItem xs="12">
                                <MudTextField Label="Description"
                                              @bind-Value="_model.Description"
                                              Variant="Variant.Outlined"
                                              Lines="5"
                                              FullWidth="true" />
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudAutocomplete T="PodcastCategoryDto"
                                                 Label="Category *"
                                                 Variant="Variant.Outlined"
                                                 Value="_selectedCategory"
                                                 ValueChanged="OnCategoryChanged"
                                                 SearchFunc="SearchCategories"
                                                 ToStringFunc="@(c => c?.Name ?? string.Empty)"
                                                 Clearable="true"
                                                 ResetValueOnEmptyText="true"
                                                 CoerceText="false"
                                                 Dense="true"
                                                 FullWidth="true"
                                                 MaxItems="8"
                                                 Disabled="_isLoadingLookups" />
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudAutocomplete T="LanguageDto"
                                                 Label="Language *"
                                                 Variant="Variant.Outlined"
                                                 Value="_selectedLanguage"
                                                 ValueChanged="OnLanguageChanged"
                                                 SearchFunc="SearchLanguages"
                                                 ToStringFunc="@(l => l?.Name ?? string.Empty)"
                                                 Clearable="true"
                                                 ResetValueOnEmptyText="true"
                                                 CoerceText="false"
                                                 Dense="true"
                                                 FullWidth="true"
                                                 MaxItems="8"
                                                 Disabled="_isLoadingLookups" />
                            </MudItem>

                        </MudGrid>
                    </MudPaper>

                    <!-- Contributions -->
                    <MudPaper Class="pa-4" Elevation="5">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                            <div>
                                <MudText Typo="Typo.h6">Contributions</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    Add hosts, guests, producers, editors, or other contributors.
                                </MudText>
                            </div>

                            <MudButton Variant="Variant.Text"
                                       Color="Color.Warning"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="AddContributionRow">
                                Add contributor
                            </MudButton>
                        </MudStack>

                        @if (!_contributionRows.Any())
                        {
                            <MudAlert Severity="Severity.Info" Dense="true">
                                No contributors added yet.
                            </MudAlert>
                        }
                        else
                        {
                            <MudStack Spacing="2">
                                @foreach (var contribution in _contributionRows.Select((value, index) => new { value, index }))
                                {
                                    <MudPaper Outlined="true" Class="pa-3">
                                        <MudGrid Spacing="2">

                                            <!-- Contributor -->
                                            <MudItem xs="12" sm="5">
                                                <MudAutocomplete T="Contributor"
                                                                 Label="Contributor"
                                                                 Variant="Variant.Outlined"
                                                                 Value="_contributors.FirstOrDefault(c => c.Id == contribution.value.ContributorId)"
                                                                 ValueChanged="@(value => OnContributionChanged(value, contribution.value))"
                                                                 SearchFunc="SearchContributors"
                                                                 ToStringFunc="@(c => c?.Name ?? string.Empty)"
                                                                 Clearable="true"
                                                                 ResetValueOnEmptyText="true"
                                                                 CoerceText="false"
                                                                 Dense="true"
                                                                 FullWidth="true"
                                                                 MaxItems="8" />
                                            </MudItem>

                                            <!-- Role -->
                                            <MudItem xs="12" sm="5">
                                                <MudSelect T="Guid?"
                                                           Label="Role"
                                                           Value="contribution.value.ContributorRoleId"
                                                           ValueChanged="@(async (Guid? value) => await OnRoleChanged(value, contribution.value))"
                                                           Variant="Variant.Outlined"
                                                           FullWidth="true">

                                                    @foreach (var role in _contributionRoles)
                                                    {
                                                        <MudSelectItem T="Guid?" Value="@role.Id">
                                                            @role.Name
                                                        </MudSelectItem>
                                                    }

                                                </MudSelect>
                                            </MudItem>

                                            <!-- Remove -->
                                            <MudItem xs="12" sm="2" Class="d-flex align-center">
                                                <MudButton Variant="Variant.Text"
                                                           Color="Color.Error"
                                                           StartIcon="@Icons.Material.Filled.Delete"
                                                           OnClick="@(() => RemoveContributionRow(contribution.index))">
                                                    Remove
                                                </MudButton>
                                            </MudItem>

                                        </MudGrid>
                                    </MudPaper>
                                }
                        </MudStack>
                        }
                    </MudPaper>
                </MudStack>
            </MudItem>

            <!-- RIGHT COLUMN -->
            <MudItem xs="12" md="5">
                <MudStack Spacing="3">

                    <MudPaper Class="pa-4" Elevation="5">
                        <MudText Typo="Typo.h6" Class="mb-3">Podcast Cover</MudText>

                        <MudPaper Class="dropzone pa-6" Outlined="true">
                            <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.Image"
                                         Size="Size.Large"
                                         Color="Color.Warning" />

                                <MudText Typo="Typo.subtitle1">Cover drop zone</MudText>

                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    Cover upload comes later
                                </MudText>
                            </MudStack>
                        </MudPaper>
                    </MudPaper>

                    <MudPaper Class="pa-4" Elevation="5">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <div>
                                <MudText Typo="Typo.h6">Episodes</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    Episodes can be added after the podcast has been created.
                                </MudText>
                            </div>

                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Warning"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       Disabled="true">
                                Create Episode
                            </MudButton>
                        </MudStack>

                        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                            Save the podcast first, then create episodes with audio files.
                        </MudAlert>
                    </MudPaper>

                </MudStack>
            </MudItem>

            <MudItem xs="12">
                <PodcastSeasonEditor Seasons="_seasons"
                                     IsLoading="_isLoadingSeasons"
                                     AddSeasonRequested="AddSeason"
                                     RemoveSeasonRequested="RemoveSeason"
                                     AddEpisodeRequested="AddEpisode"
                                     RemoveEpisodeRequested="RemoveEpisode" />
            </MudItem>

        </MudGrid>

    </MudStack>
</MudContainer>

@code {
    private bool _isLoadingSeasons;
    private List<PodcastSeasonEditor.SeasonDto> _seasons = [];

    private PodcastModel _model = new();

    private static readonly Guid PlaceholderId =
    Guid.Parse("11111111-1111-1111-1111-111111111111");

    private List<LanguageDto> _languages = new();
    private List<PodcastCategoryDto> _categories = new();

    private LanguageDto? _selectedLanguage;
    private PodcastCategoryDto? _selectedCategory;

    private List<ContributionRow> _contributionRows = new();

    private List<ContributionRoles> _contributionRoles = new();
    private List<Contributor> _contributors = new();

    private bool _isLoadingLookups = true;
    private bool _isSaving = false;
    private string? _errorMessage;
    private string? _successMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _languages = await Http.GetFromJsonAsync<List<LanguageDto>>("api/podcasts/Language") 
                                ?? new();

            _categories = await Http.GetFromJsonAsync<List<PodcastCategoryDto>>("api/Podcasts/Category") 
                                ?? new();


            _contributionRoles = await Http.GetFromJsonAsync<List<ContributionRoles>>("api/podcasts/ContributorRole")
                                ?? new();

            _contributors = await Http.GetFromJsonAsync<List<Contributor>>("api/podcasts/Contributor")
                                ?? new();

             // _contributionRoles = await Http.GetFromJsonAsync<List<ContributionRoles>>("api/podcasts/ContributorRole")?? new();

             // _contributors = await Http.GetFromJsonAsync<List<Contributor>>("api/podcasts/Contributor") ?? new();

        }
        catch
        {
            // _categories = GetFallbackCategories();
        }
        finally
        {
            // EnsurePlaceholderExists();

            _selectedCategory = null;
            _selectedLanguage = null;

            _model.CategoryId = null;
            _model.LanguageId = null;

            _isLoadingLookups = false;
        }
    }


    private Task<IEnumerable<PodcastCategoryDto>> SearchCategories(string value, CancellationToken token)
    {
        IEnumerable<PodcastCategoryDto> result = string.IsNullOrWhiteSpace(value)
            ? _categories
            : _categories.Where(c => c.Name.Contains(value, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(result);
    }

    private Task<IEnumerable<LanguageDto>> SearchLanguages(string value, CancellationToken token)
    {
        IEnumerable<LanguageDto> result = string.IsNullOrWhiteSpace(value)
            ? _languages
            : _languages.Where(l =>
                l.Name.Contains(value, StringComparison.OrdinalIgnoreCase) ||
                l.ISO.Contains(value, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(result);
    }

    private Task<IEnumerable<Contributor>> SearchContributors(string value, CancellationToken token)
    {
        IEnumerable<Contributor> result = string.IsNullOrWhiteSpace(value)
            ? _contributors
            : _contributors.Where(c =>
                c.Name.Contains(value, StringComparison.OrdinalIgnoreCase) ||
                c.Id.ToString().Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(result);
    }

    private Task OnCategoryChanged(PodcastCategoryDto? category)
    {
        _selectedCategory = category;
        _model.CategoryId = category?.Id;
        return Task.CompletedTask;
    }

    private Task OnLanguageChanged(LanguageDto? language)
    {
        _selectedLanguage = language;
        _model.LanguageId = language?.Id;
        return Task.CompletedTask;
    }

    private Task OnContributionChanged(Contributor? contributor, ContributionRow row)
    {
        row.ContributorId = contributor?.Id;
        row.ContributorName = contributor?.Name;
        return Task.CompletedTask;
    }

    private Task OnRoleChanged(Guid? roleId, ContributionRow row)
    {
        row.ContributorRoleId = roleId;
        return Task.CompletedTask;
    }

    private void AddContributionRow()
    {
        _contributionRows.Add(new ContributionRow());
    }

    private void RemoveContributionRow(int index)
    {
        if (index >= 0 && index < _contributionRows.Count)
            _contributionRows.RemoveAt(index);
    }

    private void AddSeason()
    {
        var nextSeasonNumber = _seasons.Any()
            ? _seasons.Max(s => s.SeasonNumber) + 1
            : 1;

        _seasons.Add(new PodcastSeasonEditor.SeasonDto
        {
            Id = Guid.NewGuid(),
            SeasonNumber = nextSeasonNumber,
            Title = $"Season {nextSeasonNumber}",
            Episodes = []
        });
    }

    private void RemoveSeason(PodcastSeasonEditor.SeasonDto season)
    {
        _seasons.Remove(season);

        for (var i = 0; i < _seasons.Count; i++)
        {
            _seasons[i].SeasonNumber = i + 1;
        }
    }

    private async Task AddEpisode(PodcastSeasonEditor.SeasonDto season)
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseButton = true
        };

        var dialog = await DialogService.ShowAsync<EpisodeDialog>(
            "Add Episode",
            new DialogParameters(),
            options);

        var result = await dialog.Result;

        if (result is null || result.Canceled)
            return;

        if (result.Data is not EpisodeDialog.EpisodeDialogResult episode)
            return;

        season.Episodes.Add(new PodcastSeasonEditor.EpisodeDto
        {
            Id = Guid.NewGuid(),
            Title = episode.Title,
            Description = episode.Description,
            Duration = episode.Duration,
            AiringDate = episode.AiringDate,
            TagId = episode.TagId,
            TagName = episode.TagName
        });
    }

    private void RemoveEpisode(PodcastSeasonEditor.EpisodeDto episode)
    {
        var season = _seasons.FirstOrDefault(s =>
            s.Episodes.Any(e => e.Id == episode.Id));

        if (season is null)
            return;

        season.Episodes.Remove(episode);
    }

    private async Task SavePodcast()
    {
        _errorMessage = null;
        _successMessage = null;


        if (string.IsNullOrWhiteSpace(_model.Title))
        {
            _errorMessage = "Title is required.";
            return;
        }

        if (_model.CategoryId is null || _model.CategoryId == Guid.Empty)
        {
            _errorMessage = "Category is required.";
            return;
        }

        if (_model.LanguageId is null || _model.LanguageId == Guid.Empty)
        {
            _errorMessage = "Language is required.";
            return;
        }

        _model.Contributions = _contributionRows.Select(r => new ContributionRequest
            {
                ContributorId = r.ContributorId ?? Guid.Empty,
                ContributorRoleId = r.ContributorRoleId ?? Guid.Empty,
                HasRights = r.HasRights,
                ContributorName = r.ContributorName
            }).ToList();

        // if(!_model.Contributions.Any()) //TEMP for testing without it 
        // {
        //     _errorMessage = "At least one contribution is required.";
        //     return;
        // }

        if (_model.Contributions.Any(c => c.ContributorId == null || c.ContributorRoleId == null))
        {
            _errorMessage = "All contributions must have a contributor and a role selected.";
            return;
        }


        try
        {
            _isSaving = true;

            var request = new NewPodcastRequest
            {
                Title = _model.Title!,
                Description = _model.Description,
                CategoryId = _model.CategoryId!.Value,
                LanguageId = _model.LanguageId!.Value,

                // Contributors virker ikke endnu
                Contributions = null,

                Seasons = _seasons.Select(season => new NewPodcastSeasonRequest
                {
                    Title = season.Title,
                    SeasonNumber = season.SeasonNumber,
                    Episodes = season.Episodes.Select(episode => new NewPodcastEpisodeRequest
                    {
                        Title = episode.Title,
                        Description = episode.Description,
                        Duration = episode.Duration,
                        AiringDate = episode.AiringDate,
                        TagId = episode.TagId,
                        Status = "Draft"
                    }).ToList()
                }).ToList()
            };

            var response = await Http.PostAsJsonAsync("api/podcasts/podcast", request);

            if (response.IsSuccessStatusCode)
            {
                _successMessage = "Podcast created successfully.";

                _model = new PodcastModel();
                _selectedCategory = null;
                _selectedLanguage = null;
                _contributionRows.Clear();
                nav.NavigateTo("/podcasts");
                return;
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                _errorMessage = string.IsNullOrWhiteSpace(error)
                    ? "Failed to save podcast."
                    : error;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"An error occurred while saving: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }


    public class PodcastModel
    {
        public string? Title { get; set; }
        public string? Description { get; set; }
        public Guid? CategoryId { get; set; }
        public Guid? LanguageId { get; set; }
        public List<ContributionRequest> Contributions { get; set; } = [];
    }

    public class ContributionRequest
    {
        public Guid ContributorId { get; set; }
        public string? ContributorName { get; set; }
        public Guid ContributorRoleId { get; set; }
        public bool HasRights { get; set; }
    }

    public class ContributionRow
    {
        public Guid? ContributorId { get; set; }
        public string? ContributorName { get; set; }
        public Guid? ContributorRoleId { get; set; }
        public bool HasRights { get; set; }
    }

    public class ContributionRoles
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
    }

    public class Contributor
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
        public string? Description { get; set; }
    }

    public class LanguageDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
        public string ISO { get; set; } = "";
    }

    public class PodcastCategoryDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
    }
    public class NewPodcastRequest
    {
        public string Title { get; set; } = "";
        public string? Description { get; set; }

        public Guid CategoryId { get; set; }
        public Guid LanguageId { get; set; }

        public List<ContributionRequest>? Contributions { get; set; }

        public List<NewPodcastSeasonRequest> Seasons { get; set; } = [];
    }

    public class NewPodcastSeasonRequest
    {
        public string? Title { get; set; }
        public int SeasonNumber { get; set; }

        public List<NewPodcastEpisodeRequest> Episodes { get; set; } = [];
    }

    public class NewPodcastEpisodeRequest
    {
        public string? Title { get; set; }
        public string? Description { get; set; }

        public TimeSpan? Duration { get; set; }
        public DateOnly? AiringDate { get; set; }

        public Guid? TagId { get; set; }

        public string Status { get; set; } = "Draft";
    }
}