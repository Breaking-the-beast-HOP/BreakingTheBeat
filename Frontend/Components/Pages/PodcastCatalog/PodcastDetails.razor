@page "/podcasts/{Id:guid}"
@using Frontend.Components.Shared
@using MudBlazor
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Podcast Details</PageTitle>

<MudStack Spacing="3">

    <MudPaper Class="pa-4" Elevation="1">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <div>
                <MudText Typo="Typo.h4">@(_podcast?.Title ?? "Podcast")</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Podcast details
                </MudText>
            </div>

            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           Href="/podcasts">
                    Back
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Warning"
                           StartIcon="@Icons.Material.Filled.Edit"
                           Href="@($"/podcasts/{Id}/edit")">
                    Edit
                </MudButton>

                <MudButton Variant="Variant.Text"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.Delete"
                           OnClick="@(async () => await DeletePodcast(Id))">
                    Delete
                </MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>

    @if (_isLoading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error">
            @_errorMessage
        </MudAlert>
    }
    else if (_podcast is null)
    {
        <MudAlert Severity="Severity.Warning">
            Podcast not found.
        </MudAlert>
    }
    else
    {
        <MudGrid Spacing="3">

            <MudItem xs="12" md="7">
                <MudStack Spacing="3">
                    <MudPaper Class="pa-4" Elevation="1">
                        <MudText Typo="Typo.h6" Class="mb-3">Podcast Info</MudText>

                        <MudGrid Spacing="2">
                            <MudItem xs="12">
                                <div class="detail-box">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Title</MudText>
                                    <MudText Typo="Typo.body1">@_podcast.Title</MudText>
                                </div>
                            </MudItem>

                            <MudItem xs="12">
                                <div class="detail-box description-box">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Description</MudText>
                                    <MudText Typo="Typo.body1">
                                        @(string.IsNullOrWhiteSpace(_podcast.Description) ? "-" : _podcast.Description)
                                    </MudText>
                                </div>
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <div class="detail-box">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Category</MudText>
                                    <MudText Typo="Typo.body1">@(_podcast.CategoryName ?? "-")</MudText>
                                </div>
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <div class="detail-box">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Language</MudText>
                                    <MudText Typo="Typo.body1">@(_podcast.LanguageName ?? "-")</MudText>
                                </div>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>

                    <PodcastSeasonsPanel Seasons="_podcast.Seasons"
                    CreateEpisodeHref="@($"/podcasts/{Id}/create-episode")" />
                </MudStack>
            </MudItem>

            <MudItem xs="12" md="5">
                <ContributionDisplay Title="Contributors"
                EmptyText="No contributors registered."
                Contributions="_contributionItems" />
            </MudItem>

        </MudGrid>
    }

</MudStack>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private PodcastDetailsDto? _podcast;
    private bool _isLoading = true;
    private string? _errorMessage;
    private List<ContributionDisplay.ContributionListItem> _contributionItems = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _podcast = await Http.GetFromJsonAsync<PodcastDetailsDto>($"api/podcasts/podcast/{Id}");

            _contributionItems = _podcast?.Contributions
                .Where(c => c.ContributorId != Guid.Empty)
                .GroupBy(c => new
                {
                    c.ContributorId,
                    c.ContributorName
                })
                .Select(g => new ContributionDisplay.ContributionListItem
                {
                    ContributorId = g.Key.ContributorId,
                    ContributorName = g.Key.ContributorName ?? "",
                    Roles = g
                        .Where(x => x.ContributorRoleId != Guid.Empty)
                        .Select(x => new ContributionDisplay.ContributionListRole
                        {
                            Id = x.ContributorRoleId,
                            Name = x.ContributorRoleName ?? ""
                        })
                        .ToList()
                })
                .ToList() ?? new();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Could not load podcast: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task DeletePodcast(Guid id)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/podcasts/podcast/{id}");

            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/podcasts");
                return;
            }

            _errorMessage = $"Could not delete podcast. Status code: {(int)response.StatusCode}";
        }
        catch (Exception ex)
        {
            _errorMessage = $"Could not delete podcast: {ex.Message}";
        }
    }

    public class PodcastDetailsDto
    {
        public Guid Id { get; set; }
        public string? Title { get; set; }
        public string? Description { get; set; }

        public Guid CategoryId { get; set; }
        public string? CategoryName { get; set; }

        public Guid LanguageId { get; set; }
        public string? LanguageName { get; set; }

        public List<ContributionDto> Contributions { get; set; } = new();

        public List<PodcastSeasonsPanel.SeasonDto> Seasons { get; set; } = new();
    }

    public class ContributionDto
    {
        public Guid Id { get; set; }
        public Guid ContributorId { get; set; }
        public string? ContributorName { get; set; }
        public Guid ContributorRoleId { get; set; }
        public string? ContributorRoleName { get; set; }
        public bool HasRights { get; set; }
    }
}