@page "/podcasts"
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Podcast Catalog</PageTitle>

<MudStack Spacing="3">

    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.h4">Podcast Catalog</MudText>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Warning"
                   StartIcon="@Icons.Material.Filled.Add"
                   Href="/create-podcast">
            Create Podcast
        </MudButton>
    </MudStack>

    <!-- Filter panel -->
    <MudPaper Class="pa-4" Elevation="2" Style="border: 0.5px solid var(--mud-palette-divider);">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3" Spacing="2">
            <MudIcon Icon="@Icons.Material.Outlined.FilterAlt" Size="Size.Small" />
            <MudText Typo="Typo.body2" Color="Color.Secondary">Filters</MudText>
            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined"
                     Style="height: 20px; font-size: 11px; font-weight: 500; letter-spacing: 0.04em;">
                ACTIVE
            </MudChip>
        </MudStack>

        <MudGrid Spacing="2">
            <MudItem xs="12" md="11">
                <MudTextField @bind-Value="_searchString"
                              Label="Search"
                              Placeholder="Search title..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Clearable="true"
                              FullWidth="true" />
            </MudItem>

            <MudItem xs="12" md="1" Class="d-flex align-end">
                <MudTooltip Text="Clear all filters">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Outlined.FilterAltOff"
                               Size="Size.Medium"
                               FullWidth="true"
                               OnClick="@(() => _searchString = string.Empty)">
                        Clear
                    </MudButton>
                </MudTooltip>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (isLoading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
    }
    else if (_podcasts == null || !_podcasts.Any())
    {
        <MudAlert Severity="Severity.Info">No podcasts found.</MudAlert>
    }
    else
    {
        <MudPaper Class="pa-4" Elevation="5">
            <MudTable Items="FilteredPodcasts"
                      T="PodcastDto"
                      Hover="true"
                      Dense="true"
                      Elevation="0"
                      OnRowClick="@(args => OnRowClicked(args))">

                <HeaderContent>
                    <MudTh Style="width:72px"></MudTh>
                    <MudTh>Title</MudTh>
                    <MudTh>Host</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>

                <RowTemplate>
                    <MudTd DataLabel="Cover">
                        <MudImage Src="/images/PodcastMissingCover.png"
                                  Width="72"
                                  Height="72"
                                  ObjectFit="ObjectFit.Cover"
                                  Class="rounded" />
                    </MudTd>

                    <MudTd DataLabel="Title">
                        <MudText Typo="Typo.subtitle2">@context.Title</MudText>
                    </MudTd>
                    <MudTd DataLabel="Title">
                        <MudText Typo="Typo.subtitle2">@context.Id</MudText> @* //skift mig *@
                    </MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Warning"
                                       Size="Size.Small"
                                       Title="Edit podcast"
                                       OnClick="@(() => GoToEdit(context.Id))" />

                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       Title="Delete podcast"
                                       OnClick="@(async () => await DeletePodcast(context.Id))" />
                    </MudTd>
                </RowTemplate>

            </MudTable>
        </MudPaper>
    }

</MudStack>

@code {
    private List<PodcastDto> _podcasts = new();
    private bool isLoading = true;
    private string? errorMessage;
    private string _searchString = string.Empty;

    private IEnumerable<PodcastDto> FilteredPodcasts =>
        _podcasts.Where(p =>
            string.IsNullOrWhiteSpace(_searchString) ||
            (p.Title?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _podcasts = await Http.GetFromJsonAsync<List<PodcastDto>>("api/podcasts/podcast")
                         ?? new List<PodcastDto>();
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not fetch podcasts: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnRowClicked(TableRowClickEventArgs<PodcastDto> args)
    {
        if (args.Item is not null)
        {
            Navigation.NavigateTo($"/podcasts/{args.Item.Id}");
        }
    }

    private void GoToEdit(Guid id)
    {
        Navigation.NavigateTo($"/podcasts/edit/{id}");
    }
    private async Task DeletePodcast(Guid id)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/podcasts/podcast/{id}");

            if (response.IsSuccessStatusCode)
            {
                var trackToRemove = _podcasts.FirstOrDefault(t => t.Id == id);
                if (trackToRemove is not null)
                {
                    _podcasts.Remove(trackToRemove);
                }
            }
            else
            {
                errorMessage = $"Could not delete podcast. Status code: {(int)response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not delete podcast: {ex.Message}";
        }
    }



    public class PodcastDto
    {
        public Guid Id { get; set; }
        public string? Title { get; set; }
    }
}