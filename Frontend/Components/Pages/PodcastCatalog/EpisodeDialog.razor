@using MudBlazor
@using Microsoft.AspNetCore.Components.Forms

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField Label="Title"
                          @bind-Value="_model.Title"
                          Variant="Variant.Outlined"
                          Required="true"
                          FullWidth />

            <MudTextField Label="Description"
                          @bind-Value="_model.Description"
                          Variant="Variant.Outlined"
                          Lines="4"
                          FullWidth />

            <MudDatePicker Label="Airing date"
                           @bind-Date="_airingDate"
                           Variant="Variant.Outlined"
                           Required="true"
                           FullWidth />

            <MudTextField Label="Episode tag"
                          @bind-Value="_model.TagName"
                          Variant="Variant.Outlined"
                          FullWidth />

            <MudFileUpload T="IBrowserFile"
                           FilesChanged="OnAudioSelected"
                           Accept=".mp3,.wav,.m4a,.aac,.flac">
                <ActivatorContent>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Warning"
                               StartIcon="@Icons.Material.Filled.AudioFile">
                        Upload audio file
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>

            @if (_audioFile is not null)
            {
                <MudAlert Severity="Severity.Info" Dense="true">
                    Selected file: @_audioFile.Name
                </MudAlert>
            }

            <MudPaper Class="pa-4" Outlined="true">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                    <div>
                        <MudText Typo="Typo.h6">Contributions</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Add hosts, guests, producers or other contributors.
                        </MudText>
                    </div>

                    <MudButton Variant="Variant.Text"
                               Color="Color.Warning"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="AddContributionRow">
                        Add contributor
                    </MudButton>
                </MudStack>

                @if (!_contributionRows.Any())
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        No contributors added yet.
                    </MudAlert>
                }
                else
                {
                    <MudStack Spacing="2">
                        @foreach (var contribution in _contributionRows.Select((value, index) => new { value, index }))
                        {
                            <MudPaper Outlined="true" Class="pa-3">
                                <MudGrid Spacing="2">
                                    <MudItem xs="12" sm="5">
                                        <MudAutocomplete T="ContributorLookup"
                                                         Label="Contributor"
                                                         Variant="Variant.Outlined"
                                                         Value="Contributors.FirstOrDefault(c => c.Id == contribution.value.ContributorId)"
                                                         ValueChanged="@(v => OnContributorSelected(v, contribution.value))"
                                                         SearchFunc="SearchContributors"
                                                         ToStringFunc="@(c => c?.DisplayName ?? string.Empty)"
                                                         Clearable="true"
                                                         Dense="true"
                                                         FullWidth="true"
                                                         MaxItems="8" />
                                    </MudItem>

                                    <MudItem xs="12" sm="5">
                                        <MudSelect T="Guid?"
                                                   Label="Role"
                                                   Value="contribution.value.ContributorRoleId"
                                                   ValueChanged="@(v => contribution.value.ContributorRoleId = v)"
                                                   Variant="Variant.Outlined"
                                                   Dense="true"
                                                   FullWidth="true">
                                            @foreach (var role in ContributionRoles)
                                            {
                                                <MudSelectItem T="Guid?" Value="@role.Id">
                                                    @role.Name
                                                </MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>

                                    <MudItem xs="12" sm="2" Class="d-flex align-center">
                                        <MudButton Variant="Variant.Text"
                                                   Color="Color.Error"
                                                   StartIcon="@Icons.Material.Filled.Delete"
                                                   OnClick="@(() => RemoveContributionRow(contribution.index))">
                                            Remove
                                        </MudButton>
                                    </MudItem>
                                </MudGrid>
                            </MudPaper>
                        }
                    </MudStack>
                }
            </MudPaper>

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Dense="true">
                    @_errorMessage
                </MudAlert>
            }
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text"
                   Color="Color.Default"
                   OnClick="Cancel">
            Cancel
        </MudButton>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Warning"
                   OnClick="Submit">
            Add episode
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public List<ContributorLookup> Contributors { get; set; } = [];
    [Parameter] public List<ContributionRoleLookup> ContributionRoles { get; set; } = [];

    private EpisodeDialogResult _model = new();
    private DateTime? _airingDate = DateTime.Today;
    private IBrowserFile? _audioFile;
    private string? _errorMessage;
    private List<ContributionRow> _contributionRows = [];

    private void OnAudioSelected(IBrowserFile file)
    {
        _audioFile = file;
        _model.AudioFileName = file.Name;
        _model.AudioFileSize = file.Size;
        _model.AudioContentType = file.ContentType;
    }

    private Task<IEnumerable<ContributorLookup>> SearchContributors(string value, CancellationToken token)
    {
        IEnumerable<ContributorLookup> result = string.IsNullOrWhiteSpace(value)
            ? Contributors
            : Contributors.Where(c =>
                c.DisplayName.Contains(value, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(result);
    }

    private void OnContributorSelected(ContributorLookup? contributor, ContributionRow row)
    {
        row.ContributorId = contributor?.Id;
    }

    private void AddContributionRow() => _contributionRows.Add(new ContributionRow());

    private void RemoveContributionRow(int index)
    {
        if (index >= 0 && index < _contributionRows.Count)
            _contributionRows.RemoveAt(index);
    }

    private void Submit()
    {
        _errorMessage = null;

        if (string.IsNullOrWhiteSpace(_model.Title))
        {
            _errorMessage = "Title is required.";
            return;
        }

        if (_airingDate is null)
        {
            _errorMessage = "Airing date is required.";
            return;
        }

        if (_contributionRows.Any(r =>
                r.ContributorId is null || r.ContributorId == Guid.Empty ||
                r.ContributorRoleId is null || r.ContributorRoleId == Guid.Empty))
        {
            _errorMessage = "All contributions must have a contributor and a role selected.";
            return;
        }

        _model.AiringDate = DateOnly.FromDateTime(_airingDate.Value);
        _model.Duration = TimeSpan.Zero;
        _model.Contributions = _contributionRows;

        MudDialog.Close(DialogResult.Ok(_model));
    }

    private void Cancel() => MudDialog.Cancel();

    public class ContributorLookup
    {
        public Guid Id { get; set; }
        public string DisplayName { get; set; } = "";
    }

    public class ContributionRoleLookup
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
    }

    public class ContributionRow
    {
        public Guid? ContributorId { get; set; }
        public Guid? ContributorRoleId { get; set; }
    }

    public class EpisodeDialogResult
    {
        public string Title { get; set; } = "";
        public string? Description { get; set; }
        public TimeSpan Duration { get; set; } = TimeSpan.Zero;
        public DateOnly AiringDate { get; set; }
        public Guid? TagId { get; set; }
        public string? TagName { get; set; }
        public string? AudioFileName { get; set; }
        public long? AudioFileSize { get; set; }
        public string? AudioContentType { get; set; }
        public List<ContributionRow> Contributions { get; set; } = [];
    }
}