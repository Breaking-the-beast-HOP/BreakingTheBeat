@page "/podcasts/{Id:guid}/edit"
@rendermode InteractiveServer

@using MudBlazor
@inject HttpClient Http
@inject IDialogService DialogService

<PageTitle>Edit Podcast</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-6">
    <MudStack Spacing="4">

        <MudPaper Class="pa-4">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h4">Edit Podcast</MudText>

                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Text"
                               Color="Color.Default"
                               Href="@($"/podcasts/{Id}")">
                        Cancel
                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Warning"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="SavePodcast"
                               Disabled="_isSaving || _isLoading">
                        @(_isSaving ? "Saving..." : "Save changes")
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>

        @if (_isLoading)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
            }

            @if (!string.IsNullOrWhiteSpace(_successMessage))
            {
                <MudAlert Severity="Severity.Success">@_successMessage</MudAlert>
            }

            <MudGrid Spacing="3">
                <MudItem xs="12" md="7">
                    <MudStack Spacing="3">

                        <MudPaper Class="pa-4" Elevation="5">
                            <MudText Typo="Typo.h6" Class="mb-3">Podcast Info</MudText>

                            <MudGrid Spacing="2">
                                <MudItem xs="12">
                                    <MudTextField Label="Title"
                                                  @bind-Value="_model.Title"
                                                  Variant="Variant.Outlined"
                                                  Required="true"
                                                  FullWidth="true" />
                                </MudItem>

                                <MudItem xs="12">
                                    <MudTextField Label="Description"
                                                  @bind-Value="_model.Description"
                                                  Variant="Variant.Outlined"
                                                  Lines="5"
                                                  FullWidth="true" />
                                </MudItem>

                                <MudItem xs="12" sm="6">
                                    <MudAutocomplete T="PodcastCategoryDto"
                                                     Label="Category"
                                                     Variant="Variant.Outlined"
                                                     Value="_selectedCategory"
                                                     ValueChanged="OnCategoryChanged"
                                                     SearchFunc="SearchCategories"
                                                     ToStringFunc="@(c => c?.Name ?? string.Empty)"
                                                     Clearable="true"
                                                     ResetValueOnEmptyText="true"
                                                     CoerceText="false"
                                                     Dense="true"
                                                     FullWidth="true"
                                                     MaxItems="8" />
                                </MudItem>

                                <MudItem xs="12" sm="6">
                                    <MudAutocomplete T="LanguageDto"
                                                     Label="Language"
                                                     Variant="Variant.Outlined"
                                                     Value="_selectedLanguage"
                                                     ValueChanged="OnLanguageChanged"
                                                     SearchFunc="SearchLanguages"
                                                     ToStringFunc="@(l => l?.Name ?? string.Empty)"
                                                     OpenOnFocus="true"
                                                     MinCharacters="0"
                                                     Dense="true"
                                                     FullWidth="true"
                                                     MaxItems="8" />
                                </MudItem>
                            </MudGrid>
                        </MudPaper>

                        <MudPaper Class="pa-4" Elevation="5">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                                <div>
                                    <MudText Typo="Typo.h6">Contributions</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        Add hosts, guests, producers, editors, or other contributors.
                                    </MudText>
                                </div>

                                <MudButton Variant="Variant.Text"
                                           Color="Color.Warning"
                                           StartIcon="@Icons.Material.Filled.Add"
                                           OnClick="AddContributionRow">
                                    Add contributor
                                </MudButton>
                            </MudStack>

                            @if (!_contributions.Any())
                            {
                                <MudAlert Severity="Severity.Info" Dense="true">
                                    No contributors added yet.
                                </MudAlert>
                            }
                            else
                            {
                                <MudStack Spacing="2">
                                    @foreach (var contribution in _contributions.Select((value, index) => new { value, index }))
                                    {
                                        <MudPaper Outlined="true" Class="pa-3">
                                            <MudGrid Spacing="2">
                                                <MudItem xs="12" sm="5">
                                                    <MudAutocomplete T="Contributor"
                                                                     Label="Contributor"
                                                                     Variant="Variant.Outlined"
                                                                     Value="_contributors.FirstOrDefault(c => c.Id == contribution.value.ContributorId)"
                                                                     ValueChanged="@(value => OnContributionChanged(value, contribution.value))"
                                                                     SearchFunc="SearchContributors"
                                                                     ToStringFunc="@(c => c?.Name ?? string.Empty)"
                                                                     Clearable="true"
                                                                     ResetValueOnEmptyText="true"
                                                                     CoerceText="false"
                                                                     Dense="true"
                                                                     FullWidth="true"
                                                                     MaxItems="8"
                                                                     ItemDisabledFunc="@(c => UsedContributorIds.Contains(c.Id)
                                                                                                                                                                                                                     && c.Id != contribution.value.ContributorId)" />
                                                </MudItem>

                                                <MudItem xs="12" sm="5">
                                                    <MudSelect T="Guid?"
                                                               Label="Role"
                                                               Value="contribution.value.ContributorRoleId"
                                                               ValueChanged="@(value => OnRoleChanged(value, contribution.value))"
                                                               Variant="Variant.Outlined"
                                                               FullWidth="true">
                                                        @foreach (var role in _contributionRoles)
                                                        {
                                                            <MudSelectItem T="Guid?" Value="@role.Id">
                                                                @role.Name
                                                            </MudSelectItem>
                                                        }
                                                    </MudSelect>
                                                </MudItem>

                                                <MudItem xs="12" sm="2" Class="d-flex align-center">
                                                    <MudButton Variant="Variant.Text"
                                                               Color="Color.Error"
                                                               StartIcon="@Icons.Material.Filled.Delete"
                                                               OnClick="@(() => RemoveContributionRow(contribution.index))">
                                                        Remove
                                                    </MudButton>
                                                </MudItem>
                                            </MudGrid>
                                        </MudPaper>
                                    }
                                </MudStack>
                            }
                        </MudPaper>

                    </MudStack>
                </MudItem>

                <MudItem xs="12" md="5">
                    <MudStack Spacing="3">
                        <MudPaper Class="pa-4" Elevation="5">
                            <MudText Typo="Typo.h6" Class="mb-3">Podcast Cover</MudText>

                            <MudPaper Class="dropzone pa-6" Outlined="true">
                                <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="2">
                                    <MudIcon Icon="@Icons.Material.Filled.Image"
                                             Size="Size.Large"
                                             Color="Color.Warning" />

                                    <MudText Typo="Typo.subtitle1">Cover drop zone</MudText>

                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        Cover upload comes later
                                    </MudText>
                                </MudStack>
                            </MudPaper>
                        </MudPaper>
                    </MudStack>
                </MudItem>
            </MudGrid>

            <PodcastSeasonEditor Seasons="_seasons"
                                 IsLoading="_isLoadingSeasons"
                                 AddSeasonRequested="AddSeason"
                                 RemoveSeasonRequested="RemoveSeason"
                                 AddEpisodeRequested="AddEpisode"
                                 RemoveEpisodeRequested="RemoveEpisode" />
        }

    </MudStack>
</MudContainer>

 @code {
        [Parameter]
        public Guid Id { get; set; }

        private PodcastModel _model = new();

        private List<LanguageDto> _languages = [];
        private List<PodcastCategoryDto> _categories = [];
        private List<ContributionRoles> _contributionRoles = [];
        private List<Contributor> _contributors = [];
        private List<ContributionRow> _contributions = [];

        private List<PodcastSeasonEditor.SeasonDto> _seasons = [];

        private LanguageDto? _selectedLanguage;
        private PodcastCategoryDto? _selectedCategory;

        private bool _isLoading = true;
        private bool _isLoadingSeasons;
        private bool _isSaving;

        private string? _errorMessage;
        private string? _successMessage;

        private HashSet<Guid> UsedContributorIds =>
            _contributions
                .Where(c => c.ContributorId.HasValue)
                .Select(c => c.ContributorId!.Value)
                .ToHashSet();

        protected override async Task OnInitializedAsync()
        {
            try
            {
                await LoadLookups();
                await LoadPodcast();
                await LoadSeasons();
            }
            catch (Exception ex)
            {
                _errorMessage = $"Could not load podcast: {ex.Message}";
            }
            finally
            {
                _isLoading = false;
            }
        }

        private async Task LoadLookups()
        {
            var languagesTask = Http.GetFromJsonAsync<List<LanguageDto>>("api/podcasts/language");
            var categoriesTask = Http.GetFromJsonAsync<List<PodcastCategoryDto>>("api/podcasts/category");
            // var rolesTask = Http.GetFromJsonAsync<List<ContributionRoles>>("api/podcasts/contributorrole");
            // var contributorsTask = Http.GetFromJsonAsync<List<Contributor>>("api/podcasts/contributor");

            await Task.WhenAll(languagesTask, categoriesTask/* , rolesTask, contributorsTask */);

            _languages = languagesTask.Result ?? [];
            _categories = categoriesTask.Result ?? [];
            // _contributionRoles = rolesTask.Result ?? [];
            // _contributors = contributorsTask.Result ?? [];
        }

        private async Task LoadPodcast()
        {
            var podcast = await Http.GetFromJsonAsync<PodcastDetailsDto>(
                $"api/podcasts/podcast/{Id}");

            if (podcast is null)
            {
                _errorMessage = "Podcast not found.";
                return;
            }

            _model = new PodcastModel
            {
                Title = podcast.Title,
                Description = podcast.Description,
                CategoryId = podcast.CategoryId,
                LanguageId = podcast.LanguageId
            };

            _selectedCategory = _categories.FirstOrDefault(c => c.Id == podcast.CategoryId);

            if (_selectedCategory is null && !string.IsNullOrWhiteSpace(podcast.CategoryName))
            {
                _selectedCategory = new PodcastCategoryDto
                {
                    Id = podcast.CategoryId,
                    Name = podcast.CategoryName
                };

                _categories.Add(_selectedCategory);
            }

            _selectedLanguage = _languages.FirstOrDefault(l => l.Id == podcast.LanguageId);

            if (_selectedLanguage is null && !string.IsNullOrWhiteSpace(podcast.LanguageName))
            {
                _selectedLanguage = new LanguageDto
                {
                    Id = podcast.LanguageId,
                    Name = podcast.LanguageName,
                    ISO = ""
                };

                _languages.Add(_selectedLanguage);
            }

            _contributions = podcast.Contributions
                .Select(c => new ContributionRow
                {
                    Id = c.Id,
                    ContributorId = c.ContributorId,
                    ContributorName = c.ContributorName,
                    ContributorRoleId = c.ContributorRoleId,
                    HasRights = c.HasRights
                })
                .ToList();
        }

        private async Task LoadSeasons()
        {
            _isLoadingSeasons = true;

            try
            {
                _seasons = await Http.GetFromJsonAsync<List<PodcastSeasonEditor.SeasonDto>>(
                    $"api/podcasts/season/by-podcast/{Id}") ?? [];
            }
            catch
            {
                _seasons = [];
            }
            finally
            {
                _isLoadingSeasons = false;
            }
        }

        private void AddSeason()
        {
            var nextSeasonNumber = _seasons.Any()
                ? _seasons.Max(s => s.SeasonNumber) + 1
                : 1;

            _seasons.Add(new PodcastSeasonEditor.SeasonDto
            {
                Id = Guid.NewGuid(),
                SeasonNumber = nextSeasonNumber,
                Title = $"Season {nextSeasonNumber}",
                Episodes = []
            });
        }

        private void RemoveSeason(PodcastSeasonEditor.SeasonDto season)
        {
            _seasons.Remove(season);

            for (var i = 0; i < _seasons.Count; i++)
            {
                _seasons[i].SeasonNumber = i + 1;
            }
        }

    private async Task AddEpisode(PodcastSeasonEditor.SeasonDto season)
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseButton = true
        };

        var dialog = await DialogService.ShowAsync<EpisodeDialog>(
            "Add Episode",
            new DialogParameters(),
            options);

        var result = await dialog.Result;

        if (result is null || result.Canceled)
            return;

        if (result.Data is not EpisodeDialog.EpisodeDialogResult episode)
            return;

        season.Episodes.Add(new PodcastSeasonEditor.EpisodeDto
        {
            Id = Guid.NewGuid(),
            Title = episode.Title,
            Description = episode.Description,
            Duration = episode.Duration,
            AiringDate = episode.AiringDate,
            TagId = episode.TagId,
            TagName = episode.TagName
        });
    }

        private void RemoveEpisode(PodcastSeasonEditor.EpisodeDto episode)
        {
            var season = _seasons.FirstOrDefault(s =>
                s.Episodes.Any(e => e.Id == episode.Id));

            if (season is null)
                return;

            season.Episodes.Remove(episode);
        }

        private Task<IEnumerable<PodcastCategoryDto>> SearchCategories(
            string value,
            CancellationToken token)
        {
            var result = string.IsNullOrWhiteSpace(value)
                ? _categories
                : _categories.Where(c =>
                    c.Name.Contains(value, StringComparison.OrdinalIgnoreCase));

            return Task.FromResult(result.AsEnumerable());
        }

        private Task<IEnumerable<LanguageDto>> SearchLanguages(
            string value,
            CancellationToken token)
        {
            var result = string.IsNullOrWhiteSpace(value)
                ? _languages
                : _languages.Where(l =>
                    l.Name.Contains(value, StringComparison.OrdinalIgnoreCase) ||
                    l.ISO.Contains(value, StringComparison.OrdinalIgnoreCase));

            return Task.FromResult(result.AsEnumerable());
        }

        private Task<IEnumerable<Contributor>> SearchContributors(
            string value,
            CancellationToken token)
        {
            var result = string.IsNullOrWhiteSpace(value)
                ? _contributors
                : _contributors.Where(c =>
                    c.Name.Contains(value, StringComparison.OrdinalIgnoreCase));

            return Task.FromResult(result.AsEnumerable());
        }

        private Task OnCategoryChanged(PodcastCategoryDto? category)
        {
            _selectedCategory = category;
            _model.CategoryId = category?.Id;
            return Task.CompletedTask;
        }

        private Task OnLanguageChanged(LanguageDto? language)
        {
            _selectedLanguage = language;
            _model.LanguageId = language?.Id;
            return Task.CompletedTask;
        }

        private Task OnContributionChanged(Contributor? contributor, ContributionRow row)
        {
            row.ContributorId = contributor?.Id;
            row.ContributorName = contributor?.Name;
            return Task.CompletedTask;
        }

        private Task OnRoleChanged(Guid? roleId, ContributionRow row)
        {
            row.ContributorRoleId = roleId;
            return Task.CompletedTask;
        }

        private void AddContributionRow()
        {
            _contributions.Add(new ContributionRow());
        }

        private void RemoveContributionRow(int index)
        {
            if (index >= 0 && index < _contributions.Count)
            {
                _contributions.RemoveAt(index);
            }
        }

        private async Task SavePodcast()
        {
            _errorMessage = null;
            _successMessage = null;

            if (string.IsNullOrWhiteSpace(_model.Title))
            {
                _errorMessage = "Title is required.";
                return;
            }

            if (_model.CategoryId is null || _model.CategoryId == Guid.Empty)
            {
                _errorMessage = "Category is required.";
                return;
            }

            if (_model.LanguageId is null || _model.LanguageId == Guid.Empty)
            {
                _errorMessage = "Language is required.";
                return;
            }

            if (!_contributions.Any())
            {
                _errorMessage = "At least one contribution is required.";
                return;
            }

            if (_contributions.Any(c =>
                    c.ContributorId is null ||
                    c.ContributorId == Guid.Empty ||
                    c.ContributorRoleId is null ||
                    c.ContributorRoleId == Guid.Empty))
            {
                _errorMessage = "All contributions must have a contributor and a role selected.";
                return;
            }

            _model.Contributions = _contributions
                .Select(r => new ContributionDto
                {
                    Id = r.Id,
                    ContributorId = r.ContributorId!.Value,
                    ContributorRoleId = r.ContributorRoleId!.Value,
                    ContributorName = r.ContributorName,
                    HasRights = r.HasRights
                })
                .ToList();

            try
            {
                _isSaving = true;

                var response = await Http.PutAsJsonAsync(
                    $"api/podcasts/podcast/{Id}",
                    _model);

                if (response.IsSuccessStatusCode)
                {
                    _successMessage = "Podcast updated successfully.";
                    return;
                }

                var error = await response.Content.ReadAsStringAsync();

                _errorMessage = string.IsNullOrWhiteSpace(error)
                    ? "Failed to update podcast."
                    : error;
            }
            catch (Exception ex)
            {
                _errorMessage = $"An error occurred while saving: {ex.Message}";
            }
            finally
            {
                _isSaving = false;
            }
        }

        public class PodcastModel
        {
            public string? Title { get; set; }
            public string? Description { get; set; }
            public Guid? CategoryId { get; set; }
            public Guid? LanguageId { get; set; }
            public List<ContributionDto> Contributions { get; set; } = [];
        }

        public class PodcastDetailsDto
        {
            public Guid Id { get; set; }
            public string? Title { get; set; }
            public string? Description { get; set; }

            public Guid CategoryId { get; set; }
            public string? CategoryName { get; set; }

            public Guid LanguageId { get; set; }
            public string? LanguageName { get; set; }

            public List<ContributionDto> Contributions { get; set; } = [];
        }

        public class ContributionDto
        {
            public Guid? Id { get; set; }
            public Guid ContributorId { get; set; }
            public string? ContributorName { get; set; }
            public Guid ContributorRoleId { get; set; }
            public bool HasRights { get; set; }
        }

        public class ContributionRow
        {
            public Guid? Id { get; set; }
            public Guid? ContributorId { get; set; }
            public string? ContributorName { get; set; }
            public Guid? ContributorRoleId { get; set; }
            public bool HasRights { get; set; }
        }

        public class ContributionRoles
        {
            public Guid Id { get; set; }
            public string Name { get; set; } = "";
            public string Description { get; set; } = "";
        }

        public class Contributor
        {
            public Guid Id { get; set; }
            public string Name { get; set; } = "";
            public string? Description { get; set; }
        }

        public class LanguageDto
        {
            public Guid Id { get; set; }
            public string Name { get; set; } = "";
            public string ISO { get; set; } = "";
        }

        public class PodcastCategoryDto
        {
            public Guid Id { get; set; }
            public string Name { get; set; } = "";
        }
    }