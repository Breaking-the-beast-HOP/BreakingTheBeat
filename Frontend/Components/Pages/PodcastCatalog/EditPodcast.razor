@page "/podcasts/{Id:guid}/edit"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Quality controller,Admin,Content creator")]

@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using Frontend.Components.Shared
@using Frontend.Components.Pages.PodcastCatalog
@using Microsoft.AspNetCore.Components.Web

@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Edit Podcast</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-6">
    <MudStack Spacing="4">

        <MudPaper Class="pa-4" Elevation="5">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <div>
                    <MudText Typo="Typo.h4">Edit Podcast</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Edit podcast metadata and contributors.
                    </MudText>
                </div>

                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Text" Href="@($"/podcasts/{Id}")">
                        Cancel
                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Warning"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="SavePodcast"
                               Disabled="@(_isSaving || _isLoading)">
                        @(_isSaving ? "Saving..." : "Save")
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudAlert Severity="Severity.Error">
                @_errorMessage
            </MudAlert>
        }

        @if (_isLoading)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else
        {
            <MudGrid Spacing="3">
                <MudItem xs="12" md="7">
                    <MudStack Spacing="3">

                        <MudPaper Class="pa-4" Elevation="5">
                            <MudText Typo="Typo.h6" Class="mb-3">
                                Podcast Info
                            </MudText>

                            <MudGrid Spacing="2">
                                <MudItem xs="12">
                                    <MudTextField @bind-Value="_model.Title"
                                                  Label="Title"
                                                  Required="true"
                                                  Variant="Variant.Outlined"
                                                  FullWidth="true" />
                                </MudItem>

                                <MudItem xs="12">
                                    <MudTextField @bind-Value="_model.Description"
                                                  Label="Description"
                                                  Lines="5"
                                                  Variant="Variant.Outlined"
                                                  FullWidth="true" />
                                </MudItem>

                                <MudItem xs="12" sm="6">
                                    <MudAutocomplete T="PodcastCategoryDto"
                                                     Label="Category *"
                                                     Variant="Variant.Outlined"
                                                     Value="_selectedCategory"
                                                     ValueChanged="OnCategoryChanged"
                                                     SearchFunc="SearchCategories"
                                                     ToStringFunc="@(c => c?.Name ?? string.Empty)"
                                                     Clearable="true"
                                                     ResetValueOnEmptyText="true"
                                                     CoerceText="false"
                                                     Dense="true"
                                                     FullWidth="true"
                                                     MaxItems="8"
                                                     Disabled="_isLoading" />
                                </MudItem>

                                <MudItem xs="12" sm="6">
                                    <MudAutocomplete T="LanguageDto"
                                                     Label="Language *"
                                                     Variant="Variant.Outlined"
                                                     Value="_selectedLanguage"
                                                     ValueChanged="OnLanguageChanged"
                                                     SearchFunc="SearchLanguages"
                                                     ToStringFunc="@(l => l?.Name ?? string.Empty)"
                                                     Clearable="true"
                                                     ResetValueOnEmptyText="true"
                                                     CoerceText="false"
                                                     Dense="true"
                                                     FullWidth="true"
                                                     MaxItems="8"
                                                     Disabled="_isLoading" />
                                </MudItem>
                            </MudGrid>
                        </MudPaper>

                        <MudPaper Class="pa-4" Elevation="5">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                                <div>
                                    <MudText Typo="Typo.h6">Contributions</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        Add hosts, guests, producers, editors, or other contributors.
                                    </MudText>
                                </div>

                                <MudButton Variant="Variant.Text"
                                           Color="Color.Warning"
                                           StartIcon="@Icons.Material.Filled.Add"
                                           OnClick="AddContributionRow">
                                    Add contributor
                                </MudButton>
                            </MudStack>

                            @if (!_contributions.Any())
                            {
                                <MudAlert Severity="Severity.Info" Dense="true">
                                    No contributors added yet.
                                </MudAlert>
                            }
                            else
                            {
                                <MudStack Spacing="2">
                                    @foreach (var contribution in _contributions.Select((value, index) => new { value, index }))
                                    {
                                        <MudPaper Outlined="true" Class="pa-3">
                                            <MudGrid Spacing="2">
                                                <MudItem xs="12" sm="5">
                                                    <MudAutocomplete T="Contributor"
                                                                     Label="Contributor"
                                                                     Variant="Variant.Outlined"
                                                                     Value="_contributors.FirstOrDefault(c => c.Id == contribution.value.ContributorId)"
                                                                     ValueChanged="@(value => OnContributionChanged(value, contribution.value))"
                                                                     SearchFunc="SearchContributors"
                                                                     ToStringFunc="@(c => c?.Name ?? string.Empty)"
                                                                     Clearable="true"
                                                                     ResetValueOnEmptyText="true"
                                                                     CoerceText="false"
                                                                     Dense="true"
                                                                     FullWidth="true"
                                                                     MaxItems="8"
                                                                     Disabled="@IsContributorLocked(contribution.value, contribution.index)"
                                                                     ItemDisabledFunc="@(c => UsedContributorIds.Contains(c.Id)
                                                                                                                                                                 && c.Id != contribution.value.ContributorId)" />
                                    </MudItem>

                                                <MudItem xs="12" sm="5">
                                                    <MudSelect T="Guid?"
                                                               Label="Role"
                                                               Value="contribution.value.ContributorRoleId"
                                                               ValueChanged="@(async (Guid? value) => await OnRoleChanged(value, contribution.value))"
                                                               Variant="Variant.Outlined"
                                                               FullWidth="true">

                                            @foreach (var role in _contributionRoles)
                                                        {
                                                            <MudSelectItem T="Guid?" Value="@role.Id">
                                                                @role.Name
                                                            </MudSelectItem>
                                                        }

                                                    </MudSelect>
                                                </MudItem>

                                                <MudItem xs="12" sm="2" Class="d-flex align-center">
                                                    <MudButton Variant="Variant.Text"
                                                               Color="Color.Error"
                                                               StartIcon="@Icons.Material.Filled.Delete"
                                                               OnClick="@(() => RemoveContributionRow(contribution.index))">
                                                        Remove
                                                    </MudButton>
                                                </MudItem>
                                            </MudGrid>
                                        </MudPaper>
                                    }
                                </MudStack>
                            }
                        </MudPaper>

                    </MudStack>
                </MudItem>

                <MudItem xs="12" md="5">
                    <MudPaper Class="pa-4" Elevation="5">
                        <MudText Typo="Typo.h6" Class="mb-3">
                            Episodes
                        </MudText>

                        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                            Seasons and episodes are edited separately. Saving this page only updates podcast info and contributors.
                        </MudAlert>

                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Warning"
                                   StartIcon="@Icons.Material.Filled.LibraryMusic"
                                   Href="@($"/podcasts/{Id}")">
                            Manage episodes from details page
                        </MudButton>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        }

    </MudStack>
</MudContainer>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private bool _isLoading = true;
    private bool _isSaving;

    private string? _errorMessage;
    private string? _successMessage;

    private PodcastEditModel _model = new();

    private List<LanguageDto> _languages = new();
    private List<PodcastCategoryDto> _categories = new();

    private LanguageDto? _selectedLanguage;
    private PodcastCategoryDto? _selectedCategory;

    private List<Contributor> _contributors = new();
    private List<ContributionRoles> _contributionRoles = new();
    private List<ContributionRow> _contributions = new();

    private HashSet<Guid> UsedContributorIds =>
        _contributions
            .Where(c => c.ContributorId.HasValue)
            .Select(c => c.ContributorId!.Value)
            .ToHashSet();

    private bool IsContributorLocked(ContributionRow row, int index)
    {
        return row.ContributorId.HasValue;
    }

    protected override async Task OnInitializedAsync()
    {
        _categories = await Http.GetFromJsonAsync<List<PodcastCategoryDto>>("api/Podcasts/Category") ?? new();
        //_selectedCategory = _categories.FirstOrDefault(c => c.Id == podcast.CategoryId);

        _languages = await Http.GetFromJsonAsync<List<LanguageDto>>("api/podcasts/Language") ?? new();
        //_selectedLanguage = _languages.FirstOrDefault(l => l.Id == podcast.LanguageId);

        _contributionRoles = await Http.GetFromJsonAsync<List<ContributionRoles>>(
            "api/podcasts/ContributorRole") ?? new();

        _contributors = await Http.GetFromJsonAsync<List<Contributor>>(
            "api/podcasts/Contributor") ?? new();

        await LoadPodcast();
    }

    private async Task LoadPodcast()
    {
        try
        {
            _errorMessage = null;

            var podcast = await Http.GetFromJsonAsync<PodcastDetailsDto>($"api/podcasts/podcast/{Id}");

            if (podcast is null)
            {
                _errorMessage = "Podcast not found.";
                return;
            }

            _model = new PodcastEditModel
            {
                Title = podcast.Title ?? "",
                Description = podcast.Description,
                CategoryId = podcast.CategoryId,
                LanguageId = podcast.LanguageId
            };

            _contributions = podcast.Contributions?
                .Select(c => new ContributionRow
                {
                    Id = c.Id,
                    ContributorId = c.ContributorId,
                    ContributorName = c.ContributorName,
                    ContributorRoleId = c.ContributorRoleId,
                    HasRights = c.HasRights
                })
                .ToList() ?? new();

            //_categories = await Http.GetFromJsonAsync<List<PodcastCategoryDto>>("api/Podcasts/Category") ?? new();
            _selectedCategory = _categories.FirstOrDefault(c => c.Id == podcast.CategoryId);

            //_languages =await Http.GetFromJsonAsync<List<LanguageDto>>("api/podcasts/Language")?? new();
            _selectedLanguage = _languages.FirstOrDefault(l => l.Id == podcast.LanguageId);

            // _contributionRoles = await Http.GetFromJsonAsync<List<ContributionRoles>>(
            //     "api/podcasts/ContributorRole") ?? new();

            // _contributors = await Http.GetFromJsonAsync<List<Contributor>>(
            //     "api/podcasts/Contributor") ?? new();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Could not load podcast edit data: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }


    private Task<IEnumerable<PodcastCategoryDto>> SearchCategories(string value, CancellationToken token)
    {
        IEnumerable<PodcastCategoryDto> result = string.IsNullOrWhiteSpace(value)
            ? _categories
            : _categories.Where(c =>
                c.Name.Contains(value, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(result);
    }

    private Task<IEnumerable<LanguageDto>> SearchLanguages(string value, CancellationToken token)
    {
        IEnumerable<LanguageDto> result = string.IsNullOrWhiteSpace(value)
            ? _languages
            : _languages.Where(l =>
                l.Name.Contains(value, StringComparison.OrdinalIgnoreCase) ||
                l.ISO.Contains(value, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(result);
    }

    private Task<IEnumerable<Contributor>> SearchContributors(
        string value,
        CancellationToken token)
    {
        var query = _contributors.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(value))
        {
            query = query.Where(c =>
                c.Name.Contains(value, StringComparison.OrdinalIgnoreCase));
        }

        return Task.FromResult(query);
    }


    private Task OnCategoryChanged(PodcastCategoryDto? category)
    {
        _selectedCategory = category;
        _model.CategoryId = category?.Id ?? Guid.Empty;
        return Task.CompletedTask;
    }

    private Task OnLanguageChanged(LanguageDto? language)
    {
        _selectedLanguage = language;
        _model.LanguageId = language?.Id ?? Guid.Empty;
        return Task.CompletedTask;
    }

    private Task OnContributionChanged(
    Contributor? contributor,
    ContributionRow row)
    {
        if (row.ContributorId.HasValue)
            return Task.CompletedTask;
        row.ContributorId = contributor?.Id;
        row.ContributorName = contributor?.Name;

        return Task.CompletedTask;
    }


    private Task OnRoleChanged(Guid? roleId, ContributionRow row)
    {
        row.ContributorRoleId = roleId;

        return Task.CompletedTask;
    }

    private void AddContributionRow()
    {
        _contributions.Add(new ContributionRow());
    }

    private void RemoveContributionRow(int index)
    {
        if (index >= 0 && index < _contributions.Count)
            _contributions.RemoveAt(index);
    }

    private async Task SavePodcast()
    {
        _errorMessage = null;

        if (string.IsNullOrWhiteSpace(_model.Title))
        {
            _errorMessage = "Title is required.";
            return;
        }

        if (_model.CategoryId == Guid.Empty)
        {
            _errorMessage = "Category is required.";
            return;
        }

        if (_model.LanguageId == Guid.Empty)
        {
            _errorMessage = "Language is required.";
            return;
        }

        _model.Contributions = _contributions.Select(r => new ContributionDto
        {
            Id = r.Id,
            ContributorId = r.ContributorId ?? Guid.Empty,
            ContributorRoleId = r.ContributorRoleId ?? Guid.Empty,
            HasRights = r.HasRights,
            ContributorName = r.ContributorName
        }).ToList();



        if (!_model.Contributions.Any())
        {
            _errorMessage = "At least one contribution is required.";
            return;
        }

        if (_model.Contributions.Any(c => c.ContributorId == null || c.ContributorRoleId == null))
        {
            _errorMessage = "All contributions must have a contributor and a role selected.";
            return;
        }

        _isSaving = true;

        try
        {
            var request = new UpdatePodcastRequest
            {
                Title = _model.Title,
                Description = _model.Description,
                CategoryId = _model.CategoryId,
                LanguageId = _model.LanguageId,
                Contributions = _contributions
                    .Where(c => c.ContributorId.HasValue && c.ContributorId.Value != Guid.Empty)
                    .Select(c => new UpdatePodcastContributionRequest
                    {
                        ContributorId = c.ContributorId!.Value,
                        ContributorName = c.ContributorName ?? string.Empty, 
                        ContributorRoleId = c.ContributorRoleId!.Value 
                    })
                    .ToList()
                // Contributions = _contributions
                //     .Where(c => c.ContributorId.HasValue && c.ContributorId.Value != Guid.Empty)
                //     .Select(c => new UpdatePodcastContributionRequest
                //     {
                //         ContributorId = c.ContributorId!.Value,
                //         RoleIds = c.Roles
                //             .Where(r => r.RoleId != Guid.Empty)
                //             .Select(r => r.RoleId)
                //             .ToList()
                //     })
                //     .ToList()
            };

            //debugging step
            foreach (var c in request.Contributions)
                Console.WriteLine($"ContributionId: {c.Id}, ContributorId: {c.ContributorId}, ContributorRoleId: {c.ContributorRoleId}");

            var response = await Http.PutAsJsonAsync(
                $"api/podcasts/podcast/{Id}",
                request);

            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo($"/podcasts/{Id}");
                return;
            }

            var error = await response.Content.ReadAsStringAsync();

            _errorMessage = string.IsNullOrWhiteSpace(error)
                ? $"Could not save podcast. Status code: {(int)response.StatusCode}"
                : error;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Could not save podcast: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }


    private class PodcastEditModel
    {
        public string Title { get; set; } = "";
        public string? Description { get; set; }
        public Guid CategoryId { get; set; }
        public Guid LanguageId { get; set; }

        public List<ContributionDto> Contributions { get; set; } = new();
    }

    public class UpdatePodcastRequest
    {
        public string Title { get; set; } = "";
        public string? Description { get; set; }
        public Guid CategoryId { get; set; }
        public Guid LanguageId { get; set; }
        public List<UpdatePodcastContributionRequest> Contributions { get; set; } = new();
    }


    public class UpdatePodcastContributionRequest
    {
        public Guid? Id { get; set; }
        public Guid ContributorId { get; set; }
        public string ContributorName { get; set; } = string.Empty;
        public Guid ContributorRoleId { get; set; }
    }

    public class PodcastDetailsDto
    {
        public Guid Id { get; set; }
        public string? Title { get; set; }
        public string? Description { get; set; }

        public Guid CategoryId { get; set; }
        public string? CategoryName { get; set; }

        public Guid LanguageId { get; set; }
        public string? LanguageName { get; set; }

        public List<ContributionDto> Contributions { get; set; } = new();
        public List<PodcastSeasonsPanel.SeasonDto> Seasons { get; set; } = new();
    }

    public class ContributionDto
    {
        public Guid? Id { get; set; }
        public Guid ContributorId { get; set; }
        public string? ContributorName { get; set; }
        public Guid ContributorRoleId { get; set; }
        public bool HasRights { get; set; }
    }
    

    public class ContributionRow
    {
        public Guid? Id { get; set; }
        public Guid? ContributorId { get; set; }
        public string? ContributorName { get; set; }

        public Guid? ContributorRoleId { get; set; }
        public bool HasRights { get; set; }
    }

    public class ContributionRoles
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
    }

    public class Contributor
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
    }


    public class LanguageDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
        public string ISO { get; set; } = "";
    }

    public class PodcastCategoryDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
    }
}
