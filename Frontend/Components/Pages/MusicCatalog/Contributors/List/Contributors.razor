@page "/contributors"
@attribute [Authorize(Roles = "Quality controller,Admin,Content creator")]

@using Microsoft.AspNetCore.Authorization

@namespace Frontend.Components.Pages.MusicCatalog.Contributors.List

<PageTitle>Contributor Catalog</PageTitle>

<MudStack Spacing="3">

    <MudPaper Class="pa-4" Elevation="5">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <div>
                <MudText Typo="Typo.h4">Contributor Catalog</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Search and manage artists, writers, producers and other contributors.
                </MudText>
            </div>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Warning"
                       StartIcon="@Icons.Material.Filled.Add"
                       Href="/create-contributor">
                Create Contributor
            </MudButton>
        </MudStack>
    </MudPaper>

    <MudPaper Class="pa-4" Elevation="5">
        <MudGrid Spacing="2" AlignItems="Center">
            <MudItem xs="12" md="8">
                <MudTextField @bind-Value="_searchString"
                              Placeholder="Search by display name, legal name, IPI or ISNI..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Variant="Variant.Outlined"
                              Immediate="true"
                              Clearable="true"
                              FullWidth="true" />
            </MudItem>

            <MudItem xs="12" md="4">
                <MudSelect T="ContributorFilter"
                           @bind-Value="_filter"
                           Label="Filter"
                           Variant="Variant.Outlined"
                           Dense="true"
                           FullWidth="true">
                    <MudSelectItem Value="ContributorFilter.All">All contributors</MudSelectItem>
                    <MudSelectItem Value="ContributorFilter.WithIPI">With IPI</MudSelectItem>
                    <MudSelectItem Value="ContributorFilter.WithISNI">With ISNI</MudSelectItem>
                    <MudSelectItem Value="ContributorFilter.MissingIdentifiers">Missing identifiers</MudSelectItem>
                </MudSelect>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (isLoading)
    {
        <MudPaper Class="pa-6" Elevation="5">
            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                <MudProgressCircular Indeterminate="true" Color="Color.Warning" />
                <MudText Color="Color.Secondary">Loading contributors...</MudText>
            </MudStack>
        </MudPaper>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <MudAlert Severity="Severity.Error">
            @errorMessage
        </MudAlert>
    }
    else if (_contributors == null || !_contributors.Any())
    {
        <MudAlert Severity="Severity.Info">
            No contributors found.
        </MudAlert>
    }
    else
    {
        <MudPaper Class="pa-4" Elevation="5">

            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                <MudText Typo="Typo.h6">Contributors</MudText>

                <MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined" Size="Size.Small">
                    @FilteredContributors.Count() shown
                </MudChip>
            </MudStack>

            <MudTable Items="FilteredContributors"
                      T="ContributorDto"
                      Hover="true"
                      Dense="true"
                      Elevation="0"
                      Breakpoint="Breakpoint.Sm">

                <HeaderContent>
                    <MudTh>Contributor</MudTh>
                    <MudTh>Legal name</MudTh>
                    <MudTh>IPI</MudTh>
                    <MudTh>ISNI</MudTh>
                    <MudTh Style="width:150px;">Actions</MudTh>
                </HeaderContent>

                <RowTemplate>
                    <MudTd DataLabel="Contributor">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudAvatar Color="Color.Warning" Variant="Variant.Filled">
                                @GetInitials(context.DisplayName)
                            </MudAvatar>

                            <div>
                                <MudLink Href="@($"/contributors/{context.Id}")">
                                    <MudText Typo="Typo.subtitle2">
                                        @context.DisplayName
                                    </MudText>
                                </MudLink>

                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    Contributor profile
                                </MudText>
                            </div>
                        </MudStack>
                    </MudTd>

                    <MudTd DataLabel="Legal name">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @DisplayValue(context.LegalName)
                        </MudText>
                    </MudTd>

                    <MudTd DataLabel="IPI">
                        @if (!string.IsNullOrWhiteSpace(context.IPI))
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                @context.IPI
                            </MudChip>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">-</MudText>
                        }
                    </MudTd>

                    <MudTd DataLabel="ISNI">
                        @if (!string.IsNullOrWhiteSpace(context.ISNI))
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                @context.ISNI
                            </MudChip>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">-</MudText>
                        }
                    </MudTd>

                    <MudTd DataLabel="Actions">
                        <MudStack Row="true" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Warning"
                                           Size="Size.Small"
                                           OnClick="@(() => EditContributor(context.Id))" />

                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="@(() => DeleteContributor(context.Id))" />
                        </MudStack>
                    </MudTd>
                </RowTemplate>

                <NoRecordsContent>
                    <MudText Color="Color.Secondary">
                        No contributors match the selected filter.
                    </MudText>
                </NoRecordsContent>

            </MudTable>
        </MudPaper>
    }

</MudStack>

