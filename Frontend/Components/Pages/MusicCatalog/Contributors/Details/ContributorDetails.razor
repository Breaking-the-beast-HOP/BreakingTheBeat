@page "/contributors/{Id:guid}"
@rendermode InteractiveServer
@using Frontend.Components.Layout
@using MudBlazor
@using Frontend.Components.Shared
@inject HttpClient Http

<PageTitle>Contributor Details</PageTitle>

<MudStack Spacing="3">

    <!-- Header -->
    <MudPaper Class="pa-4" Elevation="5">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <div>
                <MudText Typo="Typo.h4">
                    @(_contributor?.DisplayName ?? "Contributor")
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Contributor details
                </MudText>
            </div>

            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           Href="/contributors">
                    Back
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Warning"
                           StartIcon="@Icons.Material.Filled.Edit"
                           Disabled="true">
                    Edit
                </MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>

    @if (_isLoading)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Warning" />
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
    }
    else if (_contributor is null)
    {
        <MudAlert Severity="Severity.Warning">Contributor not found.</MudAlert>
    }
    else
    {
        <MudGrid Spacing="3">

            <!-- LEFT -->
            <MudItem xs="12" md="5">
                <MudStack Spacing="3">

                    <MudPaper Class="pa-4" Elevation="5">
                        <MudText Typo="Typo.h6" Class="mb-3">Contributor Info</MudText>

                        <MudStack Spacing="1">
                            <DetailRow Label="Display name"
                                       Value="@_contributor.DisplayName" />

                            <DetailRow Label="Legal name"
                                       Value="@(string.IsNullOrWhiteSpace(_contributor.LegalName) ? "-" : _contributor.LegalName)" />

                            <DetailRow Label="IPI"
                                       Value="@(string.IsNullOrWhiteSpace(_contributor.IPI) ? "-" : _contributor.IPI)" />

                            <DetailRow Label="ISNI"
                                       Value="@(string.IsNullOrWhiteSpace(_contributor.ISNI) ? "-" : _contributor.ISNI)" />
                        </MudStack>
                    </MudPaper>

                    <MudPaper Class="pa-4" Elevation="5">
                        <MudText Typo="Typo.h6" Class="mb-3">Summary</MudText>

                        <MudStack Spacing="1">
                            <DetailRow Label="Track contributions"
                                       Value="@_contributor.TrackContributions.Count.ToString()" />

                            <DetailRow Label="Release contributions"
                                       Value="@_contributor.ReleaseContributions.Count.ToString()" />

                            <DetailRow Label="Total contributions"
                                       Value="@TotalContributions.ToString()" />
                        </MudStack>
                    </MudPaper>

                </MudStack>
            </MudItem>

            <!-- RIGHT -->
            <MudItem xs="12" md="7">
                <MudPaper Class="pa-4" Elevation="5">

                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                        <MudText Typo="Typo.h6">Direct Contributions</MudText>

                        <MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined" Size="Size.Small">
                            @TotalContributions contribution(s)
                        </MudChip>
                    </MudStack>

                    <MudTabs Rounded="true" Color="Color.Warning">

                        <MudTabPanel Text="@($"Tracks ({_contributor.TrackContributions.Count})")">
                            @if (!_contributor.TrackContributions.Any())
                            {
                                <MudAlert Severity="Severity.Info" Dense="true">
                                    No direct track contributions found.
                                </MudAlert>
                            }
                            else
                            {
                                <MudTable Items="_contributor.TrackContributions"
                                          Dense="true"
                                          Hover="true"
                                          Elevation="0">
                                    <HeaderContent>
                                        <MudTh>Track</MudTh>
                                        <MudTh>Role</MudTh>
                                        <MudTh>ISRC</MudTh>
                                        <MudTh></MudTh>
                                    </HeaderContent>

                                    <RowTemplate>
                                        <MudTd>
                                            <MudText Typo="Typo.body2" Class="font-weight-bold">
                                                @context.TrackTitle
                                            </MudText>
                                        </MudTd>

                                        <MudTd>
                                            <MudChip T="string"
                                                     Size="Size.Small"
                                                     Color="Color.Warning"
                                                     Variant="Variant.Outlined">
                                                @context.RoleName
                                            </MudChip>
                                        </MudTd>

                                        <MudTd>
                                            @(string.IsNullOrWhiteSpace(context.ISRC) ? "-" : context.ISRC)
                                        </MudTd>

                                        <MudTd Align="Align.Right">
                                            <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                                           Color="Color.Warning"
                                                           Size="Size.Small"
                                                           Href="@($"/tracks/{context.TrackId}")" />
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            }
                        </MudTabPanel>

                        <MudTabPanel Text="@($"Releases ({_contributor.ReleaseContributions.Count})")">
                            @if (!_contributor.ReleaseContributions.Any())
                            {
                                <MudAlert Severity="Severity.Info" Dense="true">
                                    No direct release contributions found.
                                </MudAlert>
                            }
                            else
                            {
                                <MudTable Items="_contributor.ReleaseContributions"
                                          Dense="true"
                                          Hover="true"
                                          Elevation="0">
                                    <HeaderContent>
                                        <MudTh>Release</MudTh>
                                        <MudTh>Role</MudTh>
                                        <MudTh>EAN</MudTh>
                                        <MudTh></MudTh>
                                    </HeaderContent>

                                    <RowTemplate>
                                        <MudTd>
                                            <MudText Typo="Typo.body2" Class="font-weight-bold">
                                                @context.ReleaseTitle
                                            </MudText>
                                        </MudTd>

                                        <MudTd>
                                            <MudChip T="string"
                                                     Size="Size.Small"
                                                     Color="Color.Warning"
                                                     Variant="Variant.Outlined">
                                                @context.RoleName
                                            </MudChip>
                                        </MudTd>

                                        <MudTd>
                                            @(string.IsNullOrWhiteSpace(context.EAN) ? "-" : context.EAN)
                                        </MudTd>

                                        <MudTd Align="Align.Right">
                                            <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                                           Color="Color.Warning"
                                                           Size="Size.Small"
                                                           Href="@($"/releases/{context.ReleaseId}")" />
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            }
                        </MudTabPanel>

                    </MudTabs>
                </MudPaper>
            </MudItem>

        </MudGrid>
    }

</MudStack>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private bool _isLoading = true;
    private string? _errorMessage;
    private ContributorDetailsResponse? _contributor;

    private int TotalContributions =>
        (_contributor?.TrackContributions.Count ?? 0)
        + (_contributor?.ReleaseContributions.Count ?? 0);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLoading = true;

            _contributor = await Http.GetFromJsonAsync<ContributorDetailsResponse>(
                $"api/contributor/{Id}");

            if (_contributor is null)
                _errorMessage = "Contributor could not be found.";
        }
        catch
        {
            _errorMessage = "Failed to load contributor.";
        }
        finally
        {
            _isLoading = false;
        }
    }

  
}