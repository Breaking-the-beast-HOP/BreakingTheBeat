@page "/tracks"
@attribute [Authorize(Roles = "Quality controller,Admin,Content creator")]
@rendermode InteractiveServer
@using Frontend.Components.Pages.MusicCatalog.SharedModels
@using Frontend.Components.Pages.MusicCatalog.Tracks
@using Microsoft.AspNetCore.Authorization

<PageTitle>Track Catalog</PageTitle>

<MudStack Spacing="3">

    <!-- Header -->
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.h4">Track Catalog</MudText>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Warning"
                   StartIcon="@Icons.Material.Filled.Add"
                   Href="/create-track">
            Create Track
        </MudButton>
    </MudStack>

    <!-- Search -->
    <MudPaper Class="pa-4" Elevation="2" Style="border: 0.5px solid var(--mud-palette-divider);">

        @* Filter header *@
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3" Spacing="2">
            <MudIcon Icon="@Icons.Material.Outlined.FilterAlt"
                     Size="Size.Small"
                     Color="Color.Default" />
            <MudText Typo="Typo.body2" Color="Color.Secondary">Filters</MudText>
            <MudChip T="string"
                     Size="Size.Small"
                     Color="Color.Warning"
                     Variant="Variant.Outlined"
                     Style="height: 20px; font-size: 11px; font-weight: 500; letter-spacing: 0.04em;">
                ACTIVE
            </MudChip>
        </MudStack>

        @* Filter row – alle felter er på én linje og alignet i bunden *@
        <MudGrid Spacing="2">

            <MudItem xs="12" md="5">
                <MudTextField @bind-Value="_searchString"
                              Label="Search"
                              Placeholder="Search title, version or ISRC…"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Clearable="true"
                              FullWidth="true" />
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="string"
                           Label="Genre"
                           Placeholder="All genres"
                           @bind-Value="_selectedGenreFilter"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Clearable="true"
                           FullWidth="true">
                    @foreach (var genre in _tracks
                        .Where(t => !string.IsNullOrWhiteSpace(t.GenreName))
                        .Select(t => t.GenreName!)
                        .Distinct()
                        .OrderBy(x => x))
                    {
                        <MudSelectItem Value="@genre">@genre</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="string"
                           Label="Audio language"
                           Placeholder="All languages"
                           @bind-Value="_selectedLanguageFilter"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Clearable="true"
                           FullWidth="true">
                    @foreach (var language in _tracks
                        .Where(t => !string.IsNullOrWhiteSpace(t.AudioLanguageName))
                        .Select(t => t.AudioLanguageName!)
                        .Distinct()
                        .OrderBy(x => x))
                    {
                        <MudSelectItem Value="@language">@language</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="1" Class="d-flex align-end">
                <MudTooltip Text="Clear all filters">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Outlined.FilterAltOff"
                               Size="Size.Medium"
                               FullWidth="true"
                               OnClick="ClearFilters">
                        Clear
                    </MudButton>
                </MudTooltip>
            </MudItem>

        </MudGrid>
    </MudPaper>


    <!-- Content -->
    @if (isLoading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <MudAlert Severity="Severity.Error">
            @errorMessage
        </MudAlert>
    }
    else if (_tracks == null || !_tracks.Any())
    {
        <MudAlert Severity="Severity.Info">
            No tracks found.
        </MudAlert>
    }
    else
    {
        <MudPaper Class="pa-4" Elevation="5">

            <MudTable Items="FilteredTracks"
                      T="TrackDto"
                      Hover="true"
                      Dense="true"
                      Elevation="0"
                      OnRowClick="@(args => OnRowClicked(args))"
                      @bind-CurrentPage="_currentPage">
                

                <HeaderContent>
                    <MudTh>Title</MudTh>
                    <MudTh>Version</MudTh>
                    <MudTh>ISRC</MudTh>
                    <MudTh>Duration</MudTh>
                    <MudTh>Language</MudTh>
                    <MudTh>Genre</MudTh>
                </HeaderContent>

                <RowTemplate>
                    <MudTd DataLabel="Title">
                        <MudText Typo="Typo.subtitle2">@context.Title</MudText>
                    </MudTd>

                    <MudTd DataLabel="Version">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @(string.IsNullOrWhiteSpace(context.Version) ? "-" : context.Version)
                        </MudText>
                    </MudTd>

                    <MudTd DataLabel="ISRC">
                        <MudText Typo="Typo.body2">
                            @context.ISRC
                        </MudText>
                    </MudTd>

                    <MudTd DataLabel="Duration">
                        <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Size="Size.Small">
                            @FormatDuration(context.DurationSeconds)
                        </MudChip>
                    </MudTd>

                    <MudTd DataLabel="Language">
                        <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small">
                            @(context.AudioLanguageName ?? "-")
                        </MudChip>
                    </MudTd>

                    <MudTd DataLabel="Genre">
                        <MudChip T="string" Color="Color.Secondary" Variant="Variant.Filled" Size="Size.Small">
                            @(context.GenreName ?? "-")
                        </MudChip>
                    </MudTd>

                    <!-- Edit -->
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Color="Color.Warning"
                                   Size="Size.Small"
                                   Title="Edit track"
                                   OnClick="@(() => GoToEdit(context.Id))" />

                    <!-- Delete -->
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   Title="Delete track"
                                   OnClick="@(async () => await DeleteTrack(context.Id))" />

                </RowTemplate>

                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }"
                                   InfoFormat="{first_item}-{last_item} af {all_items}" />
                </PagerContent>

            </MudTable>
        </MudPaper>
    }

</MudStack>

