@using Frontend.Components.Pages.MusicCatalog.MusicReleases.Models
@using Frontend.Components.Pages.MusicCatalog.SharedModels
@using MudBlazor

<MudPaper Class="pa-4" Elevation="5">
    <MudText Typo="Typo.h6" Class="mb-3">Volumes</MudText>

    @foreach (var volume in Model.Volumes)
    {
        <MudPaper Class="mb-4" Outlined="true">

            <!-- Volume header -->
            <MudStack Row="true"
                      Justify="Justify.SpaceBetween"
                      AlignItems="AlignItems.Center"
                      Class="pa-3">

                <MudText Typo="Typo.h6">
                    Volume @volume.VolumeNumber
                </MudText>

                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Disabled="@(Model.Volumes.Count == 1)"
                               OnClick="@(() => RemoveVolumeRequested.InvokeAsync(volume))" />
            </MudStack>

            <MudDivider />

            <!-- Tracks -->
            @foreach (var track in volume.Tracks)
            {
                <MudStack Row="true"
                          AlignItems="AlignItems.Center"
                          Spacing="2"
                          Class="pa-3 volume-track-row">

                    <MudText Typo="Typo.body2" Class="track-number">
                        @track.TrackNumber
                    </MudText>

                    <MudStack Spacing="0" Class="flex-grow-1">
                        <MudAutocomplete T="TrackDto"
                                         Label="Track"
                                         Variant="Variant.Text"
                                         Value="track.SelectedTrack"
                                         ValueChanged="@(t => TrackChanged.InvokeAsync((track, t)))"
                                         SearchFunc="SearchTracks"
                                         ToStringFunc="@(t => t?.Title ?? string.Empty)"
                                         Clearable="true"
                                         Dense="true"
                                         MaxItems="8"
                                         Disabled="IsLoadingLookups" />

                        @if (track.SelectedTrack is not null)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @DisplayTrackSubtitle(track.SelectedTrack)
                            </MudText>
                        }
                    </MudStack>

                    <MudText Typo="Typo.body2" Class="duration-text">
                        @FormatDuration(track.SelectedTrack?.DurationSeconds)
                    </MudText>

                    <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                   Color="Color.Warning"
                                   Size="Size.Small"
                                   Disabled="@(track.TrackId is null)"
                                   OnClick="@(() => PreviewTrackRequested.InvokeAsync(track.TrackId))" />

                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   Disabled="@(volume.Tracks.Count == 1)"
                                   OnClick="@(() => RemoveTrackRequested.InvokeAsync((volume, track)))" />

                </MudStack>

                <MudDivider />
            }

            <!-- Add track -->
            <MudStack Row="true"
                      Justify="Justify.FlexEnd"
                      Class="pa-3">

                <MudButton Variant="Variant.Text"
                           Color="Color.Warning"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="@(() => AddTrackRequested.InvokeAsync(volume))">
                    Add track
                </MudButton>

            </MudStack>

        </MudPaper>
    }

    <!-- Add volume -->
    <MudStack Row="true" Justify="Justify.FlexEnd">
        <MudButton Variant="Variant.Text"
                   Color="Color.Warning"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="@(() => AddVolumeRequested.InvokeAsync())">
            Add volume
        </MudButton>
    </MudStack>

</MudPaper>

@code {
    [Parameter] public ReleaseModel Model { get; set; } = default!;
    [Parameter] public bool IsLoadingLookups { get; set; }

    [Parameter] public Func<string, CancellationToken, Task<IEnumerable<TrackDto>>> SearchTracks { get; set; } = default!;

    [Parameter] public EventCallback<ReleaseVolumeModel> AddTrackRequested { get; set; }
    [Parameter] public EventCallback AddVolumeRequested { get; set; }

    [Parameter] public EventCallback<ReleaseVolumeModel> RemoveVolumeRequested { get; set; }
    [Parameter] public EventCallback<(ReleaseVolumeModel Volume, ReleaseTrackModel Track)> RemoveTrackRequested { get; set; }

    [Parameter] public EventCallback<(ReleaseTrackModel Row, TrackDto? Track)> TrackChanged { get; set; }
    [Parameter] public EventCallback<Guid?> PreviewTrackRequested { get; set; }

    [Parameter] public Func<int?, string> FormatDuration { get; set; } = default!;
    [Parameter] public Func<TrackDto, string> DisplayTrackSubtitle { get; set; } = default!;
}
