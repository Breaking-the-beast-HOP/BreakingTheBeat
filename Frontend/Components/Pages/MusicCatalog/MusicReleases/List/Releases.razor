@page "/releases"
@attribute [Authorize(Roles = "Quality controller,Admin,Content creator")]
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using Frontend.Components.Pages.MusicCatalog.SharedModels
@using Frontend.Components.Pages.MusicCatalog.MusicReleases

<PageTitle>Release Catalog</PageTitle>

<MudStack Spacing="3">

    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.h4">Release Catalog</MudText>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Warning"
                   StartIcon="@Icons.Material.Filled.Add"
                   Href="/create-release">
            Create Release
        </MudButton>
    </MudStack>

    <!-- Filter panel -->
    <MudPaper Class="pa-4" Elevation="2" Style="border: 0.5px solid var(--mud-palette-divider);">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3" Spacing="2">
            <MudIcon Icon="@Icons.Material.Outlined.FilterAlt" Size="Size.Small" Color="Color.Default" />
            <MudText Typo="Typo.body2" Color="Color.Secondary">Filters</MudText>
            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined"
                     Style="height: 20px; font-size: 11px; font-weight: 500; letter-spacing: 0.04em;">
                ACTIVE
            </MudChip>
        </MudStack>

        <MudGrid Spacing="2">
            <MudItem xs="12" md="5">
                <MudTextField @bind-Value="_searchString"
                              Label="Search"
                              Placeholder="Search title or EAN…"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Clearable="true"
                              FullWidth="true" />
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="string" Label="Genre" Placeholder="All genres"
                           @bind-Value="_selectedGenreFilter"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           Clearable="true" FullWidth="true">
                    @foreach (var genre in _releases
                        .Where(r => !string.IsNullOrWhiteSpace(r.GenreName))
                        .Select(r => r.GenreName!).Distinct().OrderBy(x => x))
                    {
                        <MudSelectItem Value="@genre">@genre</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="string" Label="Status" Placeholder="All statuses"
                           @bind-Value="_selectedStatusFilter"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           Clearable="true" FullWidth="true">
                    @foreach (var status in Enum.GetNames<ReleaseStatus>())
                    {
                        <MudSelectItem Value="@status">@GetStatusLabel(status)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="1" Class="d-flex align-end">
                <MudTooltip Text="Clear all filters">
                    <MudButton Variant="Variant.Outlined" Color="Color.Default"
                               StartIcon="@Icons.Material.Outlined.FilterAltOff"
                               Size="Size.Medium" FullWidth="true"
                               OnClick="ClearFilters">
                        Clear
                    </MudButton>
                </MudTooltip>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (_isLoading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
    }
    else if (_releases is null || !_releases.Any())
    {
        <MudAlert Severity="Severity.Info">No releases found.</MudAlert>
    }
    else
    {
        <MudPaper Class="pa-4" Elevation="5">
            <MudTable Items="FilteredReleases" T="ReleaseDto"
                      Hover="true" Dense="true" Elevation="0"
                      OnRowClick="@(args => OnRowClicked(args))"
                      @bind-CurrentPage="_currentPage">

                <HeaderContent>
                    <MudTh>Title</MudTh>
                    <MudTh>Release year</MudTh>
                    <MudTh>Language</MudTh>
                    <MudTh>Primary genre</MudTh>
                    <MudTh>EAN</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>

                <RowTemplate>
                    <MudTd DataLabel="Title">
                        <MudText Typo="Typo.subtitle2">@context.Title</MudText>
                        @if (!string.IsNullOrWhiteSpace(context.Version))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Version</MudText>
                        }
                    </MudTd>

                    <MudTd DataLabel="Release year">
                        <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Size="Size.Small">
                            @FormatReleaseYear(context.ReleaseDate)
                        </MudChip>
                    </MudTd>

                    <MudTd DataLabel="Language">
                        <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small">
                            @(context.LanguageName ?? "-")
                        </MudChip>
                    </MudTd>

                    <MudTd DataLabel="Primary genre">
                        <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled" Size="Size.Small">
                            @(context.GenreName ?? "-")
                        </MudChip>
                    </MudTd>

                    <MudTd DataLabel="EAN">
                        <MudText Typo="Typo.body2">
                            @(string.IsNullOrWhiteSpace(context.EAN) ? "-" : context.EAN)
                        </MudText>
                    </MudTd>

                    <MudTd DataLabel="Status">
                        @{
                            var (icon, color, label, tooltip) = GetStatusDisplay(context.Status);
                        }
                        <MudTooltip Text="@tooltip">
                            <MudChip T="string" Color="@color" Variant="Variant.Filled" Size="Size.Small"
                                     Icon="@icon">
                                @label
                            </MudChip>
                        </MudTooltip>
                    </MudTd>

                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Warning" Size="Size.Small"
                                       Title="Edit release"
                                       OnClick="@(() => GoToEdit(context.Id))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error" Size="Size.Small"
                                       Title="Delete release"
                                       OnClick="@(async () => await DeleteRelease(context.Id))" />
                    </MudTd>
                </RowTemplate>

                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }"
                                   InfoFormat="{first_item}-{last_item} af {all_items}" />
                </PagerContent>

            </MudTable>
        </MudPaper>
    }

</MudStack>