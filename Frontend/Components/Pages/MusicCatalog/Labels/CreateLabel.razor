@page "/create-label"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Quality controller,Admin,Content creator")]

@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@using MudBlazor

@inject HttpClient Http
@inject NavigationManager Navigation

@namespace Frontend.Components.Pages.MusicCatalog.Labels.Create

<MudContainer MaxWidth="MaxWidth.False" Class="pa-6">

    <MudStack Spacing="4">

        <MudPaper Class="pa-4" Elevation="5">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <div>
                    <MudText Typo="Typo.h4">Create Label</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Create a new music label with contact and localization information
                    </MudText>
                </div>

                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Text"
                               Color="Color.Default"
                               OnClick="GoToLabels">
                        Cancel
                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Warning"
                               StartIcon="@Icons.Material.Filled.Save"
                               Disabled="@(_isSaving || _isLoadingLookups)"
                               OnClick="SaveLabel">
                        @(_isSaving ? "Saving..." : "Save label")
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Dense="true">
                @_errorMessage
            </MudAlert>
        }

        @if (_isLoadingLookups)
        {
            <MudPaper Class="pa-4" Elevation="5">
                <MudProgressCircular Indeterminate="true" Color="Color.Warning" />
                <MudText Class="mt-2">Loading lookup data...</MudText>
            </MudPaper>
        }
        else
        {
            <MudGrid Spacing="3">

                <MudItem xs="12" md="7">
                    <MudStack Spacing="3">

                        <MudPaper Class="pa-4" Elevation="5">
                            <MudText Typo="Typo.h6" Class="mb-4">Label Information</MudText>

                            <MudGrid Spacing="3">
                                <MudItem xs="12" sm="8">
                                    <MudTextField @bind-Value="_model.Name"
                                                  Label="Label name"
                                                  Variant="Variant.Outlined"
                                                  Required="true" />
                                </MudItem>

                                <MudItem xs="12" sm="4">
                                    <MudTextField @bind-Value="_model.LabelCode"
                                                  Label="Label code"
                                                  Variant="Variant.Outlined"
                                                  Required="true"
                                                  HelperText="Internal or external label identifier" />
                                </MudItem>

                                <MudItem xs="12">
                                    <MudTextField @bind-Value="_model.Website"
                                                  Label="Website"
                                                  Variant="Variant.Outlined"
                                                  Adornment="Adornment.Start"
                                                  AdornmentIcon="@Icons.Material.Filled.Language" />
                                </MudItem>
                            </MudGrid>
                        </MudPaper>

                        <MudPaper Class="pa-4" Elevation="5">
                            <MudText Typo="Typo.h6" Class="mb-4">Social Media</MudText>

                            <MudGrid Spacing="3">
                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="_model.InstagramUrl"
                                                  Label="Instagram"
                                                  Variant="Variant.Outlined"
                                                  Adornment="Adornment.Start"
                                                  AdornmentIcon="@Icons.Material.Filled.CameraAlt" />
                                </MudItem>

                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="_model.TikTokUrl"
                                                  Label="TikTok"
                                                  Variant="Variant.Outlined" />
                                </MudItem>

                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="_model.YouTubeUrl"
                                                  Label="YouTube"
                                                  Variant="Variant.Outlined"
                                                  Adornment="Adornment.Start"
                                                  AdornmentIcon="@Icons.Material.Filled.SmartDisplay" />
                                </MudItem>

                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="_model.FacebookUrl"
                                                  Label="Facebook"
                                                  Variant="Variant.Outlined" />
                                </MudItem>
                            </MudGrid>
                        </MudPaper>

                        <MudPaper Class="pa-4" Elevation="5">
                            <MudText Typo="Typo.h6" Class="mb-4">Localization</MudText>

                            <MudGrid Spacing="3">
                                <MudItem xs="12" sm="6">
                                    <MudAutocomplete T="CountryDto"
                                                     Label="Country"
                                                     Variant="Variant.Outlined"
                                                     Value="_selectedCountry"
                                                     ValueChanged="OnCountryChanged"
                                                     SearchFunc="SearchCountries"
                                                     ToStringFunc="@(c => c is null ? string.Empty : $"{c.Name} ({c.ISO})")"
                                                     Clearable="true"
                                                     Required="true" />
                                </MudItem>

                                <MudItem xs="12" sm="6">
                                    <MudAutocomplete T="LanguageDto"
                                                     Label="Primary language"
                                                     Variant="Variant.Outlined"
                                                     Value="_selectedPrimaryLanguage"
                                                     ValueChanged="OnPrimaryLanguageChanged"
                                                     SearchFunc="SearchLanguages"
                                                     ToStringFunc="@(l => l is null ? string.Empty : $"{l.Name} ({l.ISO})")"
                                                     Clearable="true" />
                                </MudItem>
                            </MudGrid>
                        </MudPaper>

                    </MudStack>
                </MudItem>

                <MudItem xs="12" md="5">
                    <MudStack Spacing="3">

                        <MudPaper Class="pa-4" Elevation="5">
                            <MudText Typo="Typo.h6" Class="mb-3">Label Logo</MudText>

                            <MudPaper Class="pa-8" Outlined="true">
                                <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="2">
                                    <MudIcon Icon="@Icons.Material.Filled.Image"
                                             Size="Size.Large"
                                             Color="Color.Warning" />

                                    <MudText Typo="Typo.subtitle1">Logo placeholder</MudText>

                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        Logo upload will be added later
                                    </MudText>
                                </MudStack>
                            </MudPaper>
                        </MudPaper>

                        <MudPaper Class="pa-4" Elevation="5">
                            <MudText Typo="Typo.h6" Class="mb-4">Contact Person</MudText>

                            <MudGrid Spacing="3">
                                <MudItem xs="12">
                                    <MudTextField @bind-Value="_model.ContactPerson!.FullName"
                                                  Label="Full name"
                                                  Variant="Variant.Outlined" />
                                </MudItem>

                                <MudItem xs="12">
                                    <MudTextField @bind-Value="_model.ContactPerson!.Email"
                                                  Label="Email"
                                                  Variant="Variant.Outlined"
                                                  InputType="InputType.Email"
                                                  Adornment="Adornment.Start"
                                                  AdornmentIcon="@Icons.Material.Filled.Email" />
                                </MudItem>

                                <MudItem xs="12">
                                    <MudTextField @bind-Value="_model.ContactPerson!.PhoneNumber"
                                                  Label="Phone number"
                                                  Variant="Variant.Outlined"
                                                  Adornment="Adornment.Start"
                                                  AdornmentIcon="@Icons.Material.Filled.Phone" />
                                </MudItem>

                                <MudItem xs="12">
                                    <MudTextField @bind-Value="_model.ContactPerson!.Role"
                                                  Label="Role / title"
                                                  Variant="Variant.Outlined"
                                                  Placeholder="A&R Manager, Owner, Rights Manager..." />
                                </MudItem>

                                <MudItem xs="12">
                                    <MudAutocomplete T="LanguageDto"
                                                     Label="Preferred language"
                                                     Variant="Variant.Outlined"
                                                     Value="_selectedPreferredLanguage"
                                                     ValueChanged="OnPreferredLanguageChanged"
                                                     SearchFunc="SearchLanguages"
                                                     ToStringFunc="@(l => l is null ? string.Empty : $"{l.Name} ({l.ISO})")"
                                                     Clearable="true" />
                                </MudItem>
                            </MudGrid>
                        </MudPaper>

                    </MudStack>
                </MudItem>

            </MudGrid>
        }

        <MudDialog @bind-Visible="_showSuccessDialog">
            <TitleContent>
                <MudText Typo="Typo.h6">Label created</MudText>
            </TitleContent>

            <DialogContent>
                <MudText>The label was created successfully.</MudText>
            </DialogContent>

            <DialogActions>
                <MudButton Variant="Variant.Text" OnClick="CreateAnother">
                    Create another
                </MudButton>

                <MudButton Variant="Variant.Outlined" OnClick="GoToLabels">
                    Back to labels
                </MudButton>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Warning"
                           OnClick="GoToCreatedLabel">
                    View label
                </MudButton>
            </DialogActions>
        </MudDialog>

    </MudStack>

</MudContainer>

@code
{
    private CreateLabelRequest _model = new()
    {
        ContactPerson = new CreateLabelContactPersonRequest()
    };

    private List<CountryDto> _countries = new();
    private List<LanguageDto> _languages = new();

    private CountryDto? _selectedCountry;
    private LanguageDto? _selectedPrimaryLanguage;
    private LanguageDto? _selectedPreferredLanguage;

    private bool _isLoadingLookups = true;
    private bool _isSaving = false;

    private string? _errorMessage;

    private bool _showSuccessDialog;

    private Guid? _createdLabelId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _countries = await Http.GetFromJsonAsync<List<CountryDto>>("api/Country")?? new();

            _languages = await Http.GetFromJsonAsync<List<LanguageDto>>("api/Language") ?? new();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Could not load lookup data: {ex.Message}";
        }
        finally
        {
            _isLoadingLookups = false;
        }
    }

    private Task<IEnumerable<CountryDto>> SearchCountries(
        string value,
        CancellationToken token)
    {
        var result = string.IsNullOrWhiteSpace(value)
            ? _countries
            : _countries.Where(c =>
                c.Name.Contains(value, StringComparison.OrdinalIgnoreCase) ||
                c.ISO.Contains(value, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(result.AsEnumerable());
    }

    private Task<IEnumerable<LanguageDto>> SearchLanguages(
        string value,
        CancellationToken token)
    {
        var result = string.IsNullOrWhiteSpace(value)
            ? _languages
            : _languages.Where(l =>
                l.Name.Contains(value, StringComparison.OrdinalIgnoreCase) ||
                l.ISO.Contains(value, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(result.AsEnumerable());
    }

    private Task OnCountryChanged(CountryDto? country)
    {
        _selectedCountry = country;

        _model.CountryCode = country?.ISO;

        return Task.CompletedTask;
    }

    private Task OnPrimaryLanguageChanged(LanguageDto? language)
    {
        _selectedPrimaryLanguage = language;

        _model.PrimaryLanguageCode = language?.ISO;

        return Task.CompletedTask;
    }

    private Task OnPreferredLanguageChanged(LanguageDto? language)
    {
        _selectedPreferredLanguage = language;

        _model.ContactPerson ??= new CreateLabelContactPersonRequest();

        _model.ContactPerson.PreferredLanguageCode = language?.ISO;

        return Task.CompletedTask;
    }

    private async Task SaveLabel()
    {
        _errorMessage = null;

        if (string.IsNullOrWhiteSpace(_model.Name))
        {
            _errorMessage = "Label name is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_model.LabelCode))
        {
            _errorMessage = "Label code is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_model.CountryCode))
        {
            _errorMessage = "Country is required.";
            return;
        }

        try
        {
            _isSaving = true;

            var response =
                await Http.PostAsJsonAsync("api/Label", _model);

            if (response.IsSuccessStatusCode)
            {
                _createdLabelId =
                    await response.Content.ReadFromJsonAsync<Guid>();

                _showSuccessDialog = true;
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();

                _errorMessage = string.IsNullOrWhiteSpace(error)
                    ? "Failed to save label."
                    : error;
            }
        }
        catch (Exception ex)
        {
            _errorMessage =
                $"An error occurred while saving: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void GoToCreatedLabel()
    {
        if (_createdLabelId is null)
            return;

        Navigation.NavigateTo($"/labels/{_createdLabelId}");
    }

    private void GoToLabels()
    {
        Navigation.NavigateTo("/labels");
    }

    private void CreateAnother()
    {
        ResetForm();

        _createdLabelId = null;
        _showSuccessDialog = false;
        _errorMessage = null;
    }

    private void ResetForm()
    {
        _model = new CreateLabelRequest
        {
            ContactPerson = new CreateLabelContactPersonRequest()
        };

        _selectedCountry = null;
        _selectedPrimaryLanguage = null;
        _selectedPreferredLanguage = null;
 
    }

    public class CreateLabelRequest
    {
        // Basic information
        public string Name { get; set; } = string.Empty;

        public string LabelCode { get; set; } = string.Empty;

        public string? Website { get; set; }

        // Socials
        public string? InstagramUrl { get; set; }

        public string? TikTokUrl { get; set; }

        public string? YouTubeUrl { get; set; }

        public string? FacebookUrl { get; set; }

        // Localization
        public string? CountryCode { get; set; }

        public string? PrimaryLanguageCode { get; set; }

        // Branding
        public string? LogoUrl { get; set; }

        // Contact
        public CreateLabelContactPersonRequest ContactPerson { get; set; }
            = new();
    }

    public class CreateLabelContactPersonRequest
    {
        public string FullName { get; set; } = string.Empty;

        public string Email { get; set; } = string.Empty;

        public string? PhoneNumber { get; set; }

        public string? Role { get; set; }

        public string? PreferredLanguageCode { get; set; }
    }

    public class LanguageDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
        public string ISO { get; set; } = "";
    }

    public class CountryDto
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
        public string ISO { get; set; } = "";
    }
}