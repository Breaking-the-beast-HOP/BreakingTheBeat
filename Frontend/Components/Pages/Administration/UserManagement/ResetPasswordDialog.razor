@using System.Net.Http.Json
@using Frontend.Components.Pages.Administration.UserManagement

@inject HttpClient Http

<MudDialog Visible="Visible" VisibleChanged="VisibleChanged">
    <TitleContent>
        <MudText Typo="Typo.h6">Reset password</MudText>
    </TitleContent>

    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField Label="Nyt password"
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          @bind-Value="_newPassword" />

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Severity="Severity.Error">@_error</MudAlert>
            }
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Close">
            Annuller
        </MudButton>

        <MudButton Color="Color.Warning"
                   Variant="Variant.Filled"
                   OnClick="ResetPassword">
            Reset password
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    [Parameter] public Guid UserId { get; set; }

    private string _newPassword = string.Empty;
    private string? _error;

    private async Task ResetPassword()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_newPassword))
        {
            _error = "Indtast et nyt password.";
            return;
        }

        var response = await Http.PostAsJsonAsync($"api/users/{UserId}/reset-password", new ResetPasswordRequest
        {
            NewPassword = _newPassword
        });

        if (!response.IsSuccessStatusCode)
        {
            _error = "Password kunne ikke resettes.";
            return;
        }

        _newPassword = string.Empty;
        await VisibleChanged.InvokeAsync(false);
    }

    private async Task Close()
    {
        _newPassword = string.Empty;
        _error = null;
        await VisibleChanged.InvokeAsync(false);
    }
}