@using System.Net.Http.Json
@using Frontend.Components.Pages.Administration.UserManagement

@inject HttpClient Http

<MudDialog Visible="Visible" VisibleChanged="VisibleChanged">
    <TitleContent>
        <MudText Typo="Typo.h6">Rediger bruger</MudText>
    </TitleContent>

    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField Label="Email"
                          Variant="Variant.Outlined"
                          @bind-Value="User.Email" />

            <MudTextField Label="Brugernavn"
                          Variant="Variant.Outlined"
                          @bind-Value="User.UserName" />

            <MudSelect T="string"
                       Label="Rolle"
                       Variant="Variant.Outlined"
                       @bind-Value="User.Role">
                @foreach (var role in Roles)
                {
                    <MudSelectItem Value="@role.Name">@role.Name</MudSelectItem>
                }
            </MudSelect>

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Severity="Severity.Error">@_error</MudAlert>
            }
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Close">
            Annuller
        </MudButton>

        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="SaveUser">
            Gem
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    [Parameter] public UserOverviewDto User { get; set; } = new();
    [Parameter] public List<RoleDto> Roles { get; set; } = new();

    [Parameter] public EventCallback OnSaved { get; set; }

    private string? _error;

    private async Task SaveUser()
    {
        _error = null;

        var response = await Http.PutAsJsonAsync($"api/users/{User.Id}", new UpdateUserRequest
        {
            Id = User.Id,
            Username = User.UserName,
            Email = User.Email,
            RoleName = User.Role
        });

        if (!response.IsSuccessStatusCode)
        {
            _error = "Brugeren kunne ikke gemmes.";
            return;
        }

        await VisibleChanged.InvokeAsync(false);
        await OnSaved.InvokeAsync();
    }

    private async Task Close()
    {
        _error = null;
        await VisibleChanged.InvokeAsync(false);
    }
}