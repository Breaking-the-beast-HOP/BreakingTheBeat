@page "/users"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]

@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@using Frontend.Components.Pages.Administration.UserManagement

@inject HttpClient Http
@inject NavigationManager NavigationManager

<MudPaper Class="pa-4">

    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <MudText Typo="Typo.h5">Brugere</MudText>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="CreateUser">
            Opret bruger
        </MudButton>
    </MudStack>

    <MudPaper Class="pa-4 mb-4"
              Elevation="2"
              Style="border: 0.5px solid var(--mud-palette-divider);">

        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3" Spacing="2">
            <MudIcon Icon="@Icons.Material.Outlined.FilterAlt" Size="Size.Small" />
            <MudText Typo="Typo.body2" Color="Color.Secondary">Filters</MudText>
        </MudStack>

        <MudGrid Spacing="2">
            <MudItem xs="12" md="8">
                <MudTextField @bind-Value="_searchString"
                              Label="Search"
                              Placeholder="Search username or email..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Clearable="true"
                              FullWidth="true" />
            </MudItem>

            <MudItem xs="12" md="4">
                <MudAutocomplete T="string"
                                 Label="Role"
                                 Placeholder="All roles"
                                 @bind-Value="_selectedRole"
                                 SearchFunc="SearchRoles"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Clearable="true"
                                 FullWidth="true"
                                 />
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (_isLoading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
    }
    else
    {
        <MudTable Items="FilteredUsers"
                  T="UserOverviewDto"
                  Hover="true"
                  Dense="false"
                  Elevation="0">

            <HeaderContent>
                <MudTh Style="width:72px"></MudTh>
                <MudTh>User</MudTh>
                <MudTh>Role</MudTh>
                <MudTh Align="Align.Right" Style="width:160px">Actions</MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd DataLabel="Avatar">
                    <MudAvatar Color="Color.Warning"
                               Variant="Variant.Filled"
                               Size="Size.Large">
                        @GetUserInitials(context)
                    </MudAvatar>
                </MudTd>

                <MudTd DataLabel="User">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.subtitle1"
                                 Style="font-weight:600;">
                            @context.UserName
                        </MudText>

                        <MudText Typo="Typo.caption"
                                 Color="Color.Secondary">
                            @context.Email
                        </MudText>
                    </MudStack>
                </MudTd>

                <MudTd DataLabel="Role">
                    <MudChip T="string"
                             Color="Color.Info"
                             Variant="Variant.Filled"
                             Size="Size.Small">
                        @context.Role
                    </MudChip>
                </MudTd>

                <MudTd DataLabel="Actions" Align="Align.Right">
                    <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="1">
                        <MudTooltip Text="Edit user">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Warning"
                                           Size="Size.Small"
                                           OnClick="@(() => OpenEditDialog(context))" />
                        </MudTooltip>

                        <MudTooltip Text="Reset password">
                            <MudIconButton Icon="@Icons.Material.Filled.LockReset"
                                           Color="Color.Info"
                                           Size="Size.Small"
                                           OnClick="@(() => OpenPasswordDialog(context))" />
                        </MudTooltip>

                        <MudTooltip Text="Delete user">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="@(() => DeleteUser(context.Id))" />
                        </MudTooltip>
                    </MudStack>
                </MudTd>
            </RowTemplate>

        </MudTable>
    }

</MudPaper>

<EditUserDialog Visible="_editDialogOpen"
                VisibleChanged="@(value => _editDialogOpen = value)"
                User="_editUser"
                Roles="_roles"
                OnSaved="OnUserSaved" />

<ResetPasswordDialog Visible="_passwordDialogOpen"
                     VisibleChanged="@(value => _passwordDialogOpen = value)"
                     UserId="_passwordUserId" />

@code {
    private List<UserOverviewDto> _users = new();
    private List<RoleDto> _roles = new();

    private bool _isLoading;
    private string? _error;

    private bool _editDialogOpen;
    private UserOverviewDto _editUser = new();

    private bool _passwordDialogOpen;
    private Guid _passwordUserId;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        _error = null;

        try
        {
            _users = await Http.GetFromJsonAsync<List<UserOverviewDto>>("api/users") ?? new();
        }
        catch (Exception ex)
        {
            _error = $"Brugere kunne ikke hentes: {ex.Message}";
            _isLoading = false;
            return;
        }

        try
        {
            _roles = await Http.GetFromJsonAsync<List<RoleDto>>("api/Role") ?? new();
        }
        catch (Exception ex)
        {
            _error = $"Roller kunne ikke hentes: {ex.Message}";
            _isLoading = false;
            return;
        }

        _isLoading = false;
    }

    private async Task LoadUsers()
    {
        _users = await Http.GetFromJsonAsync<List<UserOverviewDto>>("api/users") ?? new();
    }

    private void CreateUser()
    {
        NavigationManager.NavigateTo("/users/register");
    }

    private string _searchString = string.Empty;
    private string? _selectedRole;

    private IEnumerable<UserOverviewDto> FilteredUsers =>
       _users.Where(user =>
           MatchesSearch(user) &&
           MatchesRole(user));

    private bool MatchesSearch(UserOverviewDto user)
    {
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;

        return (user.UserName?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false)
            || (user.Email?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private bool MatchesRole(UserOverviewDto user)
    {
        if (string.IsNullOrWhiteSpace(_selectedRole))
            return true;

        return string.Equals(user.Role, _selectedRole, StringComparison.OrdinalIgnoreCase);
    }

    private Task<IEnumerable<string>> SearchRoles(string value, CancellationToken cancellationToken)
    {
        IEnumerable<string> roles = _roles
            .Select(r => r.Name)
            .Where(name => !string.IsNullOrWhiteSpace(name))
            .Select(name => name!);

        if (!string.IsNullOrWhiteSpace(value))
        {
            roles = roles.Where(role =>
                role.Contains(value, StringComparison.OrdinalIgnoreCase));
        }

        return Task.FromResult<IEnumerable<string>>(roles.OrderBy(role => role) );
    }

    private void OpenEditDialog(UserOverviewDto user)
    {
        _editUser = new UserOverviewDto
        {
            Id = user.Id,
            Email = user.Email,
            UserName = user.UserName,
            Role = user.Role
        };

        _editDialogOpen = true;
    }

    private void OpenPasswordDialog(UserOverviewDto user)
    {
        _passwordUserId = user.Id;
        _passwordDialogOpen = true;
    }

    private async Task OnUserSaved()
    {
        await LoadUsers();
    }

    private async Task DeleteUser(Guid userId)
    {
        var response = await Http.DeleteAsync($"api/users/{userId}");

        if (!response.IsSuccessStatusCode)
        {
            _error = "Brugeren kunne ikke slettes.";
            return;
        }

        await LoadUsers();
    }
    private static string GetUserInitials(UserOverviewDto user)
    {
        var source = string.IsNullOrWhiteSpace(user.UserName)
            ? user.Email
            : user.UserName;

        if (string.IsNullOrWhiteSpace(source))
            return "?";

        return source.Trim()[0].ToString().ToUpperInvariant();
    }
}