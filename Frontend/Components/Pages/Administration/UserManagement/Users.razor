@page "/users"
@using MudBlazor
@inject NavigationManager NavigationManager

<MudPaper Class="pa-4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <MudText Typo="Typo.h5">Brugere</MudText>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="CreateUser">
            Opret bruger
        </MudButton>
    </MudStack>

    <MudTable Items="_users" Hover="true" Striped="true" Dense="true">
        <HeaderContent>
            <MudTh>Navn</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>Brugernavn</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Navn">@context.Name</MudTd>
            <MudTd DataLabel="Email">@context.Email</MudTd>
            <MudTd DataLabel="Brugernavn">@context.UserName</MudTd>
        </RowTemplate>
    </MudTable>
</MudPaper>

@code {
    private List<UserOverviewDto> _users = new()
    {
        new("Test Bruger", "test@test.dk", "testbruger"),
        new("Admin", "admin@test.dk", "admin")
    };

    private void CreateUser()
    {
        NavigationManager.NavigateTo("/users/register");
    }

    private record UserOverviewDto(
        string Name,
        string Email,
        string UserName
    );
}
