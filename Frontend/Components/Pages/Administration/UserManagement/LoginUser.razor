@page "/login"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using Frontend.Auth
@inject HttpClient Http
@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Login</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="pa-6">

    <MudPaper Class="pa-6">

        <MudStack Spacing="3">

            <MudText Typo="Typo.h5">Login</MudText>

            <MudTextField T="string"
                          Label="Email"
                          @bind-Value="_model.Email" />

            <MudTextField T="string"
                          Label="Password"
                          InputType="InputType.Password"
                          @bind-Value="_model.Password" />

            <MudButton Variant="Variant.Filled"
                       OnClick="Login"
                       Disabled="_isLoading">

                @if (_isLoading)
                {
                    <MudProgressCircular Indeterminate="true"
                                         Size="Size.Small"
                                         Class="me-2" />
                    <span>Logger ind...</span>
                }
                else
                {
                    <span>Login</span>
                }

            </MudButton>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       OnClick="DevLogin"
                       Disabled="_isLoading">
                Snyde-login
            </MudButton>

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Severity="Severity.Error">
                    @_error
                </MudAlert>
            }

        </MudStack>

    </MudPaper>

</MudContainer>

@code {
    private LoginUserRequest _model = new();
    private string? _error;
    private bool _isLoading;

    private async Task Login()
    {
        _error = null;
        _isLoading = true;

        try
        {
            var response = await Http.PostAsJsonAsync("api/auth/login", _model);

            if (!response.IsSuccessStatusCode)
            {
                _error = "Forkert email eller adgangskode.";
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<LoginUserResponse>();

            if (string.IsNullOrWhiteSpace(result?.Token))
            {
                _error = "Login lykkedes, men API'et returnerede ikke en token.";
                return;
            }

            AuthStateProvider.MarkUserAsAuthenticated(result.Token);

            Navigation.NavigateTo("/");
        }
        catch
        {
            _error = "Der opstod en fejl under login.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task DevLogin() //Remember to remove this method before deploying to production!
    {
        _model.Email = "test@outlook.com";
        _model.Password = "Test123!";
        await Login();
    }

    private class LoginUserRequest
    {
        public string? Email { get; set; }
        public string? Password { get; set; }
    }

    private class LoginUserResponse
    {
        public bool Succeeded { get; set; }
        public string? Token { get; set; }
        public List<string> Errors { get; set; } = new();
    }
}