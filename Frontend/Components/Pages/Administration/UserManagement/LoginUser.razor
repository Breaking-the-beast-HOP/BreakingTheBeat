@page "/login"
@page "/"
@layout Layout.LoginLayout
@rendermode InteractiveServer

@using System.Net.Http.Json
@using Frontend.Auth
@using Microsoft.AspNetCore.WebUtilities

@inject HttpClient Http
@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Login</PageTitle>

<div class="login-page">
    <MudPaper Class="login-card"
              Style="width: 420px; max-width: 90vw;"
              Elevation="8">
               <div style="padding: 25px 32px 20px;">

        <MudStack Spacing="3" AlignItems="AlignItems.Center">

            <div class="login-logo">DMG</div>
            <div class="login-subtitle">DIGITAL DONE RIGHT</div>

            <MudTextField T="string"
                          Placeholder="Email"
                          Variant="Variant.Outlined"
                          Style="width: 360px;"
                          @bind-Value="_model.Email" />

            <MudTextField T="string"
                          Placeholder="Password"
                          InputType="InputType.Password"
                          Variant="Variant.Outlined"
                          Style="width: 360px;"
                          @bind-Value="_model.Password" />

            <MudCheckBox T="bool"
                         @bind-Checked="_rememberMe"
                         Label="Remember me"
                         Color="Color.Secondary"
                         Style="width: 360px;" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       Style="width: 360px;"
                       OnClick="Login"
                       Disabled="_isLoading">

                @if (_isLoading)
                {
                    <MudProgressCircular Indeterminate="true"
                                         Size="Size.Small"
                                         Class="me-2" />
                    <span>Logger ind...</span>
                }
                else
                {
                    <span>LOG IN</span>
                }

            </MudButton>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       Style="width: 360px;"
                       OnClick="DevQCLogin"
                       Disabled="_isLoading">
                Demo QC-login
            </MudButton>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       Style="width: 360px;"
                       OnClick="DevAdminLogin"
                       Disabled="_isLoading">
                Demo Admin-login
            </MudButton>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       Style="width: 360px;"
                       OnClick="DevCustomerLogin"
                       Disabled="_isLoading">
                Demo kunde-login
            </MudButton>

            <MudLink Href="#" Typo="Typo.body2" Color="Color.Inherit">
                Reset password
            </MudLink>

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">
                    @_error
                </MudAlert>
            }

        </MudStack>
        </div>
    </MudPaper>
</div>

@code {
    private LoginUserRequest _model = new();
    private string? _error;
    private bool _isLoading;
    private bool _rememberMe;
    private string? _returnUrl;

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);

        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("returnUrl", out var returnUrl))
        {
            _returnUrl = returnUrl;
        }
    }

    private async Task Login()
    {
        _error = null;
        _isLoading = true;

        try
        {
            var response = await Http.PostAsJsonAsync("api/auth/login", _model);

            //debugging logs - remove in production
            var url = new Uri(Http.BaseAddress, "api/auth/login");
            Console.WriteLine($"Api call sent to: {url}");
            Console.WriteLine($"Api response: {response.ToString()}");

            if (!response.IsSuccessStatusCode)
            {
                _error = "Forkert email eller adgangskode.";
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<LoginUserResponse>();

            if (string.IsNullOrWhiteSpace(result?.Token))
            {
                _error = "Login lykkedes, men API'et returnerede ikke en token.";
                return;
            }

            AuthStateProvider.MarkUserAsAuthenticated(result.Token);

            Navigation.NavigateTo(string.IsNullOrWhiteSpace(_returnUrl) ? "/DashBoard" : _returnUrl);
        }
        catch
        {
            _error = "Der opstod en fejl under login.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task DevQCLogin()
    {
        _model.Email = "QC@Test.com";
        _model.Password = "Test123!";
        await Login();
    }

    private async Task DevAdminLogin()
    {
        _model.Email = "Admin@Test.com";
        _model.Password = "Test123!";
        await Login();
    }

    private async Task DevCustomerLogin()
    {
        _model.Email = "Customer@test.com";
        _model.Password = "Test123!";
        await Login();
    }
}