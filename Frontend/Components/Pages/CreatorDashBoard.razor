                4480000, 4420000, 4550000, 4500000, 4200000,
                4380000, 4500000, 4450000, 4480000, 4650000,
                4550000, 4100000, 4280000, 4300000, 4350000
            }
        },
        new ChartSeries<double>
        {
            Name = "Tracks",
            Data = new double[]
            {
                120, 120, 121, 121, 122, 122, 122, 123, 123, 124,
