@page "/"
@using MudBlazor

<PageTitle>Dashboard</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-6">

    <MudStack Spacing="4">

        <!-- Header -->
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <div>
                <MudText Typo="Typo.h4">Dashboard</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Overview of catalog, quality control and distribution status
                </MudText>
            </div>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Warning"
                       StartIcon="@Icons.Material.Filled.Add"
                       Href="/create-release">
                Create Release
            </MudButton>
        </MudStack>

        <!-- Stats -->
        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 dashboard-card">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <div>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Tracks</MudText>
                            <MudText Typo="Typo.h4">128</MudText>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.QueueMusic" Size="Size.Large" Color="Color.Warning" />
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 dashboard-card">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <div>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Releases</MudText>
                            <MudText Typo="Typo.h4">34</MudText>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.Album" Size="Size.Large" Color="Color.Warning" />
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 dashboard-card">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <div>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Contributors</MudText>
                            <MudText Typo="Typo.h4">86</MudText>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Large" Color="Color.Warning" />
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 dashboard-card">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <div>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Pending QC</MudText>
                            <MudText Typo="Typo.h4">7</MudText>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.Security" Size="Size.Large" Color="Color.Warning" />
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- Main content -->
        <MudGrid>
            <MudItem xs="12" md="8">
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.h6">Recent Activity</MudText>
                    <MudDivider Class="my-3" />

                    <MudList T="string">
                        <MudListItem Icon="@Icons.Material.Filled.Album">
                            Release "Let It Go" was updated
                        </MudListItem>

                        <MudListItem Icon="@Icons.Material.Filled.Person">
                            New contributor added: Tim Rice
                        </MudListItem>

                        <MudListItem Icon="@Icons.Material.Filled.Security">
                            Music release sent to Quality Control
                        </MudListItem>

                        <MudListItem Icon="@Icons.Material.Filled.Podcasts">
                            Podcast episode metadata updated
                        </MudListItem>
                    </MudList>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.h6">Quick Actions</MudText>
                    <MudDivider Class="my-3" />

                    <MudStack Spacing="2">
                        <MudButton FullWidth="true"
                                   Variant="Variant.Filled"
                                   Color="Color.Warning"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   Href="/create-release">
                            Create Release
                        </MudButton>

                        <MudButton FullWidth="true"
                                   Variant="Variant.Outlined"
                                   Color="Color.Warning"
                                   StartIcon="@Icons.Material.Filled.QueueMusic"
                                   Href="/tracks">
                            Manage Tracks
                        </MudButton>

                        <MudButton FullWidth="true"
                                   Variant="Variant.Outlined"
                                   Color="Color.Warning"
                                   StartIcon="@Icons.Material.Filled.Groups"
                                   Href="/contributors">
                            Manage Contributors
                        </MudButton>

                        <MudButton FullWidth="true"
                                   Variant="Variant.Outlined"
                                   Color="Color.Warning"
                                   StartIcon="@Icons.Material.Filled.Security"
                                   Href="/music-qc">
                            Open Quality Control
                        </MudButton>
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>

    </MudStack>

</MudContainer>